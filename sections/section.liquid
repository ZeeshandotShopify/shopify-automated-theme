{% comment %}
  SECTION - Without Grid Settings

  We will use the grid's default settings,
  which stretch each grid item to fill both its width and height.
{% endcomment %}

{%- liquid
  # Background image detection
  assign has_bg_image = false
  if section.settings.bg_type == 'image' and section.settings.bg_image != blank
    assign has_bg_image = true
  endif

  # Background video detection
  assign has_bg_video = false
  if section.settings.bg_type == 'video' and section.settings.bg_video != blank
    assign has_bg_video = true
  endif

  assign show_overlay_image = false
  if section.settings.bg_color_mode == 'custom' and section.settings.bg_type == 'image' and has_bg_image and section.settings.overlay_color != blank and section.settings.overlay_opacity > 0
    assign show_overlay_image = true
  endif

  assign show_overlay_video = false
  if section.settings.bg_color_mode == 'custom' and section.settings.bg_type == 'video' and has_bg_video and section.settings.overlay_color != blank and section.settings.overlay_opacity > 0
    assign show_overlay_video = true
  endif

  # Content wrapper class
  # default    - content capped at the page width and centred
  # full       - content spans the viewport, no gutters
  # bleed-*    - content aligned to the page width on one side while the
  #              opposite side runs to the viewport edge, so the last (or
  #              first) block can bleed off that edge
  case section.settings.width
    when 'default'
      assign wrapper_class = 'shopify-page-width shopify-page-padding'
    when 'bleed-start', 'bleed-end'
      assign wrapper_class = 'section-bleed'
    else
      assign wrapper_class = ''
  endcase
-%}

{%- style -%}
  #{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#ffffff' }};
    --overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};

    /* Grid Layout Variables */
    --columns: {{ section.settings.mobile_grid_columns }};

    --gap: {{ section.settings.mobile_gap }};

    {%- case section.settings.mobile_width -%}
      {%- when 'auto' -%}
        --width: auto;
      {%- when 'custom' -%}
        --width: {{ section.settings.mobile_custom_width }};
    {%- endcase -%}

    {%- case section.settings.mobile_height -%}
      {%- when 'auto' -%}
        --height: auto;
      {%- when 'custom' -%}
        --height: {{ section.settings.mobile_custom_height }};
    {%- endcase -%}

    /* Padding Variables */
    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-left: {{ section.settings.mobile_padding_left }}px;
    --padding-right: {{ section.settings.mobile_padding_right }}px;

    position: relative;
    {%- if section.settings.bg_color_mode == 'custom' -%}
      {%- case section.settings.bg_type -%}
        {%- when 'color' -%}
          background: var(--bg-color);
        {%- when 'image' -%}
          background-image: url('{{ section.settings.bg_image | image_url: width: 3840 }}');
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
        {%- when 'video' -%}
          background: var(--bg-color);
      {%- endcase -%}
    {%- else -%}
      background: var(--color-background);
    {%- endif -%}
  }

  /* Bleed Gutter Styles */
  /* One side keeps the page-width gutter so its content lines up with every
     other `default` section; the other side is flush to the viewport edge.
     Below the page width the gutter collapses to --page-padding, so mobile
     behaves exactly like `default`. */
  #{{ section.id }} .section-bleed {
    --bleed-gutter: max(var(--page-padding), calc((100% - var(--page-width)) / 2));

    {%- case section.settings.width -%}
      {%- when 'bleed-start' -%}
        padding-inline: 0 var(--bleed-gutter);
      {%- when 'bleed-end' -%}
        padding-inline: var(--bleed-gutter) 0;
    {%- endcase -%}
  }

  /* Video Background Styles */
  #{{ section.id }} .section-bg__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section.id }} .section-bg__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events: none;
    z-index: 1;
  }

  /* Section Container Styles */
  #{{ section.id }} .section {
    position: relative;
    width: var(--width);
    height: var(--height);
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--gap);
    padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left);
  }

  /* Responsive Styles */
  @media (width >= 64rem) {
    #{{section.id }} {
      --columns: {{ section.settings.desktop_grid_columns }};

      --gap: {{ section.settings.desktop_gap }};

      {%- case section.settings.desktop_width -%}
        {%- when 'auto' -%}
          --width: auto;
        {%- when 'custom' -%}
          --width: {{ section.settings.desktop_custom_width }};
      {%- endcase -%}

      {%- case section.settings.desktop_height -%}
        {%- when 'auto' -%}
          --height: auto;
        {%- when 'custom' -%}
          --height: {{ section.settings.desktop_custom_height }};
      {%- endcase -%}

      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --padding-left: {{ section.settings.desktop_padding_left }}px;
      --padding-right: {{ section.settings.desktop_padding_right }}px;
    }

    #{{ section.id }} .section {
      width: var(--width);
      height: var(--height);
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
      gap: var(--gap);
      padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left);
    }
  }
{%- endstyle -%}

<div id="{{ section.id }}">
  {% if show_overlay_video or show_overlay_image %}
    <div class="section-bg__overlay"></div>
  {% endif %}

  {%- if section.settings.bg_color_mode == 'custom' and section.settings.bg_type == 'video' and has_bg_video -%}
    {{
      section.settings.bg_video
      | video_tag:
        image_size: '3840x',
        alt: section.settings.video.alt,
        class: 'section-bg__video',
        autoplay: true,
        muted: true,
        loop: true
    }}
  {%- endif -%}

  {% if section.settings.enabled_noise %}
    <monotone-noise
      size="{{ section.settings.noise_size | divided_by: 10.0 }}"
      opacity="{{ section.settings.noise_opacity | divided_by: 100.0 }}"
      density="{{ section.settings.noise_density | divided_by: 100.0 }}"
      color="{{ section.settings.noise_color }}"
    >
    </monotone-noise>
  {% endif %}

  <div
    {% if wrapper_class != blank %}
      class="{{ wrapper_class }}"
    {% endif %}
  >
    <div
      class="section"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>


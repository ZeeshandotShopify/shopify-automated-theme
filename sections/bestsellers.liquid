{%- liquid
  assign section_id = section.id
  assign carousel_id = 'swiper-' | append: section_id
  assign max_items = 4
  assign product_source = blank
  assign has_products = false
  assign show_section = false

  if section.settings.product_source == 'Collection'
    comment
      In-stock products lead, sold-out ones follow, order otherwise untouched.
      A manual product list keeps the merchant's own order.
    endcomment
    if section.settings.collection != blank
      assign bs_in_stock = section.settings.collection.products | where: 'available', true
      assign bs_sold_out = section.settings.collection.products | reject: 'available', true
      assign product_source = bs_in_stock | concat: bs_sold_out
    endif
  else
    assign product_source = section.settings.product_list
  endif

  if product_source != blank or request.design_mode
    assign show_section = true
  endif

  if product_source != blank
    assign has_products = true
  endif
-%}

{%- style -%}
  #bestsellers-{{ section_id }} {
    --heading-font-size: {{ section.settings.heading_font_size }};
    --heading-line-height: {{ section.settings.heading_line_height }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-left: {{ section.settings.mobile_padding_left }}px;
    --padding-right: {{ section.settings.mobile_padding_right }}px;

    {%- if section.settings.color_mode == 'custom' -%}
      color: {{ section.settings.fg_color }};
      background: {{ section.settings.bg_color }};
    {%- else -%}
      color: var(--color-foreground);
      background: var(--color-background);
    {%- endif -%}
  }

  #bestsellers-{{ section_id }} .bestsellers {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: var(--padding-left);
    padding-right: var(--padding-right);
  }

  .bestsellers__header--wrapper {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .bestsellers__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bestsellers__header h2 {
    font-family: var(--font-heading--family);
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    font-weight: var(--heading-font-weight);
  }

  .bestsellers__header div {
    font-size: 1.125rem;
    line-height: 140%;
  }

  #bestsellers-{{ section_id }} .swiper-slide {
    /* This required if you want all flex item has same height */
    height: auto;
  }

  #bestsellers-{{ section_id }} .carousel-arrows {
    align-self: end;
    display: none;
  }

  #bestsellers-{{ section_id }} .carousel-button-prev.swiper-button-disabled,
  #bestsellers-{{ section_id }} .carousel-button-next.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Style the SVG icon inside */
  #bestsellers-{{ section_id }} .carousel-arrow svg {
    width: 1.5rem;
    height: 1.5rem;
    /* Ensure the icon is filled with the current text color */
    fill: currentColor;
    stroke: none;
  }

  #bestsellers-{{ section_id }} .carousel-progressbar {
    display: block;
    width: 100%;
    height: 4px;
    background: var(--color-progressbar-background);
    border-radius: 2px;
    margin-top: 30px;
    position: relative;
    overflow: hidden;
  }

  #bestsellers-{{ section_id }} .carousel-progressbar .swiper-pagination-progressbar-fill {
    background: var(--color-progressbar-fill);
    height: 100%;
  }

  @media (width >= 64rem) {
    #bestsellers-{{ section_id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --padding-left: {{ section.settings.desktop_padding_left }}px;
      --padding-right: {{ section.settings.desktop_padding_right }}px;
    }

    #bestsellers-{{ section_id }} .bestsellers {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      padding-left: var(--padding-left);
      padding-right: var(--padding-right);
    }

    #bestsellers-{{ section_id }} .carousel-arrows {
      display: flex;
      gap: 1rem;
      flex-shrink: 0;
    }

    #bestsellers-{{ section_id }} .carousel-progressbar {
      display: none;
    }
  }
{%- endstyle -%}

{%- if show_section -%}
  <div id="bestsellers-{{ section.id }}">
    <div class="shopify-page-width shopify-page-padding">
      <div class="bestsellers">
        <div class="bestsellers__header--wrapper">
          <div class="bestsellers__header">
            {%- if section.settings.heading != blank -%}
              <h2>{{- section.settings.heading -}}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <div>{{- section.settings.subheading -}}</div>
            {%- endif -%}
          </div>

          <div class="carousel-arrows">
            <button class="carousel-button-prev" aria-label="Previous slide">
              <svg
                width="14"
                height="22"
                viewBox="0 0 14 22"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M13.3334 1.60236L3.48271 10.6667L13.3334 19.7309L11.592 21.3333L4.14954e-05 10.6667L11.592 -7.61172e-08L13.3334 1.60236Z" fill="currentColor"/>
              </svg>
            </button>
            <button class="carousel-button-next" aria-label="Next slide">
              <svg
                width="14"
                height="22"
                viewBox="0 0 14 22"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M-7.00414e-08 19.731L9.85066 10.6667L-8.62466e-07 1.60244L1.74136 4.18856e-05L13.3333 10.6667L1.74136 21.3334L-7.00414e-08 19.731Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            <div id="{{ carousel_id }}" class="swiper">
              <div class="swiper-wrapper">
                {%- if has_products -%}
                  {%- for product in product_source -%}
                    <div class="swiper-slide">
                      {% render 'product-card',
                        product: product,
                        aspect_ratio: block.settings.aspect_ratio,
                        secondary_image_hover_effect: block.settings.secondary_image_hover_effect,
                        show_discounted_promo: block.settings.show_discounted_promo,
                        show_rating: block.settings.show_rating,
                        show_color_variants: block.settings.show_color_variants,
                        show_size_variants: block.settings.show_size_variants,
                        show_add_to_cart: block.settings.show_add_to_cart,
                        show_vendor: block.settings.show_vendor,
                        show_quick_view: block.settings.show_quick_view
                      %}
                    </div>
                  {%- endfor -%}
                {%- elsif request.design_mode -%}
                  {%- for i in (1..max_items) -%}
                    <div class="swiper-slide">
                      {% render 'product-card',
                        product: null,
                        aspect_ratio: block.settings.aspect_ratio,
                        secondary_image_hover_effect: block.settings.secondary_image_hover_effect,
                        show_discounted_promo: block.settings.show_discounted_promo,
                        show_rating: block.settings.show_rating,
                        show_color_variants: block.settings.show_color_variants,
                        show_size_variants: block.settings.show_size_variants,
                        show_add_to_cart: block.settings.show_add_to_cart,
                        show_vendor: block.settings.show_vendor,
                        show_quick_view: block.settings.show_quick_view
                      %}
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <div class="carousel-progressbar"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Find the section first
      const section = document.querySelector('#bestsellers-{{ section_id }}');

      if (!section) {
        console.error('Section not found');
        return;
      }

      // Find elements within the section
      const swiperContainer = section.querySelector('#{{ carousel_id }}');
      const prevButton = section.querySelector('.carousel-button-prev');
      const nextButton = section.querySelector('.carousel-button-next');
      const paginationEl = section.querySelector('.carousel-progressbar');

      if (!swiperContainer) {
        console.error('Swiper not found: #{{ carousel_id }}');
        return;
      }

      if (typeof Swiper === 'undefined') {
        console.error('Swiper library not loaded');
        return;
      }

      // Initialize Swiper
      new Swiper(swiperContainer, {
        slidesPerView: {{ section.settings.mobile_slides_per_view }},
        spaceBetween: 32,
        navigation: {
          nextEl: nextButton,
          prevEl: prevButton,
        },
        pagination: {
          el: paginationEl,
          type: 'progressbar',
        },
        breakpoints: {
          768: {
            slidesPerView: 2.3,
          },
          1024: {
            slidesPerView: {{ section.settings.desktop_slides_per_view }},
          },
        },
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:section.bestsellers.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "⚠️ Save to display section correctly"
    },
    {
      "type": "text",
      "id": "desktop_slides_per_view",
      "label": "Desktop Slides Per View",
      "default": "4",
      "info": "Enter a number (whole or decimal, e.g., 1, 2, 1.5). Decimals let you show partial slides (e.g., 1.4 shows one slide plus 40% of the next)."
    },
    {
      "type": "text",
      "id": "mobile_slides_per_view",
      "label": "Mobile Slides Per View",
      "default": "1.3",
      "info": "Enter a number (whole or decimal, e.g., 1, 2, 1.5). Decimals let you show partial slides (e.g., 1.4 shows one slide plus 40% of the next)."
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "t:product_source.label",
      "options": [
        {
          "value": "Collection",
          "label": "t:product_source.options.collection"
        },
        {
          "value": "Products",
          "label": "t:product_source.options.product_list"
        }
      ],
      "default": "Collection",
      "info": "Select how you want to choose products to display in this section."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:collection.label"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:product_list.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:typography.heading.label",
      "default": "Get Our Bestsellers"
    },
    {
      "type": "text",
      "id": "heading_font_size",
      "label": "t:typography.font_size.label",
      "placeholder": "px, rem, etc.",
      "default": "1.25rem"
    },
    {
      "type": "text",
      "id": "heading_line_height",
      "label": "t:typography.line_height.label",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "calc(1.75 / 1.25)"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:typography.font_weight.label",
      "options": [
        {
          "value": "400",
          "label": "t:typography.font_weight.options.regular"
        },
        {
          "value": "500",
          "label": "t:typography.font_weight.options.medium"
        },
        {
          "value": "600",
          "label": "t:typography.font_weight.options.semibold"
        },
        {
          "value": "700",
          "label": "t:typography.font_weight.options.bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:typography.subheading.label"
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "t:colors.foreground_color.label",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#222222",
      "info": "Choose a solid background color",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:layout.desktop.content"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "header",
      "content": "t:layout.mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "t:block.product_card.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "t:aspect_ratio.label",
          "options": [
            { "label": "t:aspect_ratio.options.unset", "value": "unset" },
            { "label": "t:aspect_ratio.options.adapt", "value": "auto" },
            { "label": "16:9 (Widescreen)", "value": "16 / 9" },
            { "label": "4:3 (Standard)", "value": "4 / 3" },
            { "label": "1:1 (Square)", "value": "1 / 1" },
            { "label": "9:16 (Vertical)", "value": "9 / 16" },
            { "label": "21:9 (Cinematic)", "value": "21 / 9" }
          ],
          "default": "1 / 1"
        },
        {
          "type": "checkbox",
          "id": "secondary_image_hover_effect",
          "label": "t:secondary_image_hover_effect.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_discounted_promo",
          "label": "t:discounted_promo.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "t:product_rating.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_quick_view",
          "label": "t:quick_view.label",
          "info": "t:quick_view.info",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_color_variants",
          "label": "t:color_variants.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_size_variants",
          "label": "Size Variants",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_add_to_cart",
          "label": "t:add_to_cart.label",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:section.bestsellers.name",
      "blocks": [
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}

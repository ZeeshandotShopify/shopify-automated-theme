{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{%- liquid
  assign nf_code = section.settings.code | default: '404'

  assign nf_heading = section.settings.heading
  if nf_heading == blank
    assign nf_heading = '404.not_found' | t
  endif

  assign nf_button_label = section.settings.button_label
  if nf_button_label == blank
    assign nf_button_label = '404.back_to_shopping' | t
  endif

  assign nf_button_url = section.settings.button_url
  if nf_button_url == blank
    assign nf_button_url = routes.all_products_collection_url
  endif

  assign nf_collection = section.settings.featured_collection

  # Render the featured grid when enabled AND (a collection is set OR we're in the editor, to preview the layout)
  assign nf_render_featured = false
  if section.settings.show_featured
    if nf_collection != blank or request.design_mode
      assign nf_render_featured = true
    endif
  endif
-%}

{% style %}
  #{{ section.id }} {
    {%- if section.settings.color_mode == 'custom' -%}
      --nf-bg: {{ section.settings.bg_color }};
      --nf-fg: {{ section.settings.fg_color }};
    {%- else -%}
      --nf-bg: var(--color-background);
      --nf-fg: var(--color-foreground);
    {%- endif -%}

    --nf-mobile-columns: {{ section.settings.mobile_grid_columns }};
    --nf-desktop-columns: {{ section.settings.desktop_grid_columns }};
    --nf-pad-top: {{ section.settings.mobile_padding_top }}px;
    --nf-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;

    background: var(--nf-bg);
    color: var(--nf-fg);
  }

  #{{ section.id }} .not-found {
    display: grid;
    justify-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-top: var(--nf-pad-top);
    padding-bottom: var(--nf-pad-bottom);
    /* Self-pad horizontally: the theme's --page-padding can be 0, which would
       otherwise let content touch the screen edges on mobile. */
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  #{{ section.id }} .not-found__intro {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }

  /* Soft atmospheric halo behind the numeral (degrades gracefully if unsupported) */
  #{{ section.id }} .not-found__intro::before {
    content: '';
    position: absolute;
    top: -8%;
    left: 50%;
    transform: translateX(-50%);
    width: min(34rem, 92%);
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--nf-fg) 9%, transparent) 0%, transparent 62%);
    z-index: 0;
    pointer-events: none;
  }

  #{{ section.id }} .not-found__intro > * {
    position: relative;
    z-index: 1;
  }

  /* Oversized 404 numeral — the focal point */
  #{{ section.id }} .not-found__code {
    margin: 0;
    font-family: var(--font-heading--family, sans-serif);
    font-weight: 700;
    font-size: clamp(5rem, 22vw, 13rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: var(--nf-fg);
  }

  #{{ section.id }} .not-found__title {
    margin: 0;
    font-family: var(--font-heading--family, sans-serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: 0.2px;
  }

  #{{ section.id }} .not-found__subtext {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-body--family, sans-serif);
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.78;
  }

  #{{ section.id }} .not-found__actions {
    margin-top: 0.25rem;
  }

  /* Search */
  #{{ section.id }} .not-found__search {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
  }

  #{{ section.id }} .not-found__search predictive-search,
  #{{ section.id }} .not-found__search form {
    position: relative;
    display: block;
    width: 100%;
  }

  #{{ section.id }} .not-found__search-field {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #{{ section.id }} .not-found__search-field label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  #{{ section.id }} .not-found__search-field input[type='search'] {
    width: 100%;
    height: 3.25rem;
    padding: 0 3.25rem 0 1.125rem;
    font-family: var(--font-body--family, sans-serif);
    font-size: 1rem;
    color: var(--nf-fg);
    background: var(--nf-bg);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: var(--input-border-radius, 0.5rem);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  #{{ section.id }} .not-found__search-field input[type='search']:focus-visible {
    border-color: var(--nf-fg);
    box-shadow: 0 0 0 1px var(--nf-fg);
  }

  #{{ section.id }} .not-found__search-field input[type='search']::-webkit-search-cancel-button {
    display: none;
  }

  #{{ section.id }} .not-found__search-submit {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    background: transparent;
    color: var(--nf-fg);
    cursor: pointer;
    border-radius: 0.375rem;
    transition: opacity 0.15s ease;
  }

  #{{ section.id }} .not-found__search-submit:hover {
    opacity: 0.65;
  }

  /* Quick links */
  #{{ section.id }} .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
  }

  #{{ section.id }} .not-found__link {
    position: relative;
    padding-bottom: 2px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.9375rem;
    color: var(--nf-fg);
    text-decoration: none;
  }

  #{{ section.id }} .not-found__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  #{{ section.id }} .not-found__link:hover::after {
    transform: scaleX(1);
  }

  /* Featured products */
  #{{ section.id }} .not-found__featured {
    display: grid;
    gap: 1.75rem;
    width: 100%;
  }

  #{{ section.id }} .not-found__featured-title {
    margin: 0;
    text-align: center;
    font-family: var(--font-heading--family, sans-serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    letter-spacing: 0.2px;
  }

  #{{ section.id }} .not-found__products {
    display: grid;
    grid-template-columns: repeat(var(--nf-mobile-columns), minmax(0, 1fr));
    gap: 1rem;
  }

  @media (width >= 64rem) {
    #{{ section.id }} {
      --nf-pad-top: {{ section.settings.desktop_padding_top }}px;
      --nf-pad-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }

    #{{ section.id }} .not-found__products {
      grid-template-columns: repeat(var(--nf-desktop-columns), minmax(0, 1fr));
    }
  }

  /* Subtle, staggered entrance — only when motion is welcome */
  @media (prefers-reduced-motion: no-preference) {
    #{{ section.id }} .not-found__intro > *,
    #{{ section.id }} .not-found__featured {
      opacity: 0;
      animation: nf-reveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    #{{ section.id }} .not-found__code {
      animation-delay: 0.05s;
    }
    #{{ section.id }} .not-found__title {
      animation-delay: 0.12s;
    }
    #{{ section.id }} .not-found__subtext {
      animation-delay: 0.18s;
    }
    #{{ section.id }} .not-found__actions {
      animation-delay: 0.24s;
    }
    #{{ section.id }} .not-found__search {
      animation-delay: 0.3s;
    }
    #{{ section.id }} .not-found__links {
      animation-delay: 0.36s;
    }
    #{{ section.id }} .not-found__featured {
      animation-delay: 0.42s;
    }
  }

  @keyframes nf-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstyle %}

<div id="{{ section.id }}">
  <div class="shopify-page-width shopify-page-padding">
    <div class="not-found">
      <div class="not-found__intro">
        <div class="not-found__code" aria-hidden="true">{{ nf_code }}</div>

        <h1 class="not-found__title">{{ nf_heading }}</h1>

        {%- if section.settings.subtext != blank -%}
          <div class="not-found__subtext rte">{{ section.settings.subtext }}</div>
        {%- endif -%}

        <div class="not-found__actions">
          {% render 'button',
            label: nf_button_label,
            url: nf_button_url,
            variant: section.settings.button_variant,
            size: 'default',
            icon_mode: 'select',
            icon_select: 'bag',
            icon_position: 'left',
            hover_effect: 'bg-slide'
          %}
        </div>

        {%- if section.settings.show_search -%}
          <div class="not-found__search">
            <predictive-search>
              <form action="{{ routes.search_url }}" method="get" role="search">
                <div class="not-found__search-field">
                  <input
                    id="Search"
                    type="search"
                    name="q"
                    placeholder="{{ section.settings.search_placeholder | escape }}"
                    role="combobox"
                    aria-expanded="false"
                    aria-owns="predictive-search-results"
                    aria-controls="predictive-search-results"
                    aria-haspopup="listbox"
                    aria-autocomplete="list"
                  >
                  <label for="Search">{{ 'search.title' | t }}</label>

                  <button type="submit" aria-label="{{ 'search.submit' | t }}" class="not-found__search-submit">
                    {% render 'icon', icon_mode: 'select', icon_select: 'search', icon_size: 20 %}
                  </button>
                </div>

                <input name="options[prefix]" type="hidden" value="last">
                <div id="predictive-search" tabindex="-1"></div>
              </form>
            </predictive-search>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <nav class="not-found__links" aria-label="Helpful links">
            {%- for block in section.blocks -%}
              {%- if block.type == 'link' and block.settings.text != blank -%}
                <a
                  href="{{ block.settings.url | default: routes.root_url }}"
                  class="not-found__link"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>

      {%- if nf_render_featured -%}
        <div class="not-found__featured">
          {%- if section.settings.featured_heading != blank -%}
            <h2 class="not-found__featured-title">{{ section.settings.featured_heading }}</h2>
          {%- endif -%}

          <div class="not-found__products">
            {%- if nf_collection != blank -%}
              {%- liquid
                comment
                  In-stock products lead, sold-out ones follow, order otherwise untouched.
                endcomment
                assign nf_in_stock = nf_collection.products | where: 'available', true
                assign nf_sold_out = nf_collection.products | reject: 'available', true
                assign nf_ordered_products = nf_in_stock | concat: nf_sold_out
              -%}
              {%- for product in nf_ordered_products limit: section.settings.products_to_show -%}
                {% render 'product-card',
                  product: product,
                  aspect_ratio: section.settings.aspect_ratio,
                  secondary_image_hover_effect: section.settings.secondary_image_hover_effect,
                  show_rating: section.settings.show_rating,
                  show_discounted_promo: true,
                  show_color_variants: true,
                  show_size_variants: false,
                  show_add_to_cart: section.settings.show_add_to_cart,
                  show_vendor: false,
                  show_quick_view: section.settings.show_quick_view
                %}
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} Theme editor preview before a collection is chosen {%- endcomment -%}
              {%- for i in (1..section.settings.products_to_show) -%}
                {% render 'product-card',
                  aspect_ratio: section.settings.aspect_ratio,
                  show_rating: section.settings.show_rating,
                  show_add_to_cart: section.settings.show_add_to_cart
                %}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Error code",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the theme's default translation."
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "The page you're looking for doesn't exist or may have moved."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use the theme's default translation."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Defaults to the all-products collection."
    },
    {
      "type": "select",
      "id": "button_variant",
      "label": "Button style",
      "options": [
        { "value": "default", "label": "Primary" },
        { "value": "outline", "label": "Outline" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products"
    },
    {
      "type": "header",
      "content": "Featured products"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured products",
      "default": true
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Heading",
      "default": "Popular right now"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_grid_columns",
      "label": "t:layout.columns.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_grid_columns",
      "label": "t:layout.columns.label",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:aspect_ratio.label",
      "options": [
        { "label": "t:aspect_ratio.options.unset", "value": "unset" },
        { "label": "t:aspect_ratio.options.adapt", "value": "auto" },
        { "label": "16:9 (Widescreen)", "value": "16 / 9" },
        { "label": "4:3 (Standard)", "value": "4 / 3" },
        { "label": "1:1 (Square)", "value": "1 / 1" },
        { "label": "9:16 (Vertical)", "value": "9 / 16" },
        { "label": "21:9 (Cinematic)", "value": "21 / 9" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:product_rating.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "t:add_to_cart.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "t:quick_view.label",
      "info": "t:quick_view.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "secondary_image_hover_effect",
      "label": "t:secondary_image_hover_effect.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        { "value": "inherit", "label": "t:color_mode.options.inherit" },
        { "value": "custom", "label": "t:color_mode.options.custom" }
      ],
      "default": "inherit"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "t:colors.foreground_color.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:layout.desktop.content"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 96
    },
    {
      "type": "header",
      "content": "t:layout.mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}

{%- liquid
  assign section_id = section.id
  assign carousel_dom_id = 'carousel-' | append: section_id
-%}

{%- style -%}
  #carousel-{{ section_id }} {
    --heading-font-size: {{ section.settings.heading_font_size }};
    --heading-line-height: {{ section.settings.heading_line_height }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-left: {{ section.settings.mobile_padding_left }}px;
    --padding-right: {{ section.settings.mobile_padding_right }}px;

    {%- if section.settings.color_mode == 'custom' -%}
      color: {{ section.settings.fg_color }};
      background: {{ section.settings.bg_color }};
    {%- else -%}
      color: var(--color-foreground);
      background: var(--color-background);
    {%- endif -%}
  }

  #carousel-{{ section_id }} .carousel {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: var(--padding-left);
    padding-right: var(--padding-right);
  }

  .carousel-header-wrapper {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .carousel-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .carousel-header .btn {
    align-self: flex-start;
  }

  #carousel-{{ section_id }} .swiper-slide {
    /* This required if you want all flex item has same height */
    height: auto;
  }

  #carousel-{{ section_id }} .carousel-arrows {
    align-self: end;
    display: none;
  }

  #carousel-{{ section_id }} .carousel-button-prev.swiper-button-disabled,
  #carousel-{{ section_id }} .carousel-button-next.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Style the SVG icon inside */
  #carousel-{{ section_id }} .carousel-arrow svg {
    width: 1.5rem;
    height: 1.5rem;
    /* Ensure the icon is filled with the current text color */
    fill: currentColor;
    stroke: none;
  }

  @media (width >= 64rem) {
    #carousel-{{ section_id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --padding-left: {{ section.settings.desktop_padding_left }}px;
      --padding-right: {{ section.settings.desktop_padding_right }}px;
    }

    #carousel-{{ section_id }} .carousel {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      padding-left: var(--padding-left);
      padding-right: var(--padding-right);
    }

    #carousel-{{ section_id }} .carousel-arrows {
      display: flex;
      gap: 1rem;
      flex-shrink: 0;
    }
  }
{%- endstyle -%}

<div id="carousel-{{ section_id }}" aria-label="Carousel">
  <div class="shopify-page-width shopify-page-padding">
    <div class="carousel">
      <div class="carousel-header-wrapper">
        <div class="carousel-header">
          {% content_for 'block', type: 'layout-header', id: 'layout-header' %}
        </div>

        <div class="carousel-arrows">
          <button class="carousel-button-prev" aria-label="Previous slide">
            <svg
              width="14"
              height="22"
              viewBox="0 0 14 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M13.3334 1.60236L3.48271 10.6667L13.3334 19.7309L11.592 21.3333L4.14954e-05 10.6667L11.592 -7.61172e-08L13.3334 1.60236Z" fill="currentColor"/>
            </svg>
          </button>
          <button class="carousel-button-next" aria-label="Next slide">
            <svg
              width="14"
              height="22"
              viewBox="0 0 14 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M-7.00414e-08 19.731L9.85066 10.6667L-8.62466e-07 1.60244L1.74136 4.18856e-05L13.3333 10.6667L1.74136 21.3334L-7.00414e-08 19.731Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      {% content_for 'block',
        type: 'layout-carousel',
        id: 'layout-carousel',
        carousel_dom_id: carousel_dom_id
      %}

      {% content_for 'block', type: 'layout-footer', id: 'layout-footer' %}
    </div>
  </div>
</div>

{%- schema -%}
{
  "name": "t:section.carousel.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "⚠️ Save to display section correctly"
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "t:colors.foreground_color.label",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#222222",
      "info": "Choose a solid background color",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:layout.desktop.content"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "header",
      "content": "t:layout.mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:section.carousel.name",
      "blocks": [
        {
          "type": "layout-header",
          "id": "layout-header",
          "static": true
        },
        {
          "type": "layout-carousel",
          "id": "layout-carousel",
          "static": true
        },
        {
          "type": "layout-footer",
          "id": "layout-footer",
          "static": true
        }
      ]
    }
  ]
}
{%- endschema -%}

{% comment %}
  {%- liquid
    assign section_id = section.id
    assign carousel_id = 'swiper-' | append: section_id
  -%}

  {%- style -%}
    #carousel-{{ section_id }} {
      --heading-font-size: {{ section.settings.heading_font_size }};
      --heading-line-height: {{ section.settings.heading_line_height }};
      --heading-font-weight: {{ section.settings.heading_font_weight }};

      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --padding-left: {{ section.settings.mobile_padding_left }}px;
      --padding-right: {{ section.settings.mobile_padding_right }}px;

      {%- if section.settings.color_mode == 'custom' -%}
        color: {{ section.settings.fg_color }};
        background: {{ section.settings.bg_color }};
      {%- else -%}
        color: var(--color-foreground);
        background: var(--color-background);
      {%- endif -%}
    }

    #carousel-{{ section_id }} .carousel {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      padding-left: var(--padding-left);
      padding-right: var(--padding-right);
    }

    .carousel-header-wrapper {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .carousel-header {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .carousel-header h2 {
      font-family: var(--font-heading--family);
      font-size: var(--heading-font-size);
      line-height: var(--heading-line-height);
      font-weight: var(--heading-font-weight);
    }

    .carousel-header div {
      font-size: 1.125rem;
      line-height: 140%;
    }

    .carousel-header .btn {
      align-self: flex-start;
    }

    #carousel-{{ section_id }} .swiper-slide {
      /* This required if you want all flex item has same height */
      height: auto;
    }

    .carousel-arrows {
      align-self: end;
      display: none;
    }

    .carousel-button-prev.swiper-button-disabled,
    .carousel-button-next.swiper-button-disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* Style the SVG icon inside */
    .carousel-arrow svg {
      width: 1.5rem;
      height: 1.5rem;
      /* Ensure the icon is filled with the current text color */
      fill: currentColor;
      stroke: none;
    }

    .carousel-progressbar {
      display: block;
      width: 100%;
      height: 4px;
      background: var(--color-progressbar-background);
      border-radius: 2px;
      margin-top: 30px;
      position: relative;
      overflow: hidden;
    }

    .carousel-progressbar .swiper-pagination-progressbar-fill {
      background: var(--color-progressbar-fill);
      height: 100%;
    }

    @media (width >= 64rem) {
      #carousel-{{ section_id }} {
        --padding-top: {{ section.settings.desktop_padding_top }}px;
        --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        --padding-left: {{ section.settings.desktop_padding_left }}px;
        --padding-right: {{ section.settings.desktop_padding_right }}px;
      }

      #carousel-{{ section_id }} .carousel {
        padding-top: var(--padding-top);
        padding-bottom: var(--padding-bottom);
        padding-left: var(--padding-left);
        padding-right: var(--padding-right);
      }

      .carousel-arrows {
        display: flex;
        gap: 1rem;
        flex-shrink: 0;
      }

      .carousel-progressbar {
        display: none;
      }
    }
  {%- endstyle -%}

  <div id="carousel-{{ section_id }}" aria-label="Carousel">
    <div class="shopify-page-width shopify-page-padding">
      <div class="carousel">
        <div class="carousel-header-wrapper">
          <div class="carousel-header">
            {%- if section.settings.heading != blank -%}
              <h2>{{- section.settings.heading -}}</h2>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
              <div>{{- section.settings.subheading -}}</div>
            {%- endif -%}

            {%- if section.settings.button_label != blank and section.settings.url != blank -%}
              {% render 'button',
                label: section.settings.button_label,
                url: section.settings.url,
                variant: 'secondary'
              %}
            {%- endif -%}
          </div>

          <div class="carousel-arrows">
            <button class="carousel-button-prev" aria-label="Previous slide">
              <svg width="14" height="22" viewBox="0 0 14 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M13.3334 1.60236L3.48271 10.6667L13.3334 19.7309L11.592 21.3333L4.14954e-05 10.6667L11.592 -7.61172e-08L13.3334 1.60236Z" fill="currentColor"/>
              </svg>
            </button>
            <button class="carousel-button-next" aria-label="Next slide">
              <svg width="14" height="22" viewBox="0 0 14 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M-7.00414e-08 19.731L9.85066 10.6667L-8.62466e-07 1.60244L1.74136 4.18856e-05L13.3333 10.6667L1.74136 21.3334L-7.00414e-08 19.731Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="{{ carousel_id }}" class="swiper">
          <ul class="swiper-wrapper">
            {% for block in section.blocks %}
              <li class="swiper-slide" {{ block.shopify_attributes }}>{% render block %}</li>
            {% endfor %}
          </ul>

          <div class="carousel-progressbar"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Find the section first
      const section = document.querySelector('#carousel-{{ section_id }}');

      if (!section) {
        console.error('Section not found');
        return;
      }

      // Find elements within the section
      const swiperContainer = section.querySelector('#{{ carousel_id }}');
      const prevButton = section.querySelector('.carousel-button-prev');
      const nextButton = section.querySelector('.carousel-button-next');
      const paginationEl = section.querySelector('.carousel-progressbar');

      if (!swiperContainer) {
        console.error('Swiper not found: #{{ carousel_id }}');
        return;
      }

      if (typeof Swiper === 'undefined') {
        console.error('Swiper library not loaded');
        return;
      }

      // Initialize Swiper
      new Swiper(swiperContainer, {
        slidesPerView: {{ section.settings.mobile_slides_per_view }},
        spaceBetween: 24,
        navigation: {
          nextEl: nextButton,
          prevEl: prevButton,
        },
        pagination: {
          el: paginationEl,
          type: 'progressbar',
        },
        breakpoints: {
          1024: {
            slidesPerView: {{ section.settings.desktop_slides_per_view }},
          },
        },
      });
    });
  </script>


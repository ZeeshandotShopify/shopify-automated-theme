          "visible_if": "{{ block.settings.menu_type == 'mega_menu' }}"
        },
        {
          "type": "range",
          "id": "promotion_overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 0,
          "unit": "%",
          "visible_if": "{{ block.settings.menu_type == 'mega_menu' }}"
        },
        {
          "type": "header",
          "content": "Promotion 1",

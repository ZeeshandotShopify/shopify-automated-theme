          "default": "100%",
          "visible_if": "{{ block.settings.promotion_1_desktop_enable_custom_dimension and block.settings.menu_type == 'mega_menu' }}"
        },
        {
          "type": "text",
          "id": "promotion_1_desktop_custom_height",
          "label": "Custom Height",
          "default": "100%",
          "visible_if": "{{ block.settings.promotion_1_desktop_enable_custom_dimension and block.settings.menu_type == 'mega_menu' }}"
        },
        {
          "type": "text",
          "id": "promotion_1_heading",
          "label": "Heading",
          "default": "Collection",
          "visible_if": "{{ block.settings.menu_type == 'mega_menu' }}"
        },
        {
          "type": "text",
          "id": "promotion_1_button_label",

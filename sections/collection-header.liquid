{%- liquid
  assign section_id = section.id

  comment
    No required settings: the heading is the collection title, which always
    exists on a collection template, so this section never withholds itself and
    carries no request.design_mode placeholder branch. The subheading is the
    only conditional — blank richtext renders no markup at all, in the editor
    and on live alike, and the stack gap closes with it.
  endcomment
  assign subheading_text = section.settings.subheading | strip_html | strip

  comment
    The middle "Shop" crumb is fixed on a collection page — no setting behind
    it. Everything else about the breadcrumb (enable, separator, colours) comes
    from the GLOBAL Breadcrumbs settings, shared with snippets/breadcrumbs.liquid
    so this trail and the product page's match.
  endcomment
  assign middle_label = 'Shop'
  assign middle_url = routes.all_products_collection_url
  assign separator = settings.breadcrumb_separator | default: '/'
-%}

{%- style -%}
  #collection-header-{{ section_id }} {
    /* Figma values with no theme global. Both type families DO map to globals
       and are read from them below. The frame background is pure #FFFFFF —
       the theme's own page background is #FFFBF3 cream, so it is set here. */
    --ch-background: {{ section.settings.background_color }};
    --ch-gap: {{ section.settings.content_gap }}px;
    --ch-content-max-width: {{ section.settings.content_max_width }};

    --ch-breadcrumb-color: {{ settings.breadcrumb_color | default: '#424242' }};
    --ch-breadcrumb-current-color: {{ settings.breadcrumb_current_color | default: '#212426' }};

    --ch-heading-color: {{ section.settings.heading_color }};
    --ch-heading-font-size: {{ section.settings.mobile_heading_font_size }};
    --ch-heading-line-height: {{ section.settings.heading_line_height }};
    --ch-heading-text-transform: none;
    --ch-heading-white-space: normal;

    --ch-subheading-color: {{ section.settings.subheading_color }};

    --ch-padding-top: {{ section.settings.mobile_padding_top }}px;
    --ch-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --ch-padding-inline-start: {{ section.settings.mobile_padding_left }}px;
    --ch-padding-inline-end: {{ section.settings.mobile_padding_right }}px;
  }

  #collection-header-{{ section_id }} .collection-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ch-gap);
    text-align: center;
    word-break: break-word;
  }

  #collection-header-{{ section_id }} {
    background-color: var(--ch-background);
    padding-block: var(--ch-padding-top) var(--ch-padding-bottom);
    padding-inline: var(--ch-padding-inline-start) var(--ch-padding-inline-end);
  }

  /* Breadcrumb — an inline list, so it wraps and centres as running text
     rather than as flex items. */
  #collection-header-{{ section_id }} .collection-header__breadcrumbs {
    width: 100%;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--ch-breadcrumb-color);
  }

  #collection-header-{{ section_id }} .collection-header__breadcrumbs ol {
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #collection-header-{{ section_id }} .collection-header__breadcrumbs li {
    display: inline;
  }

  #collection-header-{{ section_id }} .collection-header__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  #collection-header-{{ section_id }} .collection-header__breadcrumbs a:hover {
    color: {{ settings.breadcrumb_hover_color | default: '#555555' }};
    text-decoration: underline;
  }

  #collection-header-{{ section_id }} .collection-header__breadcrumbs [aria-current='page'] {
    font-weight: 600;
    color: var(--ch-breadcrumb-current-color);
  }

  #collection-header-{{ section_id }} .collection-header__heading {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--ch-heading-font-size);
    line-height: var(--ch-heading-line-height);
    letter-spacing: 0;
    color: var(--ch-heading-color);
    text-transform: var(--ch-heading-text-transform);
    white-space: var(--ch-heading-white-space);
  }

  #collection-header-{{ section_id }} .collection-header__subheading {
    width: 100%;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ch-subheading-color);
  }

  #collection-header-{{ section_id }} .collection-header__subheading > *:first-child {
    margin-top: 0;
  }

  #collection-header-{{ section_id }} .collection-header__subheading > *:last-child {
    margin-bottom: 0;
  }

  /* critical.css:611 gives .rte anchors the theme link blue — keep the
     subheading's own colour. */
  #collection-header-{{ section_id }} .collection-header__subheading a {
    color: inherit;
  }

  @media (width >= 64rem) {
    #collection-header-{{ section_id }} {
      --ch-heading-font-size: {{ section.settings.heading_font_size }};
      --ch-heading-text-transform: {{ section.settings.heading_text_transform }};
      {%- if section.settings.heading_nowrap %}
        --ch-heading-white-space: nowrap;
      {%- endif %}

      --ch-padding-top: {{ section.settings.desktop_padding_top }}px;
      --ch-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --ch-padding-inline-start: {{ section.settings.desktop_padding_left }}px;
      --ch-padding-inline-end: {{ section.settings.desktop_padding_right }}px;
    }

    #collection-header-{{ section_id }} .collection-header__breadcrumbs,
    #collection-header-{{ section_id }} .collection-header__subheading {
      max-width: var(--ch-content-max-width);
    }
  }
{%- endstyle -%}

<div id="collection-header-{{ section_id }}" class="collection-header">
  <div class="collection-header__inner">
    {%- unless settings.enable_breadcrumbs == false -%}
      <nav class="collection-header__breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li>
            <span aria-hidden="true"> {{ separator }} </span>
            <a href="{{ middle_url }}">{{ middle_label }}</a>
          </li>
          <li>
            <span aria-hidden="true"> {{ separator }} </span>
            <span aria-current="page">{{ collection.title }}</span>
          </li>
        </ol>
      </nav>
    {%- endunless -%}

    <h1 class="collection-header__heading">{{ collection.title }}</h1>

    {%- if subheading_text != blank -%}
      <div class="collection-header__subheading rte">
        {{ section.settings.subheading }}
      </div>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}{{ routes.root_url }}"
      }
      {%- assign position = 1 -%}
      {%- assign position = position | plus: 1 -%}
      ,{
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ middle_label | json }},
        "item": "{{ shop.url }}{{ middle_url }}"
      }
      {%- assign position = position | plus: 1 -%}
      ,{
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    ]
  }
</script>

{%- schema -%}
{
  "name": "t:section.collection_header.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The breadcrumb is styled in Theme settings → Breadcrumbs, shared with every other page that shows one."
    },
    {
      "type": "header",
      "content": "t:typography.heading.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212426"
    },
    {
      "type": "text",
      "id": "heading_font_size",
      "label": "Desktop heading font size",
      "placeholder": "px, rem, etc.",
      "default": "2.5rem"
    },
    {
      "type": "text",
      "id": "mobile_heading_font_size",
      "label": "Mobile heading font size",
      "placeholder": "px, rem, etc.",
      "default": "2rem"
    },
    {
      "type": "text",
      "id": "heading_line_height",
      "label": "t:typography.line_height.label",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "140%"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Desktop heading text transform",
      "info": "Applied from the desktop breakpoint up. Mobile always renders as authored.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "capitalize"
    },
    {
      "type": "checkbox",
      "id": "heading_nowrap",
      "label": "Keep the heading on one line on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "info": "Leave blank to hide it.",
      "default": "<p>Add a short paragraph describing this collection.</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#474E52"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "text",
      "id": "content_max_width",
      "label": "Desktop content max width",
      "info": "Caps the breadcrumb and subheading. The heading is not capped.",
      "placeholder": "px, rem, etc.",
      "default": "728px"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between elements",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:layout.desktop.content"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:layout.mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:section.collection_header.name"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{%- endschema -%}

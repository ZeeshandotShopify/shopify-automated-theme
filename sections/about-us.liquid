{%- style -%}
  .about-us {
    --heading-font-size: {{ section.settings.heading_font_size }};
    --heading-line-height: {{ section.settings.heading_line_height }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    width: 100%;
    max-width: 58.5rem;
    margin-inline: auto;
    padding-block: 4rem;
    padding-inline: 1rem;
  }

  .about-us-header-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .about-us-image-wrapper {
    border-radius: 8px;
    overflow: hidden;
    order: 1;
  }

  .about-us-header {
    order: 2;
  }

  .about-us-heading {
    font-family: var(--font-heading--family);
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    font-weight: var(--heading-font-weight);
    margin-bottom: 1.5rem;
  }

  .about-us-subheading {
    font-size: 1.125rem;
    line-height: 140%;
  }

  .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--color-primary-background);
  }

  @media (width >= 64rem) {
    .about-us {
      padding-inline: 0;
    }

    .about-us-header-wrapper {
      {%- if section.settings.image != blank -%}
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 5rem;
      {%- endif -%}
      margin-bottom: 4rem;
    }

    .about-us-image-wrapper {
      order: 2;
    }

    .about-us-header {
      order: 1;
    }
  }
{%- endstyle -%}

<div class="about-us">
  <div class="about-us-header-wrapper">
    <div class="about-us-image-wrapper">
      {% comment %}
        {%- if section.settings.image != blank -%}
          <img
            srcset="
              {{ section.settings.image | image_url: width: 375 }} 375w,
              {{ section.settings.image | image_url: width: 550 }} 550w,
              {{ section.settings.image | image_url: width: 750 }} 750w,
              {{ section.settings.image | image_url: width: 1100 }} 1100w,
              {{ section.settings.image | image_url: width: 1500 }} 1500w,
              {{ section.settings.image | image_url: width: 1780 }} 1780w,
              {{ section.settings.image | image_url: width: 2000 }} 2000w,
              {{ section.settings.image | image_url: width: 3000 }} 3000w,
              {{ section.settings.image | image_url: width: 3840 }} 3840w
            "
            src="{{ section.settings.image | image_url: width: 1500 }}"
            sizes="(min-width: 1200px) 1100px, (min-width: 750px) calc(100vw - 100px), 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="responsive-img"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      {% endcomment %}

      {%- if section.settings.image != blank -%}
        <div class="about-us-image-wrapper">
          <img
            srcset="
              {{ section.settings.image | image_url: width: 375 }} 375w,
              {{ section.settings.image | image_url: width: 550 }} 550w,
              {{ section.settings.image | image_url: width: 750 }} 750w,
              {{ section.settings.image | image_url: width: 1100 }} 1100w,
              {{ section.settings.image | image_url: width: 1500 }} 1500w,
              {{ section.settings.image | image_url: width: 1780 }} 1780w,
              {{ section.settings.image | image_url: width: 2000 }} 2000w,
              {{ section.settings.image | image_url: width: 3000 }} 3000w,
              {{ section.settings.image | image_url: width: 3840 }} 3840w
            "
            src="{{ section.settings.image | image_url: width: 1500 }}"
            sizes="(min-width: 1200px) 1100px, (min-width: 750px) calc(100vw - 100px), 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="responsive-img"
          >
        </div>
      {%- endif -%}
    </div>

    <div class="about-us-header">
      <h1 class="about-us-heading">
        {{ section.settings.heading }}
      </h1>

      <p class="about-us-subheading">
        {{ section.settings.subheading }}
      </p>
    </div>
  </div>

  <div class="about-us-content">
    {{ section.settings.content }}
  </div>
</div>

{%- schema -%}
{
  "name": "About Us",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:heading.label",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "heading_font_size",
      "label": "t:typography.font_size.label",
      "placeholder": "px, rem, etc.",
      "default": "3rem"
    },
    {
      "type": "text",
      "id": "heading_line_height",
      "label": "Line Height",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "120%"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:typography.font_weight.label",
      "options": [
        {
          "value": "400",
          "label": "t:typography.font_weight.options.regular"
        },
        {
          "value": "500",
          "label": "t:typography.font_weight.options.medium"
        },
        {
          "value": "600",
          "label": "t:typography.font_weight.options.semibold"
        },
        {
          "value": "700",
          "label": "t:typography.font_weight.options.bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Subheading</p>"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Content</p>"
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{%- endschema -%}

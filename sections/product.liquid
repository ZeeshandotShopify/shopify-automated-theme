{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- style -%}
  /* Page container: centers content (1312px) within 64px gutters on desktop */
  .pdp-page {
    width: 100%;
    padding-inline: 1rem;
  }

  .pdp-breadcrumbs {
    padding: 1rem 0 0.5rem;
  }

  .pdp {
    display: block;
    width: 100%;
  }

  .pdp-gallery__wrapper {
    width: 100%;
    padding-bottom: 0.5rem;
  }

  .pdp-information__wrapper {
    width: 100%;
    padding-block: 1.5rem;
  }

  .pdp-information {
    width: 100%;
    padding: 1.5rem;
    border: 1px #e3e8ea solid;
    border-radius: 0.25rem;
  }

  /* Mobile/Desktop Gallery Layout Visibility Classes */
  .pdp-gallery--mobile-only {
    display: block;
  }

  .pdp-gallery--desktop-only {
    display: none;
  }

  /* Desktop Layout - two equal columns (640 + 640), 32px gap, 64px gutters */
  @media (width >= 64rem) {
    .pdp-page {
      max-width: 90rem;
      margin-inline: auto;
      padding-inline: 4rem;
    }

    .pdp-breadcrumbs {
      padding: 0 0 2rem;
    }

    .pdp {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
    }

    .pdp-gallery__wrapper {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
      padding-bottom: 0;

      /* Carousel gallery follows while the taller info column scrolls.
         (If this theme switches to the grid gallery, move sticky to
         .pdp-information__wrapper instead — the grid is the tall column.) */
      position: -webkit-sticky;
      position: sticky;
      top: calc(var(--header-height, 80px) + 1rem);
      align-self: flex-start;
    }

    .pdp-information__wrapper {
      flex: 1 1 0;
      min-width: 0;
      width: auto;
      padding-block: 0;
    }

    .pdp-information {
      max-width: none;
      padding: 2rem;
    }

    /* Swap visibility: hide mobile layout, show desktop layout */
    .pdp-gallery--mobile-only {
      display: none;
    }

    .pdp-gallery--desktop-only {
      display: block;
    }
  }
{%- endstyle -%}

<div class="pdp-page">
  <div class="pdp-breadcrumbs">
    {% render 'breadcrumbs' %}
  </div>

  <div class="pdp">
    <div class="pdp-gallery__wrapper">
      {% comment %}
        Media Gallery Layout Support
        - Supports different layouts for mobile and desktop
        - Uses CSS classes to show/hide appropriate gallery based on breakpoint
      {% endcomment %}
      {%- liquid
        assign desktop_layout = section.settings.media_layout
        assign mobile_layout = section.settings.mobile_media_layout
        assign layouts_differ = false
        if desktop_layout != mobile_layout
          assign layouts_differ = true
        endif
      -%}

      {%- if layouts_differ -%}
        {% comment %} Mobile and desktop have different layouts - render both with visibility classes {% endcomment %}
        <div class="pdp-gallery--mobile-only">
          {%- case mobile_layout -%}
            {%- when 'carousel' -%}
              {% render 'pdp-gallery-carousel', product: product %}
            {%- when 'grid' -%}
              {% render 'pdp-gallery-grid', product: product %}
          {%- endcase -%}
        </div>
        <div class="pdp-gallery--desktop-only">
          {%- case desktop_layout -%}
            {%- when 'carousel' -%}
              {% render 'pdp-gallery-carousel', product: product %}
            {%- when 'grid' -%}
              {% render 'pdp-gallery-grid', product: product %}
          {%- endcase -%}
        </div>
      {%- else -%}
        {% comment %} Same layout for both - render once {% endcomment %}
        {%- case desktop_layout -%}
          {%- when 'carousel' -%}
            {% render 'pdp-gallery-carousel', product: product %}
          {%- when 'grid' -%}
            {% render 'pdp-gallery-grid', product: product %}
        {%- endcase -%}
      {%- endif -%}
    </div>

    <div class="pdp-information__wrapper">
      {%- form 'product', product, id: product_form_id, class: 'pdp-information' -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        <input type="hidden" name="quantity" value="1">

        <div id="ProductInfo-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'ratings' -%}
                {% render 'pdp-ratings', block: block, product: product %}

              {%- when 'title' -%}
                {% render 'pdp-title', block: block, product: product %}

              {%- when 'vendor' -%}
                {% render 'pdp-vendor', block: block, product: product %}

              {%- when 'price' -%}
                {% render 'pdp-price', block: block, product: product %}

              {%- when 'shop_pay_installments' -%}
                {% render 'pdp-shop-pay-installments', block: block, form: form %}

              {%- when 'text' -%}
                {% render 'pdp-text', block: block, product: product %}

              {%- when 'details_metafield' -%}
                {% render 'pdp-details-metafield', block: block, product: product %}

              {%- when 'view_counter' -%}
                {% render 'pdp-view-counter', block: block %}

              {%- when 'variant_selector' -%}
                {% render 'pdp-variant-selector',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id
                %}

              {%- when 'quantity_selector' -%}
                {% render 'pdp-quantity-selector', block: block, product: product %}

              {%- when 'icon_with_text' -%}
                {% render 'pdp-icon-with-text', block: block %}

              {%- when 'highlight_list' -%}
                {% render 'pdp-highlight-list', block: block %}

              {%- when 'atc' -%}
                {% render 'pdp-add-to-cart', form_id: product_form_id, form: form, block: block, product: product %}

              {%- when 'guarantee_text' -%}
                {% render 'pdp-guarantee-text', block: block %}

              {%- when 'side_panel' -%}
                {% render 'pdp-side-panel', block: block %}

              {%- when 'accordion' -%}
                {% render 'pdp-accordion', block: block %}

              {%- when 'media' -%}
                {% render 'pdp-media', block: block %}

              {%- when 'extra_content' -%}
                {% render 'pdp-extra-content', block: block %}

              {%- when 'story' -%}
                {% render 'pdp-story', block: block %}

              {%- when 'features_highlight' -%}
                {% render 'pdp-features-highlight', block: block %}

              {%- when 'cross_sell' -%}
                {% render 'pdp-cross-sell', block: block, product: product %}

              {%- when 'divider' -%}
                {% render 'pdp-divider', block: block %}

              {%- when 'testimonial' -%}
                {% render 'pdp-testimonial', block: block %}

              {%- when 'order_sample' -%}
                {% render 'pdp-order-sample', block: block, product: product %}

              {%- when 'estimated_delivery' -%}
                {% render 'pdp-estimated-delivery-timeline', block: block %}

              {%- when 'custom_liquid' -%}
                {% render 'pdp-custom-liquid', block: block %}

              {%- when 'app_embed_mount' -%}
                {% render 'pdp-app-embed-mount', block: block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% render 'sticky-add-to-cart', product: product, form_id: product_form_id %}


{% comment %} ORIGINAL CODE (Static Heading) {% endcomment %}

{% comment %}
  {%- comment -%}
    Testimonial Carousel Section (Vanilla CSS)
    - Mobile First Design
    - Desktop Grid Layout (>= 64rem)
    - Synced Swipers for Image + Content
  {%- endcomment -%}

  {% style %}
    /* --- Section Variables & Base --- */
    #testimonial-carousel-{{ section.id }} {
      --fg-color: {{ section.settings.fg_color | default: '#ffffff' }};
      --bg-color: {{ section.settings.bg_color | default: '#222222' }};

      --heading-font-size: {{ section.settings.heading_font_size }};
      --heading-line-height: {{ section.settings.heading_line_height }};
      --heading-font-weight: {{ section.settings.heading_font_weight }};

      position: relative;
      width: 100%;
      overflow: hidden;
      {%- if section.settings.color_mode == 'custom' -%}
        color: var(--fg-color);
        background: var(--bg-color);
      {%- else -%}
        color: var(--color-foreground);
        background: var(--color-background);
      {%- endif -%}
    }

    /* --- Layout Grid --- */
    .testimonial-carousel-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    /* Image Column (Left/Top) */
    #testimonial-carousel-{{ section.id }} .image-swiper {
      height: 100%;
    }

    .testimonial-carousel-image-col {
      position: relative;
      width: 100%;
      height: 100%;
      background-color: var(--color-primary-background); /* Gray placeholder */
      overflow: hidden;
    }

    .testimonial-carousel-img-full {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Content Column (Right/Bottom) */
    .testimonial-carousel-content-col {
      max-width: 45rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 3rem;
      padding-inline: 1rem;
    }

    .testimonial-carousel-content-wrapper {
      max-width: 36rem;
      margin: 0 auto;
      width: 100%;
    }

    /* --- Typography --- */
    .testimonial-carousel-heading {
      font-family: var(--font-heading--family); /* Use theme font or serif */
      font-size: var(--heading-font-size);
      line-height: var(--heading-line-height);
      font-weight: var(--heading-font-weight);
      margin-bottom: 0.625rem;
    }

    .testimonial-carousel-subheading {
      font-size: 0.875rem; /* ~14px */
      line-height: calc(1.25 / 0.875);
      margin-bottom: 1.5rem;
      opacity: 0.8;
    }

    /* --- Components --- */
    .testimonial-carousel-author-wrapper {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .testimonial-carousel-stars {
      display: flex;
      gap: 0.25rem;
      color: var(--color-star-rating-foreground); /* Yellow-400 */
    }

    .testimonial-carousel-star-icon {
      width: 1.125rem;
      height: 1.125rem;
      fill: currentColor;
    }

    .testimonial-carousel-author {
      font-size: 1rem;
      line-height: calc(1.5 / 1);
      font-weight: 500;
    }

    .testimonial-carousel-quotes {
      font-size: 1rem;
      line-height: calc(1.5 / 1);
    }

    /* --- Controls --- */
    .testimonial-carousel-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 2.5rem;
    }

    .testimonial-carousel-nav-btn {
      padding: 0.5rem;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s;
      color: inherit;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .testimonial-carousel-nav-btn:hover {
      opacity: 0.7;
    }

    .testimonial-carousel-nav-icon {
      width: 1.5rem;
      height: 1.5rem;
      stroke: currentColor;
      stroke-width: 1.5px;
    }

     /* --- Swiper Overrides --- */
    #testimonial-carousel-{{ section.id }} .swiper-pagination {
      position: relative !important;
      inset: auto !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0.5rem;
    }

    #testimonial-carousel-{{ section.id }} .swiper-pagination-bullet {
      background: var(--color-muted-foreground);
      opacity: 0.7;
      width: 0.75rem;
      height: 0.75rem;
      margin: 0 !important;
    }

    #testimonial-carousel-{{ section.id }} .swiper-pagination-bullet-active {
      {%- if section.settings.color_mode == 'custom' -%}
        background: var(--fg-color);
      {%- else -%}
        background: var(--color-foreground);
      {%- endif -%}
    }

    .testimonial-carousel-cursor-grab {
      cursor: grab;
    }

    .testimonial-carousel-cursor-grab:active {
      cursor: grabbing;
    }

    /* --- Desktop Breakpoint (>= 64rem / 1024px) --- */
    @media (min-width: 64rem) {
      .testimonial-carousel-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        min-height: 400px;
      }

      .testimonial-carousel-image-col {
        height: auto; /* Fill grid height */
      }
    }
  {% endstyle %}

  <div id="testimonial-carousel-{{ section.id }}">
    <div class="testimonial-carousel-grid">

      {%- comment -%}
        LOGIC: Count blocks with images
      {%- endcomment -%}
      {% assign image_count = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% assign image_count = image_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      <!-- LEFT COLUMN: IMAGERY -->
      <div class="testimonial-carousel-image-col">
        {% if image_count > 1 %}
          <!-- SCENARIO: Multiple Images -> Render Swiper -->
          <div class="swiper image-swiper">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'testimonial-carousel-img-full', loading: 'lazy' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'testimonial-carousel-img-full' }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <!-- SCENARIO: 1 or 0 Images -> Render Static Image -->
          {% assign first_block = section.blocks.first %}
          {% if first_block.settings.image != blank %}
              {{ first_block.settings.image | image_url: width: 1000 | image_tag: class: 'testimonial-carousel-img-full', loading: 'lazy' }}
          {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'testimonial-carousel-img-full' }}
          {% endif %}
        {% endif %}
      </div>

      <!-- RIGHT COLUMN: CONTENT -->
      <div class="testimonial-carousel-content-col">
        <div class="testimonial-carousel-content-wrapper">

          <!-- STATIC HEADER GROUP -->
          {% if section.settings.heading != blank %}
            <h2 class="testimonial-carousel-heading">
              {{ section.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="testimonial-carousel-subheading">
              {{ section.settings.subheading | escape }}
            </p>
          {% endif %}

          <!-- TEXT SWIPER -->
          <div class="swiper text-swiper" style="margin-bottom: 2rem;">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide testimonial-carousel-cursor-grab">
                 <!-- Stars & Author -->
                  <div class="testimonial-carousel-author-wrapper">
                    <!-- Stars -->
                    <div class="testimonial-carousel-stars">
                      {% for i in (1..5) %}
                         <svg class="testimonial-carousel-star-icon" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      {% endfor %}
                    </div>

                    <!-- Author -->
                    <p class="testimonial-carousel-author">| &nbsp; {{ block.settings.author }}</p>
                  </div>

                  <!-- Comment -->
                  <div class="testimonial-carousel-quote">
                    {{ block.settings.quote }}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          <!-- STATIC CONTROLS -->
          <div class="testimonial-carousel-controls">
            <button class="testimonial-carousel-nav-prev testimonial-carousel-nav-btn" aria-label="Previous slide">
               <svg class="testimonial-carousel-nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            </button>

            <div class="swiper-pagination"></div>

            <button class="testimonial-carousel-nav-next testimonial-carousel-nav-btn" aria-label="Next slide">
              <svg class="testimonial-carousel-nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Find the unique section wrapper
      const section = document.querySelector('#testimonial-carousel-{{ section.id }}');
      if (!section) return;

      // Find elements *within* this section
      const imageSwiperEl = section.querySelector('.image-swiper');
      const textSwiperEl = section.querySelector('.text-swiper');
      const prevButtonEl = section.querySelector('.testimonial-carousel-nav-prev');
      const nextButtonEl = section.querySelector('.testimonial-carousel-nav-next');
      const paginationEl = section.querySelector('.swiper-pagination');

      // Check if we have multiple images (Rendered by Liquid)
      const hasImageSwiper = imageSwiperEl;
      let imageSwiper = null;

      if (hasImageSwiper) {
        imageSwiper = new Swiper(imageSwiperEl, {
          loop: true,
          effect: 'fade',
          fadeEffect: { crossFade: true },
          allowTouchMove: false // Prevent manual swiping of image, let text drive it
        });
      }

      const textSwiper = new Swiper(textSwiperEl, {
        loop: true,
        autoHeight: true,
        pagination: {
          el: paginationEl,
          clickable: true,
        },
        navigation: {
          prevEl: prevButtonEl,
          nextEl: nextButtonEl,
        },
        on: {
          // Sync Logic
          slideChange: function() {
            if (imageSwiper) {
              imageSwiper.slideToLoop(this.realIndex);
            }
          }
        }
      });
    });
  </script>


{%- liquid
  assign section_id = section.id
  assign articles_grid_id = 'swiper-' | append: section_id
-%}

{%- style -%}
  #articles-grid-{{ section_id }} {
    --heading-font-size: {{ section.settings.heading_font_size }};
    --heading-line-height: {{ section.settings.heading_line_height }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-left: {{ section.settings.mobile_padding_left }}px;
    --padding-right: {{ section.settings.mobile_padding_right }}px;

    {%- if section.settings.color_mode == 'custom' -%}
      color: {{ section.settings.fg_color }};
      background: {{ section.settings.bg_color }};
    {%- else -%}
      color: var(--color-foreground);
      background: var(--color-background);
    {%- endif -%}
  }

  #articles-grid-{{ section_id }} .articles-grid {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: var(--padding-left);
    padding-right: var(--padding-right);
  }

  .articles-grid-header-wrapper {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .articles-grid-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .articles-grid-header h2 {
    font-family: var(--font-heading--family);
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    font-weight: var(--heading-font-weight);
  }

  .articles-grid-header p {
    font-size: 1.125rem;
    line-height: 140%;
  }

  #articles-grid-{{ section_id }} .swiper-slide {
    /* This required if you want all flex item has same height */
    height: auto;
  }

  #articles-grid-{{ section_id }} .articles-grid-arrows {
    align-self: end;
    display: none;
  }

  #articles-grid-{{ section_id }} .articles-grid-button-prev.swiper-button-disabled,
  #articles-grid-{{ section_id }} .articles-grid-button-next.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Style the SVG icon inside */
  #articles-grid-{{ section_id }} .articles-grid-arrow svg {
    width: 1.5rem;
    height: 1.5rem;
    /* Ensure the icon is filled with the current text color */
    fill: currentColor;
    stroke: none;
  }

  #articles-grid-{{ section_id }} .articles-grid-progressbar {
    display: block;
    width: 100%;
    height: 4px;
    background: var(--color-progressbar-background);
    border-radius: 2px;
    margin-top: 30px;
    position: relative;
    overflow: hidden;
  }

  #articles-grid-{{ section_id }} .articles-grid-progressbar .swiper-pagination-progressbar-fill {
    background: var(--color-progressbar-fill);
    height: 100%;
  }

  @media (width >= 64rem) {
    #articles-grid-{{ section_id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --padding-left: {{ section.settings.desktop_padding_left }}px;
      --padding-right: {{ section.settings.desktop_padding_right }}px;
    }

    #articles-grid-{{ section_id }} .articles-grid {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      padding-left: var(--padding-left);
      padding-right: var(--padding-right);
    }

    #articles-grid-{{ section_id }} .articles-grid-arrows {
      display: flex;
      gap: 1rem;
      flex-shrink: 0;
    }

    #articles-grid-{{ section_id }} .articles-grid-progressbar {
      display: none;
    }
  }
{%- endstyle -%}

<div id="articles-grid-{{ section_id }}">
  <div class="shopify-page-width shopify-page-padding">
    <div class="articles-grid">
      <div class="articles-grid-header-wrapper">
        <div class="articles-grid-header">
          {%- if section.settings.heading != blank -%}
            <h2>{{- section.settings.heading -}}</h2>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <p>{{- section.settings.subheading -}}</p>
          {%- endif -%}
        </div>

        <div class="articles-grid-arrows">
          <button class="articles-grid-button-prev" aria-label="Previous slide">
            <svg
              width="14"
              height="22"
              viewBox="0 0 14 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M13.3334 1.60236L3.48271 10.6667L13.3334 19.7309L11.592 21.3333L4.14954e-05 10.6667L11.592 -7.61172e-08L13.3334 1.60236Z" fill="currentColor"/>
            </svg>
          </button>
          <button class="articles-grid-button-next" aria-label="Next slide">
            <svg
              width="14"
              height="22"
              viewBox="0 0 14 22"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M-7.00414e-08 19.731L9.85066 10.6667L-8.62466e-07 1.60244L1.74136 4.18856e-05L13.3333 10.6667L1.74136 21.3334L-7.00414e-08 19.731Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div id="{{ articles_grid_id }}" class="swiper">
        <ul class="swiper-wrapper">
          {% for block in section.blocks %}
            {%- if block.type == 'article_card' -%}
              <li class="swiper-slide" {{ block.shopify_attributes }}>
                {% render 'article-card',
                  article: block.settings.article,
                  override_image: block.settings.override_image,
                  style: section.settings.article_card_style,
                  image_object_fit: section.settings.image_object_fit,
                  image_desktop_aspect_ratio: section.settings.image_desktop_aspect_ratio,
                  image_desktop_enable_custom_dimension: section.settings.image_desktop_enable_custom_dimension,
                  image_desktop_custom_width: section.settings.image_desktop_custom_width,
                  image_desktop_custom_height: section.settings.image_desktop_custom_height,
                  image_enable_mobile_size: section.settings.image_enable_mobile_size,
                  image_mobile_aspect_ratio: section.settings.image_mobile_aspect_ratio,
                  image_mobile_enable_custom_dimension: section.settings.image_mobile_enable_custom_dimension,
                  image_mobile_custom_width: section.settings.image_mobile_custom_width,
                  image_mobile_custom_height: section.settings.image_mobile_custom_height
                %}
              </li>
            {%- endif -%}
          {% endfor %}
        </ul>

        <div class="articles-grid-progressbar"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Find the section first
    const section = document.querySelector('#articles-grid-{{ section_id }}');

    if (!section) {
      console.error('Section not found');
      return;
    }

    // Find elements within the section
    const swiperContainer = section.querySelector('#{{ articles_grid_id }}');
    const nextButton = section.querySelector('.articles-grid-button-next');
    const prevButton = section.querySelector('.articles-grid-button-prev');
    const paginationEl = section.querySelector('.articles-grid-progressbar');

    if (!swiperContainer) {
      console.error('Swiper not found: #{{ articles_grid_id }}');
      return;
    }

    if (typeof Swiper === 'undefined') {
      console.error('Swiper library not loaded');
      return;
    }

    // Initialize Swiper
    new Swiper(swiperContainer, {
      slidesPerView: {{ section.settings.mobile_slides_per_view }},
      spaceBetween: 32,
      navigation: {
        nextEl: nextButton,
        prevEl: prevButton,
      },
      pagination: {
        el: paginationEl,
        type: 'progressbar',
      },
      breakpoints: {
        768: {
          slidesPerView: 2.3,
        },
        1024: {
          slidesPerView: {{ section.settings.desktop_slides_per_view }},
        },
      },
    });
  });
</script>

{%- schema -%}
{
  "name": "t:section.articles_grid.name",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "⚠️ Save to display section correctly"
    },
    {
      "type": "text",
      "id": "desktop_slides_per_view",
      "label": "Desktop Slides Per View",
      "default": "3",
      "info": "Enter a number (whole or decimal, e.g., 1, 2, 1.5). Decimals let you show partial slides (e.g., 1.4 shows one slide plus 40% of the next)."
    },
    {
      "type": "text",
      "id": "mobile_slides_per_view",
      "label": "Mobile Slides Per View",
      "default": "1.3",
      "info": "Enter a number (whole or decimal, e.g., 1, 2, 1.5). Decimals let you show partial slides (e.g., 1.4 shows one slide plus 40% of the next)."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:typography.heading.label",
      "default": "Wellness Insights"
    },
    {
      "type": "text",
      "id": "heading_font_size",
      "label": "t:typography.font_size.label",
      "placeholder": "px, rem, etc.",
      "default": "2rem"
    },
    {
      "type": "text",
      "id": "heading_line_height",
      "label": "t:typography.line_height.label",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "140%"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:typography.font_weight.label",
      "options": [
        {
          "value": "400",
          "label": "t:typography.font_weight.options.regular"
        },
        {
          "value": "500",
          "label": "t:typography.font_weight.options.medium"
        },
        {
          "value": "600",
          "label": "t:typography.font_weight.options.semibold"
        },
        {
          "value": "700",
          "label": "t:typography.font_weight.options.bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:typography.subheading.label"
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "t:colors.foreground_color.label",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#222222",
      "info": "Choose a solid background color",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "article_card_style",
      "label": "Article Card Style",
      "options": [
        {
          "value": "minimal",
          "label": "Minimalist"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "header",
      "content": "Image"

      "type": "header",
      "content": "t:size.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "image_enable_mobile_size",
      "label": "Enable Mobile Size",
      "default": true
    },
    {
      "type": "select",
      "id": "image_mobile_aspect_ratio",
      "label": "Mobile Aspect Ratio",

{% comment %} COLLECTION CARD (Dynamic block-based system) {% endcomment %}

{%- liquid
  assign section_id = section.id
  assign carousel_id = 'swiper-' | append: section_id
  assign collection_card_block_count = 0
  assign valid_collection_block_count = 0
  assign show_section = false

  for block in section.blocks
    if block.type == 'collection_card'
      assign collection_card_block_count = collection_card_block_count | plus: 1
      assign block_collection = block.settings.collection

      if block_collection != blank and block_collection.handle != blank
        assign valid_collection_block_count = valid_collection_block_count | plus: 1
      endif
    endif
  endfor

  if valid_collection_block_count > 0 or request.design_mode
    assign show_section = true
  endif
-%}

{%- style -%}
  #collections-grid-{{ section_id }} {
    --heading-font-size: {{ section.settings.heading_font_size }};
    --heading-line-height: {{ section.settings.heading_line_height }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};

    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-left: {{ section.settings.mobile_padding_left }}px;
    --padding-right: {{ section.settings.mobile_padding_right }}px;

    {%- if section.settings.color_mode == 'custom' -%}
      color: {{ section.settings.fg_color }};
      background: {{ section.settings.bg_color }};
    {%- else -%}
      color: var(--color-foreground);
      background: var(--color-background);
    {%- endif -%}
  }

  #collections-grid-{{ section_id }} .collections-grid {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: var(--padding-left);
    padding-right: var(--padding-right);
  }

  .collections-grid__header--wrapper {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .collections-grid__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .collections-grid__header h2 {
    font-family: var(--font-heading--family);
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    font-weight: var(--heading-font-weight);
  }

  .collections-grid__header div {
    font-size: 1.125rem;
    line-height: 140%;
  }

  #collection-grid-{{ section_id }} .swiper-slide {
    /* This required if you want all flex item has same height */
    height: auto;
  }

  #collections-grid-{{ section_id }} .carousel-arrows {
    align-self: end;
    display: none;
  }

  #collections-grid-{{ section_id }} .carousel-button-prev.swiper-button-disabled,
  #collections-grid-{{ section_id }} .carousel-button-next.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Style the SVG icon inside */
  #collections-grid-{{ section_id }} .carousel-arrow svg {
    width: 1.5rem;
    height: 1.5rem;
    /* Ensure the icon is filled with the current text color */
    fill: currentColor;
    stroke: none;
  }

  #collections-grid-{{ section_id }} .carousel-progressbar {
    display: block;
    width: 100%;
    height: 4px;
    background: var(--color-progressbar-background);
    border-radius: 2px;
    margin-top: 30px;
    position: relative;
    overflow: hidden;
  }

  #collections-grid-{{ section_id }} .carousel-progressbar .swiper-pagination-progressbar-fill {
    background: var(--color-progressbar-fill);
    height: 100%;
  }

  @media (width >= 64rem) {
    #collections-grid-{{ section_id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --padding-left: {{ section.settings.desktop_padding_left }}px;
      --padding-right: {{ section.settings.desktop_padding_right }}px;
    }

    #collections-grid-{{ section_id }} .collections-grid {
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      padding-left: var(--padding-left);
      padding-right: var(--padding-right);
    }

    #collections-grid-{{ section_id }} .carousel-arrows {
      display: flex;
      gap: 1rem;
      flex-shrink: 0;
    }

    #collections-grid-{{ section_id }} .carousel-progressbar {
      display: none;
    }
  }
{%- endstyle -%}

{%- if show_section -%}
  <div id="collections-grid-{{ section_id }}">
    <div class="shopify-page-width shopify-page-padding">
      <div class="collections-grid">
        <div class="collections-grid__header--wrapper">
          <div class="collections-grid__header">
            {%- if section.settings.heading != blank -%}
              <h2>{{- section.settings.heading -}}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <div>{{- section.settings.subheading -}}</div>
            {%- endif -%}
          </div>

          <div class="carousel-arrows">
            <button class="carousel-button-prev" aria-label="Previous slide">
              <svg
                width="14"
                height="22"
                viewBox="0 0 14 22"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M13.3334 1.60236L3.48271 10.6667L13.3334 19.7309L11.592 21.3333L4.14954e-05 10.6667L11.592 -7.61172e-08L13.3334 1.60236Z" fill="currentColor"/>
              </svg>
            </button>
            <button class="carousel-button-next" aria-label="Next slide">
              <svg
                width="14"
                height="22"
                viewBox="0 0 14 22"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path fill-rule="evenodd" clip-rule="evenodd" d="M-7.00414e-08 19.731L9.85066 10.6667L-8.62466e-07 1.60244L1.74136 4.18856e-05L13.3333 10.6667L1.74136 21.3334L-7.00414e-08 19.731Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="{{ carousel_id }}" class="swiper">
          <div class="swiper-wrapper">
            {%- if collection_card_block_count > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'collection_card' -%}
                  {%- liquid
                    assign block_collection = block.settings.collection
                    assign is_valid_collection = false

                    if block_collection != blank and block_collection.handle != blank
                      assign is_valid_collection = true
                    endif
                  -%}

                  {%- if is_valid_collection or request.design_mode -%}
                    <div class="swiper-slide" {{ block.shopify_attributes }}>
                      {%- if is_valid_collection -%}
                        {% render 'collection-card',
                          id: block.id,
                          collection: block_collection,
                          image_override: block.settings.image_override,
                          title_override: block.settings.title_override,
                          desktop_aspect_ratio: block.settings.aspect_ratio,
                          icon_mode: block.settings.icon_mode,
                          icon_select: block.settings.icon_select,
                          icon_custom: block.settings.icon
                        %}
                      {%- else -%}
                        {% render 'collection-card',
                          id: block.id,
                          collection: null,
                          image_override: block.settings.image_override,
                          title_override: block.settings.title_override,
                          desktop_aspect_ratio: block.settings.aspect_ratio,
                          icon_mode: block.settings.icon_mode,
                          icon_select: block.settings.icon_select,
                          icon_custom: block.settings.icon
                        %}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif request.design_mode -%}
              {%- for i in (1..4) -%}
                <div class="swiper-slide">
                  {% render 'collection-card',
                    id: section.id,
                    collection: null,
                    desktop_aspect_ratio: '1 / 1',
                    icon_mode: 'select',
                    icon_select: 'arrow-right'
                  %}
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="carousel-progressbar"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Find the section first
      const section = document.querySelector('#collections-grid-{{ section_id }}');

      if (!section) {
        console.error('Section not found');
        return;
      }

      // Find elements within the section
      const swiperContainer = section.querySelector('#{{ carousel_id }}');
      const prevButton = section.querySelector('.carousel-button-prev');
      const nextButton = section.querySelector('.carousel-button-next');
      const paginationEl = section.querySelector('.carousel-progressbar');

      if (!swiperContainer) {
        console.error('Swiper not found: #{{ carousel_id }}');
        return;
      }

      if (typeof Swiper === 'undefined') {
        console.error('Swiper library not loaded');
        return;
      }

      // Initialize Swiper
      new Swiper(swiperContainer, {
        slidesPerView: {{ section.settings.mobile_slides_per_view }},
        spaceBetween: 32,
        navigation: {
          nextEl: nextButton,
          prevEl: prevButton,
        },
        pagination: {
          el: paginationEl,
          type: 'progressbar',
        },
        breakpoints: {
          768: {
            slidesPerView: 2.3,
          },
          1024: {
            slidesPerView: {{ section.settings.desktop_slides_per_view }},
          },
        },
      });
    });
  </script>
{%- endif -%}


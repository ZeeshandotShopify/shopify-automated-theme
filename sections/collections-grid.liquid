{% comment %} COLLECTION CARD (Static block-based system) {% endcomment %}

{% comment %}
  <style>
    #collections-grid-{{ section.id }} {
      {% comment %} Color Variables {% endcomment %}
      --fg-color: {{ section.settings.fg_color | default: '#ffffff' }};
      --bg-color: {{ section.settings.bg_color | default: '#222222' }};
      --progressbar-bg-color: var(--color-progressbar-background);
      --progressbar-fill-color: var(--color-progressbar-fill);

      {% comment %} Heading Font Size/Weight Variables {% endcomment %}
      --heading-font-size: {{ section.settings.heading_font_size }};
      --heading-line-height: {{ section.settings.heading_line_height }};
      --heading-font-weight: {{ section.settings.heading_font_weight }};

      {% comment %} Padding Variables {% endcomment %}
      --desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
      --desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --desktop-padding-left: {{ section.settings.desktop_padding_left }}px;
      --desktop-padding-right: {{ section.settings.desktop_padding_right }}px;
      --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
      --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --mobile-padding-left: {{ section.settings.mobile_padding_left }}px;
      --mobile-padding-right: {{ section.settings.mobile_padding_right }}px;

      {%- if section.settings.color_mode == 'custom' -%}
        color: var(--fg-color);
        background: var(--bg-color);
      {%- else -%}
        color: var(--color-foreground);
        background: var(--color-background);
      {%- endif -%}
    }

    #collections-grid-{{ section.id }} .collections-grid {
      padding: var(--mobile-padding-top) var(--mobile-padding-right) var(--mobile-padding-bottom) var(--mobile-padding-left);
    }

    #collections-grid-{{ section.id }} .swiper {
      width: 100%;
      height: 100%;
    }

    .collections-grid__swiper {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .collections-grid__header--wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .collections-grid__header {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .collections-grid__heading {
      font-family: var(--font-heading--family);
      font-size: var(--heading-font-size);
      line-height: var(--heading-line-height);
      font-weight: var(--heading-font-weight);
    }

    #collections-grid-{{ section.id }} .collections-grid__swiper-buttons {
      display: none;
    }

    #collections-grid-{{ section.id }} .collections-grid__swiper-buttons .swiper-button-next,
    #collections-grid-{{ section.id }} .collections-grid__swiper-buttons .swiper-button-prev {
      display: block;
      position: static;
      inset: unset;
      height: 1.5rem;
      width: 1.5rem;
      color: inherit;
      margin: 0;
    }

    #collections-grid-{{ section.id }} .collections-grid__swiper .swiper-pagination-progressbar {
      position: relative;
      inset: unset;
      background: var(--progressbar-bg-color);
    }

    #collections-grid-{{ section.id }} .collections-grid__swiper .swiper-pagination-progressbar-fill {
      background: var(--progressbar-fill-color);
    }

    @media (width >= 64rem) {
      #collections-grid-{{ section.id }} .collections-grid {
        padding: var(--desktop-padding-top) var(--desktop-padding-right) var(--desktop-padding-bottom) var(--desktop-padding-left);
      }

      #collections-grid-{{ section.id }} .collections-grid__swiper-buttons {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #collections-grid-{{ section.id }} .collections-grid__swiper .swiper-pagination-progressbar {
        display: none;
      }
    }
  </style>

  <div id="collections-grid-{{ section.id }}">
    <div class="shopify-page-width shopify-page-padding">
      <div class="collections-grid">
        {%- for block in section.blocks -%}
          <div class="swiper collections-grid__swiper">
            <div class="collections-grid__header--wrapper">
              <div class="collections-grid__header">
                {%- if section.settings.heading != blank -%}
                  <h2 class="collections-grid__heading">{{- section.settings.heading -}}</h2>
                {%- endif -%}
                {%- if section.settings.subheading != blank -%}
                  <p class="collections-grid__subheading">{{- section.settings.subheading -}}</p>
                {%- endif -%}
              </div>

              <div class="collections-grid__swiper-buttons">
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
              </div>
            </div>

            <div class="swiper-wrapper">
              {%- liquid
                assign max_items = 4

                # COLLECTION SOURCE LOGIC:
                # Determine which collections to display.
                assign has_collections = false

                if section.settings.collection_list != blank
                  assign collection_list = section.settings.collection_list
                  assign has_collections = true
                endif
              -%}

              {%- if has_collections -%}
                {%- for collection in collection_list -%}
                  <div class="swiper-slide">
                    {%- if block.type == 'collection_card' -%}
                      {% render 'collection-card',
                        id: block.id,
                        collection: collection,
                        desktop_aspect_ratio: block.settings.aspect_ratio,
                        icon_mode: block.settings.icon_mode,
                        icon_select: block.settings.icon_select,
                        icon_custom: block.settings.icon
                      %}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- comment -%}
                  PLACEHOLDER LOGIC:
                  When no collections are selected, show 4 placeholder cards
                {%- endcomment -%}
                {%- for i in (1..max_items) -%}
                  <div class="swiper-slide">
                    {%- if block.type == 'collection_card' -%}
                      {% render 'collection-card',
                        id: block.id,
                        collection: null,
                        desktop_aspect_ratio: block.settings.aspect_ratio,
                        icon_mode: block.settings.icon_mode,
                        icon_select: block.settings.icon_select,
                        icon_custom: block.settings.icon
                      %}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>

            <div class="swiper-pagination"></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // Find the unique section wrapper
    const section = document.querySelector('#collections-grid-{{ section.id }}');
    if (!section) return;

    // Find elements *within* this section
    const swiperContainer = section.querySelector('.collections-grid__swiper');
    const nextButton = section.querySelector('.swiper-button-next');
    const prevButton = section.querySelector('.swiper-button-prev');
    const paginationEl = section.querySelector('.swiper-pagination');

    // Pass the actual elements to Swiper, not generic strings
    var swiper = new Swiper(swiperContainer, {
      slidesPerView: 1.3,
      spaceBetween: 16,
      navigation: {
        nextEl: nextButton,
        prevEl: prevButton,
      },
      pagination: {
        el: paginationEl,
        type: "progressbar",
      },
      breakpoints: {
          1024: {
            slidesPerView: 4,
            spaceBetween: 32,
          },
        },
    });
  });
  </script>


{%- liquid
  assign section_id = section.id
  assign per_page = section.settings.articles_per_page

  assign heading = section.settings.heading | default: blog.title

  comment
    Required: at least one article in the blog. Every other setting is
    skip-only — a card whose article has no image gets the placeholder block,
    one with no excerpt simply closes the gap.
  endcomment
  assign show_section = false
  assign show_placeholder = false
  if blog.articles_count > 0
    assign show_section = true
  elsif request.design_mode
    assign show_placeholder = true
  endif

  comment
    Colour resolves through a mode select rather than a schema default, because
    a `color` setting cannot default to a CSS variable. `inherit` hands back the
    theme token; `custom` hands back the merchant's swatch. Same shape as
    snippets/pdp-testimonial.liquid.
  endcomment
  if section.settings.color_mode == 'custom'
    assign blog_heading_color = section.settings.heading_color
    assign blog_divider_color = section.settings.divider_color
    assign blog_date_color = section.settings.date_color
    assign blog_title_color = section.settings.title_color
    assign blog_excerpt_color = section.settings.excerpt_color
    assign blog_image_placeholder_color = section.settings.image_placeholder_color
  else
    assign blog_heading_color = 'var(--color-foreground)'
    assign blog_divider_color = 'var(--color-border)'
    assign blog_date_color = 'var(--color-muted-foreground)'
    assign blog_title_color = 'var(--color-foreground)'
    assign blog_excerpt_color = 'var(--color-muted-foreground)'
    assign blog_image_placeholder_color = 'var(--color-muted-background)'
  endif

  comment
    The same select governs the pager. No theme token exists for the resting
    numeral or the arrow chip — the global pagination settings cover the active
    pill only, and snippets/pagination-nav.liquid leaves the rest at
    `color: inherit`.
  endcomment
  if section.settings.color_mode == 'custom'
    assign blog_pagination_active_bg = section.settings.pagination_active_background
    assign blog_pagination_active_color = section.settings.pagination_active_color
    assign blog_pagination_inactive_color = section.settings.pagination_inactive_color
    assign blog_pagination_arrow_bg = section.settings.pagination_arrow_background
  else
    assign blog_pagination_active_bg = 'var(--color-pagination-nav-background)'
    assign blog_pagination_active_color = 'var(--color-pagination-nav-foreground)'
    assign blog_pagination_inactive_color = 'var(--color-foreground)'
    assign blog_pagination_arrow_bg = 'var(--color-muted-background)'
  endif
-%}

{%- if show_section or show_placeholder -%}
  {%- style -%}
    #blog-{{ section_id }} {
      /* Text and border DO map to theme globals and are read from them through
         the section's own `color_mode`, so retuning a global still reaches here. */
      --blog-bg-color: {{ section.settings.bg_color }};
      --blog-bg-image: url('{{ section.settings.bg_image | image_url: width: 3840 }}');

      --blog-heading-color: {{ blog_heading_color }};
      --blog-heading-font-size: {{ section.settings.mobile_heading_font_size }};
      --blog-divider-color: {{ blog_divider_color }};

      --blog-card-gap: {{ section.settings.card_gap }}px;
      --blog-row-gap: {{ section.settings.card_row_gap }}px;
      --blog-column-gap: {{ section.settings.desktop_column_gap }}px;

      --blog-image-radius: {{ section.settings.image_border_radius }};
      --blog-image-width: 100%;
      --blog-image-height: {{ section.settings.mobile_image_height }};
      --blog-image-placeholder-color: {{ blog_image_placeholder_color }};

      --blog-date-color: {{ blog_date_color }};
      --blog-title-color: {{ blog_title_color }};
      --blog-excerpt-color: {{ blog_excerpt_color }};
      --blog-title-line-clamp: {{ section.settings.title_line_clamp }};
      --blog-excerpt-line-clamp: {{ section.settings.mobile_excerpt_line_clamp }};

      --blog-pagination-offset: {{ section.settings.pagination_offset }}px;
      --blog-pagination-active-bg: {{ blog_pagination_active_bg }};
      --blog-pagination-active-color: {{ blog_pagination_active_color }};
      --blog-pagination-inactive-color: {{ blog_pagination_inactive_color }};
      --blog-pagination-arrow-bg: {{ blog_pagination_arrow_bg }};

      --blog-padding-top: {{ section.settings.mobile_padding_top }}px;
      --blog-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --blog-padding-left: {{ section.settings.mobile_padding_left }}px;
      --blog-padding-right: {{ section.settings.mobile_padding_right }}px;

      position: relative;
      overflow: hidden;
    }

    #blog-{{ section_id }}[data-bg-mode='custom'][data-bg-type='color'] {
      background: var(--blog-bg-color);
    }

    #blog-{{ section_id }}[data-bg-mode='custom'][data-bg-type='image'] {
      background-image: var(--blog-bg-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    #blog-{{ section_id }} .blog__inner {
      padding-top: var(--blog-padding-top);
      padding-bottom: var(--blog-padding-bottom);
      padding-left: var(--blog-padding-left);
      padding-right: var(--blog-padding-right);
    }

    #blog-{{ section_id }} .blog__placeholder {
      margin: 0;
    }

    /* ---------- 1. Header ---------- */

    /* The divider is a ZERO-height line sitting at the 72px mark, so it
       costs no layout there. In CSS it has to be a real 1px, which makes this
       box 73px against the frame's 72 — the declared 16px auto-layout gap is
       kept rather than shaving it to 15px to absorb the stroke. */
    #blog-{{ section_id }} .blog__header {
      padding-bottom: 16px;
      margin-bottom: var(--blog-row-gap);
      border-bottom: 1px solid var(--blog-divider-color);
    }

    #blog-{{ section_id }} .blog__heading {
      margin: 0;
      font-family: var(--font-heading--family);
      font-size: var(--blog-heading-font-size);
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0;
      text-transform: capitalize;
      white-space: nowrap;
      color: var(--blog-heading-color);
    }

    /* ---------- 2. Grid ---------- */

    #blog-{{ section_id }} .blog__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: var(--blog-row-gap);
      column-gap: var(--blog-column-gap);
    }

    /* ---------- 3. Card ---------- */

    #blog-{{ section_id }} .blog-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--blog-card-gap);
      min-width: 0;
    }

    #blog-{{ section_id }} .blog-card__media {
      position: relative;
      flex: 0 0 auto;
      width: var(--blog-image-width);
      height: var(--blog-image-height);
      overflow: hidden;
      border-radius: var(--blog-image-radius);
    }

    #blog-{{ section_id }} .blog-card__media-placeholder {
      width: 100%;
      height: 100%;
      background-color: var(--blog-image-placeholder-color);
    }

    /* No flex shorthand on the mobile (column) axis — a `flex-basis: 0` there
       sizes the HEIGHT, not the width. The row behaviour is set at ≥64rem. */
    #blog-{{ section_id }} .blog-card__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--blog-card-gap);
      width: 100%;
      min-width: 0;
    }

    #blog-{{ section_id }} .blog-card__head {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
      min-width: 0;
    }

    #blog-{{ section_id }} .blog-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      font-family: var(--font-body--family);
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0;
      white-space: nowrap;
      color: var(--blog-date-color);
    }

    #blog-{{ section_id }} .blog-card__meta-item::after {
      content: '•';
      margin-left: 0.5rem;
    }

    #blog-{{ section_id }} .blog-card__meta-item:last-child::after {
      content: '';
      margin: 0;
    }

    #blog-{{ section_id }} .blog-card__title {
      margin: 0;
      font-family: var(--font-heading--family);
      font-size: 20px;
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: 0;
      color: var(--blog-title-color);
      overflow: hidden;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: var(--blog-title-line-clamp);
    }

    /* The anchor carries the accessible name AND, through this pseudo-element,
       the whole card's hit area — so there is no empty overlay link. */
    #blog-{{ section_id }} .blog-card__title a {
      color: inherit;
      text-decoration: none;
    }

    #blog-{{ section_id }} .blog-card__title a::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    #blog-{{ section_id }} .blog-card__excerpt {
      margin: 0;
      font-family: var(--font-body--family);
      font-size: 16px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0;
      color: var(--blog-excerpt-color);
      overflow: hidden;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: var(--blog-excerpt-line-clamp);
    }

    /* ---------- 4. Pagination ---------- */

    /* Scoped here rather than retuned globally: sections/products.liquid
       already scopes the collection pager to its own treatment, and the blog
       pager differs from it on every value. */
    #blog-{{ section_id }} .pagination-nav {
      gap: 0;
      margin-top: var(--blog-pagination-offset);
      font-family: var(--font-body--family);
    }

    #blog-{{ section_id }} .pagination-nav-button {
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 8px;
      background-color: transparent;
      font-family: var(--font-body--family);
      font-size: 15px;
      font-weight: 500;
      line-height: 20px;
      color: var(--blog-pagination-inactive-color);
    }

    /* This id-scoped selector outranks the snippet's own
       `.pagination-nav-button.current-page`, so the active pill has to restate
       BOTH of its colours here or the label renders invisible on the fill. */
    #blog-{{ section_id }} .pagination-nav-button.current-page,
    #blog-{{ section_id }} .pagination-nav-button.active {
      border: 0;
      background-color: var(--blog-pagination-active-bg);
      color: var(--blog-pagination-active-color);
    }

    /* Prev and next are the only buttons carrying an svg — the numbered pages
       are `<a>` too, so the tag cannot tell them apart. */
    #blog-{{ section_id }} .pagination-nav-button:has(svg) {
      background-color: var(--blog-pagination-arrow-bg);
      color: var(--blog-pagination-inactive-color);
    }

    #blog-{{ section_id }} .pagination-nav-button svg {
      width: 24px;
      height: 24px;
    }

    #blog-{{ section_id }} .pagination-nav-button:hover {
      background-color: var(--blog-pagination-active-bg);
      color: var(--blog-pagination-active-color);
    }

    @media (width >= 64rem) {
      #blog-{{ section_id }} {
        --blog-heading-font-size: {{ section.settings.heading_font_size }};

        --blog-image-width: {{ section.settings.desktop_image_size }};
        --blog-image-height: {{ section.settings.desktop_image_size }};

        --blog-excerpt-line-clamp: {{ section.settings.desktop_excerpt_line_clamp }};

        --blog-padding-top: {{ section.settings.desktop_padding_top }}px;
        --blog-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        --blog-padding-left: {{ section.settings.desktop_padding_left }}px;
        --blog-padding-right: {{ section.settings.desktop_padding_right }}px;
      }

      #blog-{{ section_id }} .blog__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #blog-{{ section_id }} .blog-card {
        flex-direction: row;
      }

      #blog-{{ section_id }} .blog-card__body {
        flex: 1 1 auto;
      }
    }
  {%- endstyle -%}

  <div
    id="blog-{{ section_id }}"
    class="blog"
    data-bg-mode="{{ section.settings.bg_color_mode }}"
    data-bg-type="{{ section.settings.bg_type }}"
  >
    <div class="shopify-page-width shopify-page-padding">
      <div class="blog__inner">
        {%- if show_placeholder -%}
          <p class="blog__placeholder">Blog Posts — add articles to this blog to show this section</p>
        {%- else -%}
          <div class="blog__header">
            <h1 class="blog__heading">{{ heading }}</h1>
          </div>

          {%- paginate blog.articles by per_page -%}
            {%- comment -%}
              `pagination-nav` must stay INSIDE #BlogList: assets/filters.js
              calls rerenderSection(url, 'BlogList', 'elementId'), which
              replaces this element's innerHTML wholesale on every page change.
            {%- endcomment -%}
            <div id="BlogList" class="blog__list">
              <div class="blog__grid">
                {%- for article in blog.articles -%}
                  {%- render 'article',
                    article: article,
                    show_image: section.settings.show_image,
                    show_date: section.settings.show_date,
                    show_author: section.settings.show_author
                  -%}
                {%- endfor -%}
              </div>

              {%- render 'pagination-nav', paginate: paginate, pagination_nav_target_id: 'BlogList' -%}
            </div>
          {%- endpaginate -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:section.blog.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:heading.label",
      "info": "t:blog.heading.info",
      "default": "Latest Articles"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:blog.articles_per_page.label",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:article.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:author.label",
      "default": false
    },
    {
      "type": "range",
      "id": "title_line_clamp",
      "label": "t:blog.title_line_clamp.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_excerpt_line_clamp",
      "label": "t:blog.desktop_excerpt_line_clamp.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_excerpt_line_clamp",
      "label": "t:blog.mobile_excerpt_line_clamp.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:image.name"
    },
    {
      "type": "text",
      "id": "desktop_image_size",
      "label": "t:blog.desktop_image_size.label",
      "default": "208px"
    },
    {
      "type": "text",
      "id": "mobile_image_height",
      "label": "t:blog.mobile_image_height.label",
      "default": "208px"
    },
    {
      "type": "text",
      "id": "image_border_radius",
      "label": "t:size.border_radius.label",
      "default": "20px"
    },
    {
      "type": "header",
      "content": "t:typography.name"
    },
    {
      "type": "text",
      "id": "heading_font_size",
      "label": "t:typography.font_size.desktop.label",
      "default": "2.5rem"
    },
    {
      "type": "text",
      "id": "mobile_heading_font_size",
      "label": "t:typography.font_size.mobile.label",
      "default": "2.5rem"
    },
    {
      "type": "header",
      "content": "t:colors.name"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:heading.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:colors.border.label",
      "default": "#E5E7EB",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "t:date.label",
      "default": "#737373",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:title.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "t:blog.excerpt.label",
      "default": "#737373",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "t:blog.image_placeholder_color.label",
      "default": "#f5f5f5",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:colors.pagination.content"
    },
    {
      "type": "color_background",
      "id": "pagination_active_background",
      "label": "t:colors.background_color.label",
      "default": "#ff3b30",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "pagination_active_color",
      "label": "t:colors.foreground_color.label",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "pagination_inactive_color",
      "label": "t:blog.pagination_inactive_color.label",
      "default": "#111111",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "pagination_arrow_background",
      "label": "t:blog.pagination_arrow_background.label",
      "default": "#f5f5f5",
      "visible_if": "{{ section.settings.color_mode == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "bg_color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "t:background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:background_type.options.color"
        },
        {
          "value": "image",
          "label": "t:background_type.options.image"
        }
      ],
      "default": "color",
      "visible_if": "{{ section.settings.bg_color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#ffffff",
      "info": "Choose a solid background color",
      "visible_if": "{{ section.settings.bg_color_mode == 'custom' and section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:image.label",
      "info": "Choose a background image",
      "visible_if": "{{ section.settings.bg_color_mode == 'custom' and section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:layout.desktop.content"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "t:size.gap.label",
      "min": 0,
      "max": 64,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "card_row_gap",
      "label": "t:blog.row_gap.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_column_gap",
      "label": "t:blog.column_gap.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 88
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 88
    },
    {
      "type": "header",
      "content": "t:layout.mobile.content"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:size.padding.top.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:size.padding.bottom.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "label": "t:size.padding.left.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "label": "t:size.padding.right.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "t:pagination.content"
    },
    {
      "type": "range",
      "id": "pagination_offset",
      "label": "t:blog.pagination_offset.label",
      "min": 0,
      "max": 128,
      "step": 2,
      "default": 64
    }
  ]
}
{% endschema %}

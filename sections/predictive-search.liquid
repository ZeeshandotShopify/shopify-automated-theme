{% comment %}
  Predictive Search Results Section
  This section is rendered via AJAX when the user searches
{% endcomment %}

{%- liquid
  assign products_count = predictive_search.resources.products.size
  assign articles_count = predictive_search.resources.articles.size
  assign pages_count = predictive_search.resources.pages.size

  assign has_products = false
  assign has_articles = false
  assign has_pages = false
  assign has_results = false

  if products_count > 0
    assign has_products = true
    assign has_results = true
  endif

  if articles_count > 0
    assign has_articles = true
    assign has_results = true
  endif

  if pages_count > 0
    assign has_pages = true
    assign has_results = true
  endif
-%}

<style>
  .predictive-search-wrapper {
    display: flex;
    flex-direction: column;
    max-height: calc(70vh - 100px);
    position: relative;
    border-top: 1px solid var(--color-border);
  }

  .predictive-search__queries {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1rem;
  }

  .predictive-search__query {
    background-color: #e4e4e4;
    color: rgb(0 0 0 / 0.81);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem; /* 14px */
    line-height: 1.25rem; /* 20px */
    font-weight: 500;
    white-space: nowrap;
    {% comment %} border-radius: var(--button-border-radius); {% endcomment %}
    border-radius: calc(infinity * 1px);
    min-width: 3rem;
    padding-block: 0.375rem;
    padding-inline: 0.75rem;
  }

  .predictive-search__query:hover {
    opacity: 0.8;
  }

  .search-results__content {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .search-results::-webkit-scrollbar {
    width: 8px;
  }

  .search-results::-webkit-scrollbar-track {
    background: #0f172a;
  }

  .search-results::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 4px;
  }

  .search-results::-webkit-scrollbar-thumb:hover {
    background: #475569;
  }

  .search-results__section {
    margin-bottom: 1.5rem;
  }

  .search-results__section:last-of-type {
    margin-bottom: 4rem;
  }

  .search-results__heading {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  /* Product Results Grid */
  .search-results__products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  /* Article & Page Results List */
  .search-results__articles,
  .search-results__pages {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Search Result Item */
  .search-result-item {
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    transition: background-color 0.2s;
    border-radius: 8px;
  }

  /* Product Items */
  .search-result-item--product {
    flex-direction: column;
    padding: 0;
  }

  .search-result-item--product:hover {
    background-color: var(--color-muted-background);
    color: var(--color-muted-foreground);
    padding: 0.375rem;
    margin: -0.375rem;
    border-radius: var(--image-border-radius);
  }

  .search-result-item__image {
    background-color: var(--color-muted-background);
    position: relative;
    overflow: hidden;
  }

  .search-result-item__image img {
    aspect-ratio: 4 / 5;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--image-border-radius) / 2);
    object-fit: cover;
    object-position: 50% 50%;
    transition: opacity 0.3s ease;
  }

  .product-image-secondary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none; /* Prevents interference with Pinterest button */
  }

  .search-result-item--product:hover .product-image-secondary {
    opacity: 1;
  }

  .search-result-item__image--small {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    aspect-ratio: 1;
  }

  .search-result-item__image--small img {
    aspect-ratio: 1;
  }

  .search-result-item__details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .search-result-item__title {
    font-size: 0.875rem;
    line-height: 1.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .search-result-item__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .search-result-item__price--sale {
    color: #ef4444;
  }

  .search-result-item__price--compare {
    text-decoration: line-through;
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .search-result-item__excerpt {
    font-size: 13px;
    margin: 4px 0 0 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.5;
  }

  /* Article & Page Items */
  .search-result-item--article,
  .search-result-item--page {
    padding: 12px;
  }

  /* Footer */
  .search-results__footer {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(0deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    padding: 1rem;
    width: 100%;
  }

  .search-results__view-all {
    display: inline-block;
    padding: 10px 24px;
    background-color: var(--color-primary-background);
    color: var(--color-primary-foreground);
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .search-results__view-all:hover {
    background-color: var(--color-primary-hover-background);
    color: var(--color-primary-hover-foreground);
    transform: translateY(-0.25rem);
  }

  @media(width >= 64rem) {
    .search-results__products {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<div data-has-results="{{ has_results }}" class="predictive-search-wrapper">
  <ul class="predictive-search__queries">
    {%- for query in predictive_search.resources.queries -%}
      <li class="predictive-search__query">
        <a href="{{ query.url }}">
          {{ query.text }}
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {%- if predictive_search.performed -%}
    {%- if has_results -%}
      <div class="search-results__content">
        {%- comment -%} Products Section {%- endcomment -%}
        {%- if has_products -%}
          <div class="search-results__section">
            <h3 class="search-results__heading">Products</h3>
            <div class="search-results__products">
              {%- for product in predictive_search.resources.products -%}
                <a href="{{ product.url }}" class="search-result-item search-result-item--product">
                  {%- if product.featured_image -%}
                    <div class="search-result-item__image">
                      {{-
                        product.featured_image
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', alt: product.title, class: 'product-image-primary'
                      -}}

                      {%- if product.images[1] != blank -%}
                        <div class="product-image-secondary">
                          {{-
                            product.images[1]
                            | image_url: width: 400
                            | image_tag: loading: 'lazy', alt: product.title
                          -}}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <div class="search-result-item__details">
                    <h4 class="search-result-item__title">{{ product.title }}</h4>
                    <div class="search-result-item__price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="search-result-item__price--sale">{{ product.price | money }}</span>
                        <s class="search-result-item__price--compare">{{ product.compare_at_price | money }}</s>
                      {%- else -%}
                        <span class="search-result-item__price--regular">{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Articles Section {%- endcomment -%}
        {%- if has_articles -%}
          <div class="search-results__section">
            <h3 class="search-results__heading">Articles</h3>
            <div class="search-results__articles">
              {%- for article in predictive_search.resources.articles -%}
                <a href="{{ article.url }}" class="search-result-item search-result-item--article">
                  {%- if article.image -%}
                    <div class="search-result-item__image search-result-item__image--small">
                      {{- article.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: article.title -}}
                    </div>
                  {%- endif -%}
                  <div class="search-result-item__details">
                    <h4 class="search-result-item__title">{{ article.title }}</h4>
                    {%- if article.excerpt != blank -%}
                      <p class="search-result-item__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
                    {%- endif -%}
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Pages Section {%- endcomment -%}
        {%- if has_pages -%}
          <div class="search-results__section">
            <h3 class="search-results__heading">Pages</h3>
            <div class="search-results__pages">
              {%- for page in predictive_search.resources.pages -%}
                <a href="{{ page.url }}" class="search-result-item search-result-item--page">
                  <div class="search-result-item__details">
                    <h4 class="search-result-item__title">{{ page.title }}</h4>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} View All Link with Shadow {%- endcomment -%}
      {% comment %}
        <div class="search-results__footer">
          <a href="{{ predictive_search.resources.url }}" class="search-results__view-all">
            View all
          </a>
        </div>
      {% endcomment %}
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Display Recent View or Some Products has limit at least 4 {%- endcomment -%}
  {%- endif -%}
</div>

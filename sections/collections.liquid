<style>
  #{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#ffffff' }};

    --desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --desktop-padding-left: {{ section.settings.desktop_padding_left }}px;
    --desktop-padding-right: {{ section.settings.desktop_padding_right }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --mobile-padding-left: {{ section.settings.mobile_padding_left }}px;
    --mobile-padding-right: {{ section.settings.mobile_padding_right }}px;
    --desktop-grid-gap: {{ section.settings.desktop_grid_gap }};
    --mobile-grid-gap: {{ section.settings.mobile_grid_gap }};
    --desktop-gap: {{ section.settings.desktop_gap }};
    --mobile-gap: {{ section.settings.mobile_gap }};
    --grid-columns-desktop: repeat({{ section.settings.desktop_grid_columns }}, minmax(0, 1fr));
    --grid-columns-mobile: repeat({{ section.settings.mobile_grid_columns }}, minmax(0, 1fr));
  }

  #{{ section.id }}.collections-bg {
    {%- if section.settings.bg_color_mode == 'custom' -%}
      background: var(--bg-color);
    {%- else -%}
      background: var(--color-background);
    {%- endif -%}
  }

  .collections-inner {
    display: grid;
    gap: var(--mobile-gap);
    padding: var(--mobile-padding-top) var(--mobile-padding-right) var(--mobile-padding-bottom) var(--mobile-padding-left);
  }

  .collections-grid {
    display: grid;
    width: 100%;
    gap: var(--mobile-grid-gap);
    grid-template-columns: var(--grid-columns-mobile);
  }

  @media (width >= 64rem) {
    .collections-inner {
      gap: var(--desktop-gap);
      padding: var(--desktop-padding-top) var(--desktop-padding-right) var(--desktop-padding-bottom) var(--desktop-padding-left);
    }

    .collections-grid {
      gap: var(--desktop-grid-gap);
      grid-template-columns: var(--grid-columns-desktop);
    }
  }
</style>

<div
  id="{{ section.id }}"
  class="collections-bg"
>
  <div class="shopify-page-width shopify-page-padding">
    <div class="collections-inner">
      <div
        class="collections-grid"
      >
        {% for collection in collections %}
          {% render 'collection-card', collection: collection, icon_mode: 'none' %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>


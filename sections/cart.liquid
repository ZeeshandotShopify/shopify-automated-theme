<style>
  .cart-section {
    display: flex;
    flex-direction: column;
  }

  .cart-section__content {
    flex: 1 1 0%;
    overflow-y: auto;
  }

  .cart-section__content .cart__item-content {
    gap: 1rem;
  }

  .cart-section__footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    align-self: flex-end;
  }

  .cart-section__footer .cart__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .cart-section__footer .cart-total {
    font-weight: 700;
    color: var(--color-price-foreground);
  }

  /* Empty cart state */
  .cart-section__content:has(.cart-empty) {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  /* Loading state */

  .cart-section.is-loading {
    pointer-events: none;
    opacity: 0.7;
  }
</style>

<form id="cart-drawer-checkout-form" action="{{ routes.cart_url }}" method="post" class="cart-drawer-form">
  <custom-cart data-cart-type="page" data-section-id="{{ section.id }}">
    <div class="shopify-page-width shopify-page-padding">
      <div class="cart-section gap-4 pt-16 pb-16 pl-4 pr-4 lg:gap-10 lg:pl-16 lg:pr-16 lg:pt-24 lg:pb-24">
        <h2 class="text-2xl font-bold">{{ 'cart.title' | t }}</h2>
        <div class="cart-section__content">
          {% if cart.item_count > 0 %}
            {% for item in cart.items %}
              {% render 'cart-item', item: item, line: forloop.index %}
            {% endfor %}
          {% else %}
            <div class="flex flex-col items-center justify-center h-full">
              {% render 'cart-empty' %}
            </div>
          {% endif %}
        </div>
        {% if cart.item_count > 0 %}
          <div class="cart-section__footer">
            {% assign original_total = 0 %}
            {% assign compare_at_total = 0 %}

            {% for item in cart.items %}
              {% assign item_compare_at_unit = item.variant.compare_at_price | default: item.original_price %}
              {% assign item_compare_at_line = item_compare_at_unit | times: item.quantity %}

              {% comment %} We use final_line_price instead of original_line_price because we also need the total price with discount applied {% endcomment %}
              {% assign original_total = original_total | plus: item.final_line_price %}
              {% assign compare_at_total = compare_at_total | plus: item_compare_at_line %}

              {% comment %} Check if any item has compare at price {% endcomment %}
              {% if item.variant.compare_at_price and item.variant.compare_at_price > 0 %}
                {% assign has_compare_at_prices = true %}
              {% endif %}
            {% endfor %}

            <div class="cart__summary">
              <div class="text-sm">
                <span class="font-bold">Total</span>
                <span>(exl. shipping and tax)</span>
              </div>
              <div class="flex items-center text-sm gap-0.5">
                {% if has_compare_at_prices %}
                  <span>
                    {{ original_total | money }}
                  </span>
                  <span>
                    <s>{{ compare_at_total | money }}</s>
                  </span>
                {% else %}
                  <span style="font-weight: 700;">
                    {{ original_total | money }}
                  </span>
                {% endif %}
              </div>
            </div>

            {% render 'button',
              label: 'Checkout',
              type: 'submit',
              full_width: true,
              name: 'checkout',
              icon_mode: 'select',
              icon_select: 'lock',
              attributes: "form='cart-drawer-checkout-form'"
            %}

            {% render 'payment-type' %}
          </div>
        {% endif %}
      </div>
    </div>
  </custom-cart>
</form>

{% schema %}
{
  "name": "t:section.cart.name",
  "enabled_on": {
    "templates": ["cart"]
  },
  "tag": "section",
  "settings": []
}
{% endschema %}

{%- assign product = block.settings.product -%}
{%- assign position_x = block.settings.position_x -%}
{%- assign position_y = block.settings.position_y -%}
{%- assign position_x_desktop = block.settings.position_x_desktop -%}
{%- assign position_y_desktop = block.settings.position_y_desktop -%}

{%- style -%}
  #hotspot-point-{{ block.id }} {
    --left: {{ position_x }}%;
    --top: {{ position_y }}%;
    --left-desktop: {{ position_x_desktop }}%;
    --top-desktop: {{ position_y_desktop }}%;

    position: absolute;
    top: var(--top);
    left: var(--left);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .hotspot-point {
    width: 1.5rem;
    height: 1.5rem;
    background: transparent;
    border: 8px solid var(--color-background);
    border-radius: 100%;
    cursor: pointer;
    z-index: 10;
  }

  /* Shared styles for the rings */
  .hotspot-point::before,
  .hotspot-point::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-background);
    border-radius: 100%;
    z-index: -1;
    pointer-events: none; /* Ensures rings don't block clicks */
  }

  /* First Ring */
  .hotspot-point::before {
    animation: pulse 2s infinite ease-out;
  }

  /* Second Ring (Delayed) */
  .hotspot-point::after {
    animation: pulse 2s infinite ease-out;
    animation-delay: 1s; /* The delay creates the double ripple */
  }

  @keyframes pulse {
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  /* --- Card Arrow Styling Below */
  .hotspot-arrow {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: 0;
    height: 0;
    border-width: 0 11px 10px 11px;
    border-color: transparent transparent var(--color-background) transparent;
    border-style: solid;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
    pointer-events: none;
    transition: all .25s cubic-bezier(.104,.204,.492,1);
  }

  .hotspot-arrow::before {
    content: "";
    display: block;
    position: absolute;
    top: -11px;
    left: -26px;
    width: 52px;
    height: 22px;
  }

  #hotspot-point-{{ block.id }}:hover .hotspot-arrow {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  /* --- Card Styling Below --- */
  .hotspot-card {
    font-family: var(--font-body--family);
    position: absolute;
    top: calc(100% + 20px);
    left: 50%;
    padding: 1rem;
    background: var(--color-background);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    display: flex;
    width: max-content;
    max-width: 325px;
    align-items: center;
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
    pointer-events: none;
    transition: all .25s cubic-bezier(.104,.204,.492,1);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  }

  #hotspot-point-{{ block.id }}:hover .hotspot-card {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .hotspot-card-image {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 0.5rem;
  }


  .hotspot-card-title {
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.25rem;
  }

  .hotspot-card-price {
    font-size: 0.875rem;
    line-height: calc(1.25 / 0.875);
    margin-bottom: 0.25rem;
  }

  .hotspot-card-link {
    position: relative;
    font-size: 0.875rem;
    line-height: 140%;
  }

  .hotspot-card-link::before,
  .hotspot-card-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    bottom: 0;
    pointer-events: none;
  }

  .hotspot-card-link::before {
    background: var(--color-foreground);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 360ms cubic-bezier(.2,.9,.2,1);
    z-index: 2;
    will-change: transform;
  }

  .hotspot-card-link::after {
    background: var(--color-foreground);
    opacity: 0.25;
    z-index: 1;
  }

  .hotspot-card-link:hover::before,
  .hotspot-card-link:focus::before{
    transform: scaleX(1);
  }

  @media (width >= 64rem) {
    #hotspot-point-{{ block.id }} {
      top: var(--top-desktop);
      left: var(--left-desktop);
    }
  }
{%- endstyle -%}

<div id="hotspot-point-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="hotspot-point">
    <div class="hotspot-arrow"></div>

    <div class="hotspot-card">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 160
          | image_tag: class: 'hotspot-card-image', loading: 'lazy', alt: product.title
          | escape
        }}
      {%- endif -%}

      <div class="hotspot-card-details">
        <h3 class="hotspot-card-title">{{- product.title -}}</h3>

        <p class="hotspot-card-price">
          {{- product.price | money -}}
        </p>

        <a href="{{ product.url }}" class="hotspot-card-link">
          {{- block.settings.link_text | default: 'View Product' -}}
        </a>
      </div>
    </div>
  </div>
</div>

{%- schema -%}
{
  "name": "Product Point",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select the product to feature at this hotspot"
    },
    {
      "type": "header",
      "content": "Position - Desktop"
    },
    {
      "type": "range",
      "id": "position_x_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal Position (X)",
      "default": 50,
      "info": "0% = left edge, 50% = center, 100% = right edge"
    },
    {
      "type": "range",
      "id": "position_y_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical Position (Y)",
      "default": 50,
      "info": "0% = top edge, 50% = middle, 100% = bottom edge"
    },
    {
      "type": "header",
      "content": "Position - Mobile"
    },
    {
      "type": "range",
      "id": "position_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal Position (X)",
      "default": 50,
      "info": "0% = left edge, 50% = center, 100% = right edge"
    },
    {
      "type": "range",
      "id": "position_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical Position (Y)",
      "default": 50,
      "info": "0% = top edge, 50% = middle, 100% = bottom edge"
    }
  ],
  "presets": [
    {
      "name": "Product Point"
    }
  ]
}
{%- endschema -%}

      "label": "Field Horizontal Padding",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.field_style_mode == 'custom' }}"
    },
    {
      "type": "text",
      "id": "input_font_size",

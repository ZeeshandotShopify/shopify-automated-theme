{%- liquid
  assign text = block.settings.text | default: ''
  assign highlight_text = block.settings.highlight_text | default: ''

  assign text_color_mode = block.settings.text_color_mode | default: 'inherit'

  if text_color_mode == 'inherit'
    assign text_color = 'var(--color-foreground)'
    assign highlight_color = 'var(--color-primary-background)'
  else
    assign text_color = block.settings.text_color | default: '#111111'
    assign highlight_color = block.settings.highlight_color | default: '#FF0000'
  endif

  assign font_family = block.settings.font_family | default: 'var(--font-body--family)'
  assign font_weight = block.settings.font_weight | default: '400'
  assign mobile_font_size = block.settings.mobile_font_size | default: '1rem'
  assign mobile_line_height = block.settings.mobile_line_height | default: 'calc(1.5 / 1)'
  assign text_transform = block.settings.text_transform | default: 'none'
  assign mobile_width = block.settings.mobile_width | default: '100%'
  assign mobile_max_width = block.settings.mobile_max_width | default: '42rem'
  assign mobile_text_align = block.settings.mobile_text_align | default: 'center'

  assign desktop_font_size = block.settings.desktop_font_size | default: '1.25rem'
  assign desktop_line_height = block.settings.desktop_line_height | default: 'calc(1.75 / 1.25)'
  assign desktop_width = block.settings.desktop_width | default: '100%'
  assign desktop_max_width = block.settings.desktop_max_width | default: '42rem'
  assign desktop_text_align = block.settings.desktop_text_align | default: 'center'
%}

{%- if text != blank and highlight_text != blank -%}
  {%- style -%}
    #highlight-text-{{ block.id }} {
      --text-color: {{ text_color }};
      --highlight-color: {{ highlight_color }};
      --font-family: {{ font_family }};
      --font-weight: {{ font_weight }};
      --font-size: {{ mobile_font_size }};
      --line-height: {{ mobile_line_height }};
      --text-transform: {{ text_transform }};
      --width: {{ mobile_width }};
      --max-width: {{ mobile_max_width }};
      --text-align: {{ mobile_text_align }};

      font-family: var(--font-family);
      font-weight: var(--font-weight);
      font-size: var(--font-size);
      line-height: var(--line-height);
      text-transform: var(--text-transform);
      width: var(--width);
      max-width: var(--max-width);
      text-align: var(--text-align);
    }

    #highlight-text-{{ block.id }} p {
      color: var(--text-color);
    }

    #highlight-text-{{ block.id }} span {
      color: var(--highlight-color);
    }

    @media (width >= 64rem) {
      #highlight-text-{{ block.id }} {
        --font-size: {{ desktop_font_size }};
        --line-height: {{ desktop_line_height }};
        --width: {{ desktop_width }};
        --max-width: {{ desktop_max_width }};
        --text-align: {{ desktop_text_align }};

        font-size: var(--font-size);
        line-height: var(--line-height);
        width: var(--width);
        max-width: var(--max-width);
        text-align: var(--text-align);
      }
    }
  {%- endstyle -%}

  <div id="highlight-text-{{ block.id }}" {{ block.shopify_attributes }}>
    <p>
      {{ text }}
      <span>{{ highlight_text }}</span>
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:block.highlight_text.name",
  // This will prevent add extra div element wrapper
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "text_color_mode",
      "label": "t:color_mode.label",
      "options": [
        { "value": "inherit", "label": "t:color_mode.options.inherit" },
        { "value": "custom", "label": "t:color_mode.options.custom" }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:colors.foreground_color.label",
      "default": "#111111",
      "visible_if": "{{ block.settings.text_color_mode == 'custom' }}"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Foreground Color",
      "default": "#FF0000",
      "visible_if": "{{ block.settings.text_color_mode == 'custom' }}"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:text.label",
      "default": "This is an example text. You can edit or replace it with your own content."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "This is an example text. You can edit or replace it with your own content."
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "t:typography.font_family.label",
      "options": [
        { "value": "var(--font-body--family)", "label": "t:typography.font_family.options.body" },
        { "value": "var(--font-heading--family)", "label": "t:typography.font_family.options.heading" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "t:typography.font_weight.label",
      "options": [
        { "value": "100", "label": "t:typography.font_weight.options.thin" },
        { "value": "200", "label": "t:typography.font_weight.options.extra_light" },
        { "value": "300", "label": "t:typography.font_weight.options.light" },
        { "value": "400", "label": "t:typography.font_weight.options.regular" },
        { "value": "500", "label": "t:typography.font_weight.options.medium" },
        { "value": "600", "label": "t:typography.font_weight.options.semibold" },
        { "value": "700", "label": "t:typography.font_weight.options.bold" },
        { "value": "800", "label": "t:typography.font_weight.options.extra_bold" },
        { "value": "900", "label": "t:typography.font_weight.options.black" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "t:typography.text_transform.label",
      "options": [
        { "value": "none", "label": "t:typography.text_transform.options.normal" },
        { "value": "lowercase", "label": "t:typography.text_transform.options.lowercase" },
        { "value": "uppercase", "label": "t:typography.text_transform.options.uppercase" },
        { "value": "capitalize", "label": "t:typography.text_transform.options.capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:size.desktop.content"
    },
    {
      "type": "text",
      "id": "desktop_font_size",
      "label": "t:typography.font_size.desktop.label",
      "placeholder": "px, rem, etc.",
      "default": "1.25rem"
    },
    {
      "type": "text",
      "id": "desktop_line_height",
      "label": "t:typography.line_height.desktop.label",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "calc(1.75 / 1.25)"
    },
    {
      "type": "select",
      "id": "desktop_width",
      "label": "t:size.width.label",
      "options": [
        { "value": "fit-content", "label": "t:size.options.fit" },
        { "value": "100%", "label": "t:size.options.fill" }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "desktop_max_width",
      "label": "t:size.max_width.label",
      "options": [
        {
          "value": "32rem",
          "label": "t:size.options.narrow"
        },
        {
          "value": "42rem",
          "label": "t:size.options.normal"
        },
        {
          "value": "none",
          "label": "t:size.options.none"
        }
      ],
      "default": "42rem",
      "visible_if": "{{ block.settings.desktop_width == '100%' }}"
    },
    {
      "type": "select",
      "id": "desktop_text_align",
      "label": "t:layout.alignment.label",
      "options": [
        { "value": "left", "label": "t:layout.alignment.options.left" },
        { "value": "center", "label": "t:layout.alignment.options.center" },
        { "value": "right", "label": "t:layout.alignment.options.right" }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.desktop_width == '100%' }}"
    },
    {
      "type": "header",
      "content": "t:size.mobile.content"
    },
    {
      "type": "text",
      "id": "mobile_font_size",
      "label": "t:typography.font_size.mobile.label",
      "placeholder": "px, rem, etc.",
      "default": "1rem"
    },
    {
      "type": "text",
      "id": "mobile_line_height",
      "label": "t:typography.line_height.mobile.label",
      "placeholder": "px, rem, %, calc, etc.",
      "default": "calc(1.5 / 1)"
    },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "t:size.width.label",
      "options": [
        { "value": "fit-content", "label": "t:size.options.fit" },
        { "value": "100%", "label": "t:size.options.fill" }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "mobile_max_width",
      "label": "t:size.max_width.label",
      "options": [
        {
          "value": "32rem",
          "label": "t:size.options.narrow"
        },
        {
          "value": "42rem",
          "label": "t:size.options.normal"
        },
        {
          "value": "none",
          "label": "t:size.options.none"
        }
      ],
      "default": "42rem",
      "visible_if": "{{ block.settings.mobile_width == '100%' }}"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "t:layout.alignment.label",
      "options": [
        { "value": "left", "label": "t:layout.alignment.options.left" },
        { "value": "center", "label": "t:layout.alignment.options.center" },
        { "value": "right", "label": "t:layout.alignment.options.right" }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.mobile_width == '100%' }}"
    }
  ],
  "presets": [
    {
      "name": "t:block.highlight_text.name",
      "category": "t:block.text.category"
    }
  ]
}
{% endschema %}

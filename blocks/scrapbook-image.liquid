{%- liquid
  assign block_id = block.id
  assign image_id = 'scrapbook-image-' | append: block_id
  assign image = block.settings.image
  assign link = block.settings.link

  comment
    Position settings
  endcomment
  assign mobile_top = block.settings.mobile_top | default: '20%'
  assign mobile_left = block.settings.mobile_left | default: '30%'
  assign mobile_rotation = block.settings.mobile_rotation | default: 0

  assign desktop_top = block.settings.desktop_top | default: '20%'
  assign desktop_left = block.settings.desktop_left | default: '30%'
  assign desktop_rotation = block.settings.desktop_rotation | default: 0
-%}

{%- style -%}
  #{{ image_id }} {
    --top: {{ mobile_top }};
    --left: {{ mobile_left }};
    --rotation: {{ mobile_rotation }}deg;

    /* Mobile-first positioning */
    position: absolute;
    top: var(--top);
    left: var(--left);
    transform: translate(-50%, -50%) rotate(var(--rotation));
  }

  /* Hover effect - tilt +3deg */
  #{{ image_id }}:hover {
    transform: translate(-50%, -50%) rotate(calc(var(--rotation) + 3deg));
  }

  @media (width >= 64rem) {
    #{{ image_id }} {
      --top: {{ desktop_top }};
      --left: {{ desktop_left }};
      --rotation: {{ desktop_rotation }}deg;

      top: var(--top);
      left: var(--left);
      transform: translate(-50%, -50%) rotate(var(--rotation));
    }

    /* Desktop hover effect */
    #{{ image_id }}:hover {
      transform: translate(-50%, -50%) rotate(calc(var(--rotation) + 3deg));
    }
  }
{%- endstyle -%}

<div
  id="{{ image_id }}"
  class="scrapbook-image-wrapper"
  {{ block.shopify_attributes }}
>
  {%- if link != blank -%}
    <a href="{{ link }}" class="scrapbook-image-link">
  {%- endif -%}

  <div class="scrapbook-image-frame">
    {% render 'responsive-image',
      image: image,
      enable_mobile_size: block.settings.enable_mobile_size,
      mobile_aspect_ratio: block.settings.mobile_aspect_ratio,
      mobile_enable_custom_dimension: block.settings.mobile_enable_custom_dimension,
      mobile_custom_width: block.settings.mobile_custom_width,
      mobile_custom_height: block.settings.mobile_custom_height,
      desktop_aspect_ratio: block.settings.desktop_aspect_ratio,
      desktop_enable_custom_dimension: block.settings.desktop_enable_custom_dimension,
      desktop_custom_width: block.settings.desktop_custom_width,
      desktop_custom_height: block.settings.desktop_custom_height,
      border_mode: 'custom'
    %}
  </div>

  {%- if link != blank -%}
    </a>
  {%- endif -%}
</div>

{%- schema -%}
{
  "name": "Scrapbook Image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Desktop Position"
    },
    {
      "type": "text",
      "id": "desktop_top",
      "label": "Top Position",
      "placeholder": "e.g., 20%, 100px",
      "default": "20%",
      "info": "Distance from top (center point)"
    },
    {
      "type": "text",
      "id": "desktop_left",
      "label": "Left Position",
      "placeholder": "e.g., 30%, 150px",
      "default": "30%",
      "info": "Distance from left (center point)"
    },
    {
      "type": "range",
      "id": "desktop_rotation",
      "label": "Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": 0,
      "unit": "deg"
    },
    {
      "type": "header",
      "content": "Mobile Position"
    },
    {
      "type": "text",
      "id": "mobile_top",
      "label": "Top Position",
      "placeholder": "e.g., 20%, 100px",
      "default": "20%",
      "info": "Distance from top (center point)"
    },
    {
      "type": "text",
      "id": "mobile_left",
      "label": "Left Position",
      "placeholder": "e.g., 30%, 150px",
      "default": "30%",
      "info": "Distance from left (center point)"
    },
    {
      "type": "range",
      "id": "mobile_rotation",
      "label": "Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": 0,
      "unit": "deg"
    },
    {
      "type": "header",
      "content": "t:size.desktop.content"
    },
    {
      "type": "select",
      "id": "desktop_aspect_ratio",
      "label": "t:aspect_ratio.label",
      "options": [
        { "label": "t:aspect_ratio.options.unset", "value": "unset" },
        { "label": "t:aspect_ratio.options.adapt", "value": "auto" },
        { "label": "16:9 (Widescreen)", "value": "16 / 9" },
        { "label": "4:3 (Standard)", "value": "4 / 3" },
        { "label": "1:1 (Square)", "value": "1 / 1" },
        { "label": "9:16 (Vertical)", "value": "9 / 16" },
        { "label": "21:9 (Cinematic)", "value": "21 / 9" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "desktop_enable_custom_dimension",
      "label": "Enable Custom Dimension"
    },
    {
      "type": "text",
      "id": "desktop_custom_width",
      "label": "Width",
      "placeholder": "px, rem, %, etc.",
      "default": "600px",
      "visible_if": "{{ block.settings.desktop_enable_custom_dimension }}"
    },
    {
      "type": "text",
      "id": "desktop_custom_height",
      "label": "Height",
      "placeholder": "px, rem, %, etc.",
      "default": "400px",
      "visible_if": "{{ block.settings.desktop_enable_custom_dimension }}"
    },
    {
      "type": "header",
      "content": "t:size.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_size",
      "label": "Enable Mobile Size"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        { "label": "t:aspect_ratio.options.unset", "value": "unset" },
        { "label": "t:aspect_ratio.options.adapt", "value": "auto" },
        { "value": "16 / 9", "label": "16:9 (Widescreen)" },
        { "value": "4 / 3", "label": "4:3 (Standard)" },
        { "value": "1 / 1", "label": "1:1 (Square)" },
        { "value": "9 / 16", "label": "9:16 (Vertical)" },
        { "value": "21 / 9", "label": "21:9 (Cinematic)" }
      ],
      "default": "1 / 1",
      "visible_if": "{{ block.settings.enable_mobile_size }}"
    },
    {
      "type": "checkbox",
      "id": "mobile_enable_custom_dimension",
      "label": "Enable Custom Dimension"
    },
    {
      "type": "text",
      "id": "mobile_custom_width",
      "label": "Width",
      "placeholder": "px, rem, %, etc.",
      "default": "600px",
      "visible_if": "{{ block.settings.enable_mobile_size and block.settings.mobile_enable_custom_dimension }}"
    },
    {
      "type": "text",
      "id": "mobile_custom_height",
      "label": "Height",
      "placeholder": "px, rem, %, etc.",
      "default": "400px",
      "visible_if": "{{ block.settings.enable_mobile_size and block.settings.mobile_enable_custom_dimension }}"
    }
  ],
  "presets": [
    {
      "name": "Scrapbook Image"
    }
  ]
}
{%- endschema -%}

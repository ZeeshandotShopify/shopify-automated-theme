{% comment %}
  Group - Without Grid Settings

  We will use the grid's default settings,
  which stretch each grid item to fill both its width and height.
{% endcomment %}

{%- liquid
  # Background image detection
  assign has_bg_image = false
  if block.settings.bg_type == 'image' and block.settings.bg_image != blank
    assign has_bg_image = true
  endif
-%}

<style>
  #{{ block.id }} {
    --bg-color: {{ block.settings.bg_color | default: '#ffffff' }};
    --overlay-color: {{ block.settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};

    --gap: {{ block.settings.mobile_gap }};


    /* Padding Variables */
    --padding-top: {{ block.settings.mobile_padding_top }}px;
    --padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
    --padding-left: {{ block.settings.mobile_padding_left }}px;
    --padding-right: {{ block.settings.mobile_padding_right }}px;

    /* Border Variables */
    --border-thickness: {{ block.settings.border_thickness }}px;
    --border-top-thickness: {{ block.settings.border_top_thickness }}px;
    --border-bottom-thickness: {{ block.settings.border_bottom_thickness }}px;
    --border-left-thickness: {{ block.settings.border_left_thickness }}px;
    --border-right-thickness: {{ block.settings.border_right_thickness }}px;

    --border-radius: {{ block.settings.border_radius }};
    --border-radius-top-left: {{ block.settings.border_radius_top_left }};
    --border-radius-top-right: {{ block.settings.border_radius_top_right }};
    --border-radius-bottom-left: {{ block.settings.border_radius_bottom_left }};
    --border-radius-bottom-right: {{ block.settings.border_radius_bottom_right }};

    /* Direction Variables */
    {%- if block.settings.display_type == 'flex' -%}
      --direction: {{  block.settings.mobile_direction }};
    {%- endif -%}

    /* Grid Variables */
    {%- if block.settings.display_type == 'grid' -%}
      --grid-columns: {{ block.settings.mobile_grid_columns | default: 1 }};
    {%- endif -%}

    /* Alignment Variables */
    {% if block.settings.display_type == 'flex' %}
      {%- case block.settings.mobile_direction -%}
        {%- when 'row' -%}
          --align-items: {{ block.settings.mobile_row_align_items }};
          --justify-content: {{ block.settings.mobile_row_justify_content }};
        {%- when 'column' -%}
          --align-items: {{ block.settings.mobile_column_align_items }};
          --justify-content: {{ block.settings.mobile_column_justify_content }};
      {%- endcase -%}
    {% endif %}

    /* Width and Height Variables */
    --width: {% case block.settings.mobile_width %}{% when 'auto' %}auto{% when 'fill' %}100%{% when 'custom' %}{{ block.settings.mobile_custom_width }}{% endcase %};
    --height: {% case block.settings.mobile_height %}{% when 'auto' %}auto{% when 'fill' %}100%{% when 'custom' %}{{ block.settings.mobile_custom_height }}{% endcase %};

    position: relative;
    {%- case block.settings.bg_type -%}
      {%- when 'color' -%}
        background: var(--bg-color);
      {%- when 'image' -%}
        background-image: url('{{ block.settings.bg_image | image_url: width: 3840 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    {%- endcase -%}
    {%- case block.settings.border_type -%}
      {%- when 'default' -%}
        border: var(--border-thickness, 1px) solid var(--color-border, #e5e5e5);
        border-radius: var(--border-radius, 0.5rem);
      {%- when 'custom' -%}
        border-top: var(--border-top-thickness, 1px) solid var(--color-border, #e5e5e5);
        border-bottom: var(--border-bottom-thickness, 1px) solid var(--color-border, #e5e5e5);
        border-left: var(--border-left-thickness, 1px) solid var(--color-border, #e5e5e5);
        border-right: var(--border-right-thickness, 1px) solid var(--color-border, #e5e5e5);
        border-top-left-radius: var(--border-radius-top-left, 0.5rem);
        border-top-right-radius: var(--border-radius-top-right, 0.5rem);
        border-bottom-left-radius: var(--border-radius-bottom-left, 0.5rem);
        border-bottom-right-radius: var(--border-radius-bottom-right, 0.5rem);
    {%- endcase -%}

    width: var(--width);
    height: var(--height);

    /* Flex item sizing */
    {%- if block.settings.display_type == 'flex' -%}
      {%- if block.settings.mobile_direction == 'row' and block.settings.mobile_width == 'fill' -%}
        flex: var(--ch-grow, 1) 1 0; /* fill: grow to share width only when the parent is a row (--ch-grow from .group-container); prevents vertical balloon in a column parent */
        min-width: 0;
      {%- elsif block.settings.mobile_width == 'custom' -%}
        flex: none; /* respect the custom width, don't grow or shrink */
      {%- endif -%}
    {%- endif -%}

    /* Mobile order - only applied if enabled */
    {%- if block.settings.mobile_display_order -%}
      order: {{ block.settings.display_order }};
    {%- else -%}
      order: initial;
    {%- endif -%}
  }

  #{{ block.id }} .group-bg__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  #{{ block.id }} .group-container {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 1;
    /* Publish whether THIS container is a flex row (1) or not (0), so a width:fill child grows horizontally only inside a row — never balloons vertically in a column parent. */
    --ch-grow: {% if block.settings.display_type == 'flex' and block.settings.mobile_direction == 'row' %}1{% else %}0{% endif %};
    {%- if block.settings.display_type == 'grid' -%}
      /* Grid Layout */
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    {%- else -%}
      /* Flex Layout */
      display: flex;
      flex-direction: var(--direction);
      align-items: var(--align-items);
      justify-content: var(--justify-content);
    {%- endif -%}
    gap: var(--gap);
    padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left);
  }

  @media (width >= 64rem) {
    #{{ block.id }} {
      --gap: {{ block.settings.desktop_gap }};

      /* Padding Variables */
      --padding-top: {{ block.settings.desktop_padding_top }}px;
      --padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
      --padding-left: {{ block.settings.desktop_padding_left }}px;
      --padding-right: {{ block.settings.desktop_padding_right }}px;

      /* Direction Variables */
      {%- if block.settings.display_type == 'flex' -%}
        --direction: {{ block.settings.desktop_direction }};
      {%- endif -%}

      /* Grid Variables */
      {%- if block.settings.display_type == 'grid' -%}
        --grid-columns: {{ block.settings.desktop_grid_columns | default: 2 }};
      {%- endif -%}

      /* Alignment Variables */
      {% if block.settings.display_type == 'flex' %}
        {%- case block.settings.desktop_direction -%}
          {%- when 'row' -%}
            --align-items: {{ block.settings.desktop_row_align_items }};
            --justify-content: {{ block.settings.desktop_row_justify_content }};
          {%- when 'column' -%}
            --align-items: {{ block.settings.desktop_column_align_items }};
            --justify-content: {{ block.settings.desktop_column_justify_content }};
        {%- endcase -%}
      {% endif %}

      /* Width and Height Variables */
      --width: {% case block.settings.desktop_width %}{% when 'auto' %}auto{% when 'fill' %}100%{% when 'custom' %}{{ block.settings.desktop_custom_width }}{% endcase %};
      --height: {% case block.settings.desktop_height %}{% when 'auto' %}auto{% when 'fill' %}100%{% when 'custom' %}{{ block.settings.desktop_custom_height }}{% endcase %};

      position: relative;
      {%- case block.settings.bg_type -%}
        {%- when 'color' -%}
          background: var(--bg-color);
        {%- when 'image' -%}
          background-image: url('{{ block.settings.bg_image | image_url: width: 3840 }}');
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
      {%- endcase -%}
      {%- case block.settings.border_type -%}
        {%- when 'default' -%}
          border: var(--border-thickness, 1px) solid var(--color-border, #e5e5e5);
          border-radius: var(--border-radius, 0.5rem);
        {%- when 'custom' -%}
          border-top: var(--border-top-thickness, 1px) solid var(--color-border, #e5e5e5);
          border-bottom: var(--border-bottom-thickness, 1px) solid var(--color-border, #e5e5e5);
          border-left: var(--border-left-thickness, 1px) solid var(--color-border, #e5e5e5);
          border-right: var(--border-right-thickness, 1px) solid var(--color-border, #e5e5e5);
          border-top-left-radius: var(--border-radius-top-left, 0.5rem);
          border-top-right-radius: var(--border-radius-top-right, 0.5rem);
          border-bottom-left-radius: var(--border-radius-bottom-left, 0.5rem);
          border-bottom-right-radius: var(--border-radius-bottom-right, 0.5rem);
      {%- endcase -%}

      width: var(--width);
      height: var(--height);

      /* Flex item sizing */
      {%- if block.settings.display_type == 'flex' -%}
        {%- if block.settings.desktop_direction == 'row' and block.settings.desktop_width == 'fill' -%}
          flex: var(--ch-grow, 1) 1 0; /* fill: grow to share width only when the parent is a row (--ch-grow from .group-container); prevents vertical balloon in a column parent */
          min-width: 0;
        {%- elsif block.settings.desktop_width == 'custom' -%}
          flex: none; /* respect the custom width, don't grow or shrink */
        {%- endif -%}
      {%- endif -%}

       order: initial;
    }

    #{{ block.id }} .group-container {
      --ch-grow: {% if block.settings.display_type == 'flex' and block.settings.desktop_direction == 'row' %}1{% else %}0{% endif %};
      {%- if block.settings.display_type == 'grid' -%}
        /* Grid Layout */
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      {%- else -%}
        /* Flex Layout */
        flex-direction: var(--direction);
        align-items: var(--align-items);
        justify-content: var(--justify-content);
      {%- endif -%}
      gap: var(--gap);
      padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left);
    }
  }
</style>

<div id="{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.bg_type == 'image'
    and has_bg_image
    and block.settings.overlay_color != blank
    and block.settings.overlay_opacity > 0
  -%}
    <div class="group-bg__overlay"></div>
  {%- endif -%}

  {% if block.settings.enabled_noise %}
    <monotone-noise
      size="{{ block.settings.noise_size | divided_by: 10.0 }}"
      opacity="{{ block.settings.noise_opacity | divided_by: 100.0 }}"
      density="{{ block.settings.noise_density | divided_by: 100.0 }}"
      color="{{ block.settings.noise_color }}"
    >
    </monotone-noise>
  {% endif %}

  {%- if block.settings.url != blank -%}
    <a href="{{ block.settings.url }}" style="position: absolute; inset: 0; z-index: 10;"></a>
  {%- endif -%}

  <div class="group-container">
    {% content_for 'blocks' %}
  </div>
</div>


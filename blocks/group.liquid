    },
    {
      "type": "group"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "icon"
    },
    {
      "type": "link"
    },
    {
      "type": "contact-link"
    },
    {
      "type": "logo"
    },
    {
      "type": "media"
    },
    {
      "type": "menu"
    },
    {
      "type": "newsletter-form"
    },
    {
      "type": "footer-bar"
    },
    {
      "type": "payment-type"
    },
    {
      "type": "product-hotspots"
    },
    {
      "type": "social-accounts"
    },
    {
      "type": "text"
    },
    {
      "type": "youtube-embed"
    },
    {
      "type": "scrapbook-collage"
    },
    {
      "type": "image-comparison-slider"
    },
    {
      "type": "tabs"
    }
  ],
  "settings": [
    {
      "type": "url",
      "id": "url",
      "label": "t:url.label"
    },
    {
      "type": "header",
      "content": "t:appearance.content"
    },
    {
      "type": "select",
      "id": "display_type",
      "label": "Display Type",
      "options": [
        {
          "value": "flex",
          "label": "Flex"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "flex"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "t:background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:background_type.options.color"
        },
        {
          "value": "image",
          "label": "t:background_type.options.image"
        }
      ],
      "default": "color"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "transparent",
      "info": "Choose a solid background color",
      "visible_if": "{{ block.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:image.label",
      "info": "Choose a background image",
      "visible_if": "{{ block.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:colors.overlay_color.label",
      "default": "#000000",
      "visible_if": "{{ block.settings.bg_type == 'image' and block.settings.bg_image != blank }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%",
      "info": "Opacity of the overlay color (0% = transparent, 100% = solid)",
      "visible_if": "{{ block.settings.bg_type == 'image' and block.settings.bg_image != blank }}"
    },
    {
      "type": "header",
      "content": "Noise"
    },
    {
      "type": "checkbox",
      "id": "enabled_noise",
      "label": "Enable Noise",
      "default": false
    },
    {
      "type": "range",
      "id": "noise_size",
      "label": "Grain Size",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 8,
      "info": "Controls the size of noise grains. Lower = finer grain, Higher = coarser grain. Value is divided by 10 (8 = 0.8)",
      "visible_if": "{{ block.settings.enabled_noise == true }}"
    },
    {
      "type": "range",
      "id": "noise_density",
      "label": "Density",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 90,
      "unit": "%",
      "info": "Percentage of noise coverage",
      "visible_if": "{{ block.settings.enabled_noise == true }}"
    },
    {
      "type": "range",
      "id": "noise_opacity",
      "label": "Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5,
      "unit": "%",
      "info": "Overall opacity of the noise effect",
      "visible_if": "{{ block.settings.enabled_noise == true }}"
    },
    {
      "type": "color",
      "id": "noise_color",
      "label": "Noise Color",
      "default": "#000000",
      "visible_if": "{{ block.settings.enabled_noise == true }}"

{%- if block.settings.media_type == 'image' -%}
  {% render 'responsive-image',
    image: block.settings.image,
    object_fit: block.settings.object_fit,
    enable_mobile_size: block.settings.enable_mobile_size,
    mobile_aspect_ratio: block.settings.mobile_aspect_ratio,
    mobile_enable_custom_dimension: block.settings.mobile_enable_custom_dimension,
    mobile_custom_width: block.settings.mobile_custom_width,
    mobile_custom_height: block.settings.mobile_custom_height,
    desktop_aspect_ratio: block.settings.desktop_aspect_ratio,
    desktop_enable_custom_dimension: block.settings.desktop_enable_custom_dimension,
    desktop_custom_width: block.settings.desktop_custom_width,
    desktop_custom_height: block.settings.desktop_custom_height,
    border_mode: block.settings.border_mode,
    mobile_border_top_left_radius: block.settings.mobile_border_top_left_radius,
    mobile_border_top_right_radius: block.settings.mobile_border_top_right_radius,
    mobile_border_bottom_left_radius: block.settings.mobile_border_bottom_left_radius,
    mobile_border_bottom_right_radius: block.settings.mobile_border_bottom_left_radius,
    desktop_border_top_left_radius: block.settings.desktop_border_top_left_radius,
    desktop_border_top_right_radius: block.settings.desktop_border_top_right_radius,
    desktop_border_bottom_left_radius: block.settings.desktop_border_bottom_left_radius,
    desktop_border_bottom_right_radius: block.settings.desktop_border_bottom_left_radius,
    shopify_attributes: block.shopify_attributes
  %}
{%- else -%}
  {% render 'responsive-video',
    video: block.settings.video,
    youtube_url: block.settings.youtube_url,
    object_fit: block.settings.object_fit,
    autoplay: block.settings.video_autoplay,
    loop: block.settings.video_loop,
    muted: block.settings.video_mute,
    enable_mobile_size: block.settings.enable_mobile_size,
    mobile_aspect_ratio: block.settings.mobile_aspect_ratio,
    mobile_enable_custom_dimension: block.settings.mobile_enable_custom_dimension,
    mobile_custom_width: block.settings.mobile_custom_width,
    mobile_custom_height: block.settings.mobile_custom_height,
    desktop_aspect_ratio: block.settings.desktop_aspect_ratio,
    desktop_enable_custom_dimension: block.settings.desktop_enable_custom_dimension,
    desktop_custom_width: block.settings.desktop_custom_width,
    desktop_custom_height: block.settings.desktop_custom_height,
    border_mode: block.settings.border_mode,
    mobile_border_top_left_radius: block.settings.mobile_border_top_left_radius,
    mobile_border_top_right_radius: block.settings.mobile_border_top_right_radius,
    mobile_border_bottom_left_radius: block.settings.mobile_border_bottom_left_radius,
    mobile_border_bottom_right_radius: block.settings.mobile_border_bottom_left_radius,
    desktop_border_top_left_radius: block.settings.desktop_border_top_left_radius,
    desktop_border_top_right_radius: block.settings.desktop_border_top_right_radius,
    desktop_border_bottom_left_radius: block.settings.desktop_border_bottom_left_radius,
    desktop_border_bottom_right_radius: block.settings.desktop_border_bottom_left_radius,
    shopify_attributes: block.shopify_attributes
  %}
{%- endif -%}

{%- schema -%}
{
  "name": "t:block.media.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "label": "t:image.label",
          "value": "image"
        },
        {
          "label": "t:video.label",
          "value": "video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:image.label",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:video.label",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "YouTube URL",
      "info": "Paste a YouTube link (e.g. https://youtu.be/abc123 or https://www.youtube.com/watch?v=abc123). When set, this overrides the uploaded video. Autoplay, Loop, and Mute settings below still apply.",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:loop_video.label",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_mute",
      "label": "Mute Audio",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Object Fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "t:size.desktop.content"
    },
    {
      "type": "select",
      "id": "desktop_aspect_ratio",
      "label": "t:aspect_ratio.label",
      "options": [
        { "label": "t:aspect_ratio.options.unset", "value": "unset" },
        { "label": "t:aspect_ratio.options.adapt", "value": "auto" },
        { "label": "16:9 (Widescreen)", "value": "16 / 9" },
        { "label": "4:3 (Standard)", "value": "4 / 3" },
        { "label": "1:1 (Square)", "value": "1 / 1" },
        { "label": "9:16 (Vertical)", "value": "9 / 16" },
        { "label": "21:9 (Cinematic)", "value": "21 / 9" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "desktop_enable_custom_dimension",
      "label": "Enable Custom Dimension"
    },
    {
      "type": "text",
      "id": "desktop_custom_width",
      "label": "Width",
      "placeholder": "px, rem, %, etc.",
      "default": "600px",
      "visible_if": "{{ block.settings.desktop_enable_custom_dimension }}"
    },
    {
      "type": "text",
      "id": "desktop_custom_height",
      "label": "Height",
      "placeholder": "px, rem, %, etc.",
      "default": "400px",
      "visible_if": "{{ block.settings.desktop_enable_custom_dimension }}"
    },
    {
      "type": "header",
      "content": "t:size.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_size",
      "label": "Enable Mobile Size"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",

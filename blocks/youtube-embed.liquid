{% comment %}
  {% style %}
    .youtube-embed-{{block.id }} {
      margin-top: 1rem;
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%; /* 16:9 aspect ratio (9/16 = 0.5625) */
      height: 0;
      overflow: hidden;
    }

    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
  {% endstyle %}

  {% if product.metafields.custom.video.value %}
    <div class="youtube-embed-{{block.id }}" {{ block.shopify_attributes }}>
      <div class="video-wrapper">
        {{ product.metafields.custom.video.value }}
      </div>
    </div>
  {% endif %}

  {% schema %}
  {
    "name": "t:block.youtube_embed.name",
    "tag": null,
    "settings": [],
    "presets": [
      {
        "category": "t:block.youtube_embed.category",
        "name": "t:block.youtube_embed.presets.youtube_embed"
      }
    ]
  }
  {% endschema %}
{% endcomment %}

{% style %}
  .youtube-embed-{{block.id }} {
    margin-top: 1rem;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio (9/16 = 0.5625) */
    height: 0;
    overflow: hidden;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
{% endstyle %}

{% if block.settings.url %}
  <div class="youtube-embed-{{block.id }}" {{ block.shopify_attributes }}>
    <div class="video-wrapper">
      {{ block.settings.url }}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:block.youtube_embed.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "url",
      "label": "t:url.label"
    }
  ],
  "presets": [
    {
      "name": "t:block.youtube_embed.name",
      "category": "t:block.youtube_embed.category"
    }
  ]
}
{% endschema %}

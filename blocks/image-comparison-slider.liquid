{%- liquid
  assign unique_id = 'comparison-slider-' | append: block.id

  # Image settings for responsive-image snippet
  assign object_fit = 'cover'

  # Label positioning classes
  case block.settings.label_position
    when 'top'
      assign label_position_class = 'comparison-slider--labels-top'
    when 'bottom'
      assign label_position_class = 'comparison-slider--labels-bottom'
    when 'middle'
      assign label_position_class = 'comparison-slider--labels-middle'
  endcase

  # Handle visibility
  assign handle_visibility = block.settings.handle_visibility | default: 'always'
-%}

{%- style -%}
  #{{ unique_id }} {
    /* Slider position */
    --slider-position: 50%;

    /* Handle styling */
    --handle-color: {{ block.settings.handle_color | default: '#ffffff' }};
    --handle-width: 2px;
    --handle-grip-size: 48px;

    /* Label styling */
    --label-bg-color: {{ block.settings.label_bg_color | default: '#000000' }};
    --label-text-color: {{ block.settings.label_text_color | default: '#ffffff' }};

    /* Container sizing - Desktop values used as default */
    --aspect-ratio: {{ block.settings.desktop_aspect_ratio }};

    {%- if block.settings.desktop_enable_custom_dimension -%}
      --width: {{ block.settings.desktop_custom_width }};
      --height: {{ block.settings.desktop_custom_height }};
    {%- endif -%}

    /* Border radius */
    {%- if block.settings.border_mode == 'custom' -%}
      --border-tl: {{ block.settings.mobile_border_top_left_radius }};
      --border-tr: {{ block.settings.mobile_border_top_right_radius }};
      --border-bl: {{ block.settings.mobile_border_bottom_left_radius }};
      --border-br: {{ block.settings.mobile_border_bottom_right_radius }};
    {%- endif -%}

    position: relative;
    display: block;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;

    {%- if block.settings.enable_mobile_size -%}
      aspect-ratio: {{ block.settings.mobile_aspect_ratio }};
      {%- if block.settings.mobile_enable_custom_dimension -%}
        width: {{ block.settings.mobile_custom_width }};
        height: {{ block.settings.mobile_custom_height }};
        aspect-ratio: unset;
      {%- endif -%}
    {%- else -%}
      aspect-ratio: var(--aspect-ratio);
      {%- if block.settings.desktop_enable_custom_dimension -%}
        width: var(--width);
        height: var(--height);
        aspect-ratio: unset;
      {%- endif -%}
    {%- endif -%}

    {%- if block.settings.border_mode == 'inherit' -%}
      border-radius: var(--image-border-radius);
    {%- else -%}
      border-top-left-radius: var(--border-tl);
      border-top-right-radius: var(--border-tr);
      border-bottom-left-radius: var(--border-bl);
      border-bottom-right-radius: var(--border-br);
    {%- endif -%}
  }

  /* Desktop styles */
  @media (width >= 64rem) {
    #{{ unique_id }} {
      aspect-ratio: {{ block.settings.desktop_aspect_ratio }};

      {%- if block.settings.desktop_enable_custom_dimension -%}
        width: {{ block.settings.desktop_custom_width }};
        height: {{ block.settings.desktop_custom_height }};
        aspect-ratio: unset;
      {%- endif -%}

      {%- if block.settings.border_mode == 'custom' -%}
        --border-tl: {{ block.settings.desktop_border_top_left_radius }};
        --border-tr: {{ block.settings.desktop_border_top_right_radius }};
        --border-bl: {{ block.settings.desktop_border_bottom_left_radius }};
        --border-br: {{ block.settings.desktop_border_bottom_right_radius }};
      {%- endif -%}
    }
  }

  /* Before image container - full size, underneath */
  #{{ unique_id }} .comparison-slider__before {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* After image container - clipped overlay */
  #{{ unique_id }} .comparison-slider__after {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 2;
    clip-path: inset(0 0 0 var(--slider-position));
  }

  /* Ensure images fill their containers */
  #{{ unique_id }} .comparison-slider__before > *,
  #{{ unique_id }} .comparison-slider__after > * {
    width: 100%;
    height: 100%;
  }

  #{{ unique_id }} .comparison-slider__before img,
  #{{ unique_id }} .comparison-slider__after img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Labels */
  #{{ unique_id }} .comparison-slider__label {
    position: absolute;
    z-index: 5;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--label-bg-color);
    color: var(--label-text-color);
    border-radius: 0.25rem;
    pointer-events: none;
    opacity: 0.9;
  }

  /* Label positions - Top */
  #{{ unique_id }}.comparison-slider--labels-top .comparison-slider__label--before {
    top: 1rem;
    left: 1rem;
  }

  #{{ unique_id }}.comparison-slider--labels-top .comparison-slider__label--after {
    top: 1rem;
    right: 1rem;
  }

  /* Label positions - Bottom */
  #{{ unique_id }}.comparison-slider--labels-bottom .comparison-slider__label--before {
    bottom: 1rem;
    left: 1rem;
  }

  #{{ unique_id }}.comparison-slider--labels-bottom .comparison-slider__label--after {
    bottom: 1rem;
    right: 1rem;
  }

  /* Label positions - Middle */
  #{{ unique_id }}.comparison-slider--labels-middle .comparison-slider__label--before {
    top: 50%;
    left: 1rem;
    transform: translateY(-50%);
  }

  #{{ unique_id }}.comparison-slider--labels-middle .comparison-slider__label--after {
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
  }

  /* Slider handle */
  #{{ unique_id }} .comparison-slider__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--slider-position);
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    outline: none;
  }

  #{{ unique_id }} .comparison-slider__handle:focus-visible .comparison-slider__handle-grip {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
  }

  /* Handle line */
  #{{ unique_id }} .comparison-slider__handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: var(--handle-width);
    background-color: var(--handle-color);
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.3);
  }

  /* Handle grip (circle with arrows) */
  #{{ unique_id }} .comparison-slider__handle-grip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--handle-grip-size);
    height: var(--handle-grip-size);
    background-color: var(--handle-color);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease;
  }

  #{{ unique_id }} .comparison-slider__handle-grip:hover {
    transform: scale(1.1);
  }

  #{{ unique_id }} .comparison-slider__handle-grip svg {
    width: 1rem;
    height: 1rem;
    color: #333333;
    flex-shrink: 0;
  }

  /* Handle visibility - hover only */
  #{{ unique_id }}[data-handle-visibility="hover"] .comparison-slider__handle {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  #{{ unique_id }}[data-handle-visibility="hover"]:hover .comparison-slider__handle,
  #{{ unique_id }}[data-handle-visibility="hover"]:focus-within .comparison-slider__handle,
  #{{ unique_id }}[data-handle-visibility="hover"][data-dragging="true"] .comparison-slider__handle {
    opacity: 1;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #{{ unique_id }} .comparison-slider__handle-grip,
    #{{ unique_id }}[data-handle-visibility="hover"] .comparison-slider__handle {
      transition: none;
    }
  }
{%- endstyle -%}

<image-comparison-slider
  id="{{ unique_id }}"
  class="comparison-slider {{ label_position_class }}"
  data-handle-visibility="{{ handle_visibility }}"
  {{ block.shopify_attributes }}
>
  <!-- Before Image (underneath) -->
  <div class="comparison-slider__before">
    {%- render 'responsive-image',
      image: block.settings.before_image,
      object_fit: object_fit,
      desktop_aspect_ratio: 'unset',
      mobile_aspect_ratio: 'unset',
      lazy_loading: true
    -%}
  </div>

  <!-- After Image (clipped overlay) -->
  <div class="comparison-slider__after">
    {%- render 'responsive-image',
      image: block.settings.after_image,
      object_fit: object_fit,
      desktop_aspect_ratio: 'unset',
      mobile_aspect_ratio: 'unset',
      lazy_loading: true
    -%}
  </div>

  <!-- Labels -->
  {%- if block.settings.show_labels -%}
    <span class="comparison-slider__label comparison-slider__label--before">
      {{- block.settings.before_label | default: 'Before' -}}
    </span>
    <span class="comparison-slider__label comparison-slider__label--after">
      {{- block.settings.after_label | default: 'After' -}}
    </span>
  {%- endif -%}

  <!-- Draggable Handle -->
  <div
    class="comparison-slider__handle"
    role="slider"
    aria-label="Image comparison slider"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    tabindex="0"
  >
    <div class="comparison-slider__handle-line"></div>
    <div class="comparison-slider__handle-grip">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.3334 3.46793L6.40804 8.00008L11.3334 12.5322L10.4627 13.3334L4.66671 8.00008L10.4627 2.66675L11.3334 3.46793Z" fill="#44403F"/>
      </svg>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M4.66663 12.5321L9.59196 7.99992L4.66663 3.46778L5.53731 2.66658L11.3333 7.99992L5.53731 13.3333L4.66663 12.5321Z" fill="#44403F"/>
      </svg>
    </div>
  </div>
</image-comparison-slider>


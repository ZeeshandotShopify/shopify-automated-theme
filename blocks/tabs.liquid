{%- style -%}
  /* Base container */
  tabs-container {
    display: block;
    width: 100%;
  }

  #tabs-{{ block.id }} {
    --layout-gap: {{ block.settings.mobile_gap }};
    --tabs-active-fg: {{ block.settings.active_foreground_color }};
    --tabs-active-bg: {{ block.settings.active_background_color }};
    --tabs-indicator: {{ block.settings.indicator_color }};
    --tabs-inactive-opacity: 0.3;
    --tabs-gap: {{ block.settings.mobile_tabs_gap }}px;
  }

  .tabs {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Nav container (heading + triggers) */
  .tabs__nav {
    display: flex;
    flex-direction: column;
  }

  /* Heading */
  .tabs__heading {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    line-height: 120%;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  /* Inner container handles orientation */
  .tabs__inner {
    display: flex;
    flex-direction: column;
    gap: var(--layout-gap);
    width: 100%;
  }

  /* Triggers container */
  .tabs__triggers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tabs-gap);
  }

  /* Trigger button base */
  .tabs__trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    color: var(--tabs-active-fg);
    opacity: var(--tabs-inactive-opacity);
    text-decoration: none;
  }

  .tabs__trigger:focus-visible {
    outline: 2px solid var(--tabs-active-fg);
    outline-offset: 2px;
  }

  .tabs__trigger.is-active {
    opacity: 1;
  }

  /* Style: Underline (text decoration) */
  .tabs--style-underline .tabs__trigger {
    padding: 0;
    text-underline-offset: 4px;
  }

  .tabs--style-underline .tabs__trigger.is-active {
    text-decoration: underline;
  }

  /* Style: Background + Foreground */
  .tabs--style-background-foreground .tabs__trigger {
    border-radius: var(--button-border-radius);
  }

  .tabs--style-background-foreground .tabs__trigger.is-active {
    background-color: var(--tabs-active-bg);
  }

  /* Style: Indicator bar */
  .tabs--style-indicator .tabs__trigger {
    padding-inline: 0;
    padding-top: 0;
    padding-bottom: 1.5rem;
  }

  .tabs--style-indicator .tabs__trigger-indicator {
    display: block;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--tabs-indicator);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .tabs--style-indicator .tabs__trigger.is-active .tabs__trigger-indicator {
    transform: scaleX(1);
  }

  /* Panels */
  .tabs__panels {
    width: 100%;
  }

  tab-panel {
    display: none;
  }

  tab-panel.is-active {
    display: block;
  }

  /* Mobile rules */
  @media (width < 64rem) {
    .tabs__inner[data-mobile-position="bottom"] {
      flex-direction: column-reverse;
    }

    .tabs__inner[data-mobile-orientation="vertical"] .tabs__triggers {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    /* Horizontal scrollable tabs on mobile */
    .tabs__inner[data-mobile-orientation="horizontal"] .tabs__triggers {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE 10+ */
    }

    .tabs__inner[data-mobile-orientation="horizontal"] .tabs__triggers::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Opera */
    }

    .tabs__inner[data-mobile-orientation="horizontal"] .tabs__trigger {
      flex-shrink: 0;
    }
  }

  /* Desktop overrides */
  @media (width >= 64rem) {
    #tabs-{{ block.id }} {
      --layout-gap: {{ block.settings.desktop_gap }};
      --tabs-gap: {{ block.settings.desktop_tabs_gap }}px;
    }

    /* Heading */
    .tabs__heading {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }

    /* Reset mobile styles first */
    .tabs__inner {
      flex-direction: column;
    }

    .tabs__inner .tabs__triggers {
      flex-direction: row;
    }

    /* Desktop: Horizontal positions */
    .tabs__inner[data-desktop-orientation="horizontal"][data-desktop-position="bottom"] {
      flex-direction: column-reverse;
    }

    /* Desktop: Vertical positions */
    .tabs__inner[data-desktop-orientation="vertical"][data-desktop-position="left"] {
      flex-direction: row;
    }

    .tabs__inner[data-desktop-orientation="vertical"][data-desktop-position="right"] {
      flex-direction: row-reverse;
    }

    .tabs__inner[data-desktop-orientation="vertical"][data-desktop-position="bottom"] {
      flex-direction: column-reverse;
    }

    .tabs__inner[data-desktop-orientation="vertical"][data-desktop-position="left"] .tabs__nav,
    .tabs__inner[data-desktop-orientation="vertical"][data-desktop-position="right"] .tabs__nav {
      flex-shrink: 0;
    }

    .tabs__inner[data-desktop-orientation="vertical"] .tabs__triggers {
      flex-direction: column;
      flex-wrap: nowrap;
    }
  }
{%- endstyle -%}

<tabs-container
  id="tabs-{{ block.id }}"
  class="tabs tabs--style-{{ block.settings.trigger_style }}"
  data-trigger-style="{{ block.settings.trigger_style }}"
  {{ block.shopify_attributes }}
>
  <div
    class="tabs__inner"
    data-desktop-orientation="{{ block.settings.desktop_orientation }}"
    data-desktop-position="{% if block.settings.desktop_orientation == 'horizontal' %}{{ block.settings.desktop_horizontal_position }}{% else %}{{ block.settings.desktop_vertical_position }}{% endif %}"
    data-mobile-orientation="{{ block.settings.mobile_orientation }}"
    data-mobile-position="{% if block.settings.mobile_orientation == 'horizontal' %}{{ block.settings.mobile_horizontal_position }}{% else %}{{ block.settings.mobile_vertical_position }}{% endif %}"
  >
    <div class="tabs__nav">
      {% if block.settings.heading != blank %}
        <div class="tabs__heading">{{ block.settings.heading }}</div>
      {% endif %}
      <div class="tabs__triggers" role="tablist">
        <!-- Triggers generated by JS from tab-panel data-label attributes -->
      </div>
    </div>

    <div class="tabs__panels">
      {% content_for 'blocks' %}
    </div>
  </div>
</tabs-container>


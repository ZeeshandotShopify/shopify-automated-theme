{%- schema -%}
{
  "name": "t:block.social_accounts.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "color_mode",
      "label": "t:color_mode.label",
      "options": [
        {
          "value": "inherit",
          "label": "t:color_mode.options.inherit"
        },
        {
          "value": "custom",
          "label": "t:color_mode.options.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "fg_color",
      "label": "t:colors.foreground_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "t:colors.background_color.label",
      "default": "#222222",
      "visible_if": "{{ block.settings.color_mode == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "t:block.social_accounts.name",
      "category": "t:block.social_accounts.category"
    }
  ]
}
{%- endschema -%}

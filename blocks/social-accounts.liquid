{%- liquid
  assign social_accounts_id = 'social-accounts-' | append: block.id

  # Map global icon size setting to pixel values
  case settings.social_icon_size
    when 'small'
      assign icon_size = '20'
    when 'large'
      assign icon_size = '32'
    else
      assign icon_size = '24'
  endcase

  # Button spacing from global settings
  assign button_spacing = settings.social_button_spacing | default: 12

  # Determine style class from global icon style
  assign style_class = 'social-accounts__link--minimal'
  case settings.social_icon_style
    when 'filled'
      assign style_class = 'social-accounts__link--filled'
    when 'outline'
      assign style_class = 'social-accounts__link--outline'
    when 'rounded'
      assign style_class = 'social-accounts__link--rounded'
  endcase
-%}

{%- style -%}
  #{{ social_accounts_id }} {
    --icon-size: {{ icon_size }}px;
    --icon-color: {{ settings.social_icon_color | default: '#374151' }};
    --icon-hover-color: {{ settings.social_icon_hover_color | default: '#111827' }};
    --filled-bg: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.1 }};
    --filled-bg-hover: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.2 }};
    --hover-bg: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.08 }};
    --rounded-bg: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.1 }};
    --rounded-bg-hover: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.18 }};
    --button-spacing: {{ button_spacing }}px;

    display: flex;
    flex-wrap: wrap;
    gap: var(--button-spacing);
    align-items: center;
  }

  {%- if block.settings.color_mode == 'custom' -%}
    #{{ social_accounts_id }} {
      --icon-color: {{ block.settings.fg_color }};
      --icon-hover-color: {{ block.settings.fg_color }};
      --filled-bg: {{ block.settings.bg_color }};
      --filled-bg-hover: {{ block.settings.bg_color }};
      --hover-bg: {{ block.settings.bg_color }};
      --rounded-bg: {{ block.settings.bg_color }};
      --rounded-bg-hover: {{ block.settings.bg_color }};
    }
  {%- endif -%}

  #{{ social_accounts_id }} .social-accounts__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem;
    color: var(--icon-color);
    background: transparent;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 9999px;
    min-width: 44px;
    min-height: 44px;
  }

  #{{ social_accounts_id }} .social-accounts__link:focus {
    outline: none;
  }

  #{{ social_accounts_id }} .social-accounts__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  #{{ social_accounts_id }} .social-accounts__link svg {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    fill: currentColor;
  }

  #{{ social_accounts_id }} .social-accounts__link:hover svg,
  #{{ social_accounts_id }} .social-accounts__link:focus-visible svg {
    transform: scale(1.15);
  }

  #{{ social_accounts_id }} .social-accounts__link-label {
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Filled Circle Style */
  #{{ social_accounts_id }} .social-accounts__link--filled {
    background: var(--filled-bg);
  }
  #{{ social_accounts_id }} .social-accounts__link--filled:hover,
  #{{ social_accounts_id }} .social-accounts__link--filled:focus-visible {
    background: var(--filled-bg-hover);
  }

  /* Outline Style */
  #{{ social_accounts_id }} .social-accounts__link--outline {
    border: 1.5px solid currentColor;
  }
  #{{ social_accounts_id }} .social-accounts__link--outline:hover,
  #{{ social_accounts_id }} .social-accounts__link--outline:focus-visible {
    background: var(--hover-bg);
  }

  /* Minimal Style */
  #{{ social_accounts_id }} .social-accounts__link--minimal {
    padding: 0.375rem;
    min-width: auto;
    min-height: auto;
    border-radius: 0.375rem;
  }
  #{{ social_accounts_id }} .social-accounts__link--minimal:hover,
  #{{ social_accounts_id }} .social-accounts__link--minimal:focus-visible {
    background: var(--hover-bg);
  }

  /* Rounded Square Style */
  #{{ social_accounts_id }} .social-accounts__link--rounded {
    border-radius: 0.5rem;
    background: var(--rounded-bg);
  }
  #{{ social_accounts_id }} .social-accounts__link--rounded:hover,
  #{{ social_accounts_id }} .social-accounts__link--rounded:focus-visible {
    background: var(--rounded-bg-hover);
    border-radius: 0.75rem;
  }

  /* Brand Color Hover Effects */
  {% if settings.social_use_brand_colors %}
    #{{ social_accounts_id }} .social-accounts__link--facebook:hover,
    #{{ social_accounts_id }} .social-accounts__link--facebook:focus-visible {
      color: #1877f2;
      background: rgba(24, 119, 242, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--twitter:hover,
    #{{ social_accounts_id }} .social-accounts__link--twitter:focus-visible {
      color: #000000;
      background: rgba(0, 0, 0, 0.08);
    }
    #{{ social_accounts_id }} .social-accounts__link--instagram:hover,
    #{{ social_accounts_id }} .social-accounts__link--instagram:focus-visible {
      color: #E4405F;
      background: rgba(228, 64, 95, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--pinterest:hover,
    #{{ social_accounts_id }} .social-accounts__link--pinterest:focus-visible {
      color: #e60023;
      background: rgba(230, 0, 35, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--tiktok:hover,
    #{{ social_accounts_id }} .social-accounts__link--tiktok:focus-visible {
      color: #000000;
      background: rgba(0, 0, 0, 0.08);
    }
    #{{ social_accounts_id }} .social-accounts__link--youtube:hover,
    #{{ social_accounts_id }} .social-accounts__link--youtube:focus-visible {
      color: #FF0000;
      background: rgba(255, 0, 0, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--vimeo:hover,
    #{{ social_accounts_id }} .social-accounts__link--vimeo:focus-visible {
      color: #1ab7ea;
      background: rgba(26, 183, 234, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--linkedin:hover,
    #{{ social_accounts_id }} .social-accounts__link--linkedin:focus-visible {
      color: #0A66C2;
      background: rgba(10, 102, 194, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--snapchat:hover,
    #{{ social_accounts_id }} .social-accounts__link--snapchat:focus-visible {
      color: #FFFC00;
      background: rgba(255, 252, 0, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--wechat:hover,
    #{{ social_accounts_id }} .social-accounts__link--wechat:focus-visible {
      color: #07C160;
      background: rgba(7, 193, 96, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--reddit:hover,
    #{{ social_accounts_id }} .social-accounts__link--reddit:focus-visible {
      color: #FF4500;
      background: rgba(255, 69, 0, 0.12);
    }
    #{{ social_accounts_id }} .social-accounts__link--telegram:hover,
    #{{ social_accounts_id }} .social-accounts__link--telegram:focus-visible {
      color: #0088cc;
      background: rgba(0, 136, 204, 0.12);
    }
  {% else %}
    #{{ social_accounts_id }} .social-accounts__link:hover,
    #{{ social_accounts_id }} .social-accounts__link:focus-visible {
      color: var(--icon-hover-color);
    }
  {% endif %}

  @media (max-width: 640px) {
    #{{ social_accounts_id }} .social-accounts__link-label {
      display: none;
    }
  }
{%- endstyle -%}


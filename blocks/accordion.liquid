{%- style -%}
  #accordion-{{ block.id }} {
    display: flex;
    flex-direction: column;
    --accordion-gap: {{ block.settings.mobile_gap }};
    gap: var(--accordion-gap);
  }

  #accordion-{{ block.id }} accordion-item {
    {%- if block.settings.trigger_style_mode == 'inherit' -%}
    background-color: var(--color-accordion-background);
    color: var(--color-accordion-foreground);
    border: var(--accordion-border-thickness) solid var(--color-border, #e5e5e5);
    border-radius: var(--accordion-border-radius);
    {%- else -%}
    background-color: {{ block.settings.trigger_background_color }};
    color: {{ block.settings.trigger_foreground_color }};
    border-top: {{ block.settings.border_top_thickness }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_bottom_thickness }}px solid {{ block.settings.border_color }};
    border-left: {{ block.settings.border_left_thickness }}px solid {{ block.settings.border_color }};
    border-right: {{ block.settings.border_right_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }};
    {%- endif -%}
  }

  #accordion-{{ block.id }} accordion-trigger {
    font-size: {{ block.settings.trigger_font_size }};
    line-height: {{ block.settings.trigger_line_height }};
    font-weight: {{ block.settings.trigger_font_weight }};
    padding: {{ block.settings.trigger_padding_y }}px {{ block.settings.trigger_padding_x }}px;
  }

  #accordion-{{ block.id }} accordion-content {
    padding-left: {{ block.settings.trigger_padding_x }}px;
    padding-right: {{ block.settings.trigger_padding_x }}px;
  }

  #accordion-{{ block.id }} .accordion-content-inner {
    padding-bottom: {{ block.settings.trigger_padding_y }}px;
  }

  @media (width >= 64rem) {
    #accordion-{{ block.id }} {
      --accordion-gap: {{ block.settings.desktop_gap }};
    }
  }
{%- endstyle -%}

<div
  id="accordion-{{ block.id }}"
  data-accordion-icon="{{ block.settings.icon | default: 'chevron' }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

<script>
  /**
   * Propagates the parent accordion's icon setting to each child <accordion-item>.
   *
   * Why inline: accordion.js loads with `defer`, so it executes after the full
   * DOM is parsed. This inline script runs during parsing — before any deferred
   * script — ensuring the `icon` attribute is set on each <accordion-item>
   * before its `connectedCallback` fires and calls `_appendIcon()`.
   *
   * Why data attribute: In Shopify's block architecture, a parent block can't
   * pass its settings to child blocks — each block only accesses its own
   * `block.settings`. The icon choice lives on the parent accordion, but each
   * child <accordion-item> needs it. We bridge this by storing the value in
   * `data-accordion-icon` on the parent DOM element, then reading and
   * propagating it to each child here.
   */
  (function () {
    var el = document.getElementById('accordion-{{ block.id }}');
    if (!el) return;
    var icon = el.getAttribute('data-accordion-icon');
    el.querySelectorAll(':scope > accordion-item').forEach(function (item) {
      item.setAttribute('icon', icon);
    });
  })();
</script>


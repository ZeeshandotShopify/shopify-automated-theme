{% render 'button',
  label: block.settings.label,
  url: block.settings.url,
  variant: block.settings.variant,
  size: block.settings.size,
  hover_effect: block.settings.hover_effect,
  icon_mode: block.settings.icon_mode,
  icon_select: block.settings.icon_select,
  icon_custom: block.settings.icon,
  icon_position: block.settings.icon_position,
  full_width: block.settings.full_width,
  space_between: block.settings.space_between,
  disabled: block.settings.disabled,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:block.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:label.label",
      "default": "Click me"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:url.label",
      "info": "Leave empty to render as button element instead of link"
    },
    {
      "type": "header",
      "content": "t:style.content"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "t:variant.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:variant.options.default"
        },
        {
          "value": "secondary",
          "label": "t:variant.options.secondary"
        },
        {
          "value": "destructive",
          "label": "t:variant.options.destructive"
        },
        {
          "value": "outline",
          "label": "t:variant.options.outline"
        },
        {
          "value": "ghost",
          "label": "t:variant.options.ghost"
        },
        {
          "value": "link",
          "label": "t:variant.options.link"
        }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:size.label",
      "default": "default",
      "options": [
        {
          "value": "sm",
          "label": "t:size.options.sm"
        },
        {
          "value": "default",
          "label": "t:size.options.default"
        },
        {
          "value": "lg",
          "label": "t:size.options.lg"
        },
        {
          "value": "icon",
          "label": "t:size.options.icon"
        }
      ]
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "scale",
          "label": "Scale"
        },
        {
          "value": "opacity",
          "label": "Default"
        },
        {
          "value": "bg-slide",
          "label": "Background slide"
        },
        {
          "value": "icon-slide",
          "label": "Icon slide"
        },
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "icon-fade",
          "label": "Icon fade in"
        },
        {
          "value": "icon-slide-in",
          "label": "Icon slide in"
        },
        {
          "value": "bg-icon-both",
          "label": "Background slide + Icon slide"
        },
        {
          "value": "bg-icon-slide-in",
          "label": "Background slide + Icon slide in"
        },
        {
          "value": "bg-icon-fade",
          "label": "Background slide + Icon fade in"
        }
      ],
      "default": "opacity"
    },
    {
      "type": "header",
      "content": "t:icon.content"
    },
    {
      "type": "select",
      "id": "icon_mode",
      "label": "t:icon_mode.label",
      "options": [
        {
          "value": "none",
          "label": "t:icon_mode.options.none"
        },
        {
          "value": "select",
          "label": "t:icon_mode.options.select"
        },
        {
          "value": "custom",
          "label": "t:icon_mode.options.custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon_select",
      "label": "t:icon.label",
      "options": [
        {
          "value": "arrow-right",
          "label": "Arrow Right"
        },
        {
          "value": "arrow-down",
          "label": "Arrow Down"
        },
        {
          "value": "arrow-left-long",
          "label": "Arrow Left Long"
        },
        {
          "value": "arrow-right-long",
          "label": "Arrow Right Long"
        },
        {
          "value": "arrow-up-long",
          "label": "Arrow Up Long"
        },
        {
          "value": "arrow-down-long",
          "label": "Arrow Down Long"
        },
        {
          "value": "arrow-right-up-long",
          "label": "Arrow Right Up Long"
        },
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "minus",
          "label": "Minus"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "menu",
          "label": "Menu"
        },
        {
          "value": "search",
          "label": "Search"
        },
        {
          "value": "copy",
          "label": "Copy"
        },
        {
          "value": "download",
          "label": "Download"
        },
        {
          "value": "upload",
          "label": "Upload"
        },
        {
          "value": "share",
          "label": "Share"
        },
        {
          "value": "gear",
          "label": "Gear"
        },
        {
          "value": "filter",
          "label": "Filter"
        },
        {
          "value": "edit",
          "label": "Edit"
        },
        {
          "value": "trash",
          "label": "Trash"
        },
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "bag",
          "label": "Bag"
        },
        {
          "value": "lock",
          "label": "Lock"
        }
      ],
      "visible_if": "{{ block.settings.icon_mode == 'select' }}"
    },
    {
      "type": "html",
      "id": "icon",
      "label": "t:icon.label",
      "info": "Paste SVG code here",
      "visible_if": "{{ block.settings.icon_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:layout.alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:layout.alignment.options.left"
        },
        {
          "value": "right",
          "label": "t:layout.alignment.options.right"
        }
      ],
      "visible_if": "{{ block.settings.icon_mode == 'custom' or block.settings.icon_mode == 'select' and block.settings.size != 'icon' }}"
    },
    {
      "type": "header",
      "content": "t:options.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:full_width.label",
      "default": false,
      "visible_if": "{{ block.settings.size != 'icon' and block.settings.label != blank }}"
    },
    {
      "type": "checkbox",
      "id": "space_between",
      "label": "Space between label and icon",
      "default": false,
      "info": "Positions label and icon on opposite ends",
      "visible_if": "{{ block.settings.full_width == true and block.settings.icon_mode != 'none' }}"
    },
    {
      "type": "checkbox",
      "id": "disabled",
      "label": "t:disabled.label",
      "default": false,
      "info": "Make button non-clickable (useful for demo purposes)"
    }
  ],
  "presets": [
    {
      "name": "t:block.button.presets.button",
      "category": "t:block.button.category"
    }
  ]
}
{% endschema %}

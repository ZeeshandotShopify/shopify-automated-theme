<tab-panel
  id="tab-panel-{{ block.id }}"
  data-label="{{ block.settings.label | escape }}"
  role="tabpanel"
  {{ block.shopify_attributes }}
>
  <div class="tabs__panel-inner">
    {% content_for 'blocks' %}
  </div>
</tab-panel>

{% schema %}
{
  "name": "t:block.tabs.tab.name",
  "tag": null,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "accordion"
    },
    {
      "type": "button"
    },
    {
      "type": "contact-form"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "dialog"
    },
    {
      "type": "divider"
    },
    {
      "type": "downloadable-attachment"
    },
    {
      "type": "group"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "icon"
    },
    {
      "type": "link"
    },
    {
      "type": "contact-link"
    },
    {
      "type": "logo"
    },
    {
      "type": "media"
    },
    {
      "type": "menu"
    },
    {
      "type": "newsletter-form"
    },
    {
      "type": "payment-type"
    },
    {
      "type": "product-hotspots"
    },
    {
      "type": "social-accounts"
    },
    {
      "type": "text"
    },
    {
      "type": "youtube-embed"
    },
    {
      "type": "scrapbook-collage"
    },
    {
      "type": "image-comparison-slider"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:label.label",
      "default": "Tab"
    }
  ],
  "presets": [
    {
      "name": "t:block.tabs.tab.presets.tab"
    }
  ]
}
{% endschema %}

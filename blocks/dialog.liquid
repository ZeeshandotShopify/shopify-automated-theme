<dialog-menu data-size="{{ block.settings.dialog_content_size }}">
  <dialog-trigger>
    {% render 'button',
      label: block.settings.trigger_text,
      variant: block.settings.variant,
      size: block.settings.size,
      icon_mode: block.settings.icon_mode,
      icon_select: block.settings.icon_select,
      icon_custom: block.settings.icon,
      icon_position: block.settings.icon_position,
      full_width: block.settings.full_width,
      shopify_attributes: block.shopify_attributes
    %}
  </dialog-trigger>
  <dialog-content>
    {% content_for 'blocks' %}
  </dialog-content>
</dialog-menu>

{% schema %}
{
  "name": "t:block.dialog.name",
  "tag": null,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "accordion"
    },
    {
      "type": "button"
    },
    {
      "type": "contact-form"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "dialog"
    },
    {
      "type": "divider"
    },
    {
      "type": "downloadable-attachment"
    },
    {
      "type": "group"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "icon"
    },
    {
      "type": "link"
    },
    {
      "type": "contact-link"
    },
    {
      "type": "logo"
    },
    {
      "type": "media"
    },
    {
      "type": "menu"
    },
    {
      "type": "newsletter-form"
    },
    {
      "type": "payment-type"
    },
    {
      "type": "product-hotspots"
    },
    {
      "type": "social-accounts"
    },
    {
      "type": "text"
    },
    {
      "type": "youtube-embed"
    },
    {
      "type": "scrapbook-collage"
    },
    {
      "type": "image-comparison-slider"
    },
    {
      "type": "tabs"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "dialog_content_size",
      "label": "t:size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:size.options.sm"
        },
        {
          "value": "md",
          "label": "t:size.options.md"
        },
        {
          "value": "lg",
          "label": "t:size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:size.options.xl"
        },
        {
          "value": "full",
          "label": "t:size.options.full"
        }
      ],
      "default": "md"
    },
    {
      "type": "text",
      "id": "trigger_text",
      "label": "t:label.label",
      "default": "Click me"
    },
    {
      "type": "header",
      "content": "t:style.content"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "t:variant.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:variant.options.default"
        },
        {
          "value": "secondary",
          "label": "t:variant.options.secondary"
        },
        {
          "value": "destructive",
          "label": "t:variant.options.destructive"
        },
        {
          "value": "outline",
          "label": "t:variant.options.outline"
        },
        {
          "value": "ghost",
          "label": "t:variant.options.ghost"
        },
        {
          "value": "link",
          "label": "t:variant.options.link"
        }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:size.label",
      "default": "default",
      "options": [
        {
          "value": "sm",
          "label": "t:size.options.sm"
        },
        {
          "value": "default",
          "label": "t:size.options.default"
        },
        {
          "value": "lg",
          "label": "t:size.options.lg"
        },
        {
          "value": "icon",
          "label": "t:size.options.icon"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:icon.content"
    },
    {
      "type": "select",
      "id": "icon_mode",
      "label": "t:icon_mode.label",
      "options": [
        {
          "value": "none",
          "label": "t:icon_mode.options.none"
        },
        {
          "value": "select",
          "label": "t:icon_mode.options.select"
        },
        {
          "value": "custom",
          "label": "t:icon_mode.options.custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon_select",
      "label": "t:icon.label",
      "options": [
        {
          "value": "arrow-right",
          "label": "Arrow Right"
        },
        {
          "value": "arrow-down",
          "label": "Arrow Down"
        },
        {
          "value": "arrow-left-long",
          "label": "Arrow Left Long"
        },
        {
          "value": "arrow-right-long",
          "label": "Arrow Right Long"
        },
        {
          "value": "arrow-up-long",
          "label": "Arrow Up Long"
        },
        {
          "value": "arrow-down-long",
          "label": "Arrow Down Long"
        },
        {
          "value": "arrow-right-up-long",
          "label": "Arrow Right Up Long"
        },
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "minus",
          "label": "Minus"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "menu",
          "label": "Menu"
        },
        {
          "value": "search",
          "label": "Search"
        },
        {
          "value": "copy",
          "label": "Copy"
        },
        {
          "value": "download",
          "label": "Download"
        },
        {
          "value": "upload",
          "label": "Upload"
        },
        {
          "value": "share",
          "label": "Share"
        },
        {
          "value": "gear",
          "label": "Gear"
        },
        {
          "value": "filter",
          "label": "Filter"
        },
        {
          "value": "edit",
          "label": "Edit"
        },
        {
          "value": "trash",
          "label": "Trash"
        },
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "bag",
          "label": "Bag"
        },
        {
          "value": "lock",
          "label": "Lock"
        }
      ],
      "visible_if": "{{ block.settings.icon_mode == 'select' }}"
    },
    {
      "type": "html",
      "id": "icon",
      "label": "t:icon.label",
      "info": "Paste SVG code here",
      "visible_if": "{{ block.settings.icon_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:layout.alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:layout.alignment.options.left"
        },
        {
          "value": "right",
          "label": "t:layout.alignment.options.right"
        }
      ],
      "visible_if": "{{ block.settings.icon_mode == 'custom' or block.settings.icon_mode == 'select' and block.settings.size != 'icon' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:full_width.label",
      "default": false,
      "visible_if": "{{ block.settings.size != 'icon' and block.settings.trigger_text != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:block.dialog.name"
    }
  ]
}
{% endschema %}

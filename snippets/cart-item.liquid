{% stylesheet %}
  /* Cart Drawer Item */
  .cart-item {
    display: flex;
    gap: 0.75rem;
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 0.5rem;
    padding: 0.75rem;
  }

  .cart-item-image-container {
    width: 5rem;
    height: 5rem;
    position: relative;
    flex-shrink: 0;
    border: var(--image-border-thickness, 1px) solid var(--color-border, #e5e5e5);
    border-radius: var(--image-border-radius);
    overflow: hidden;
  }

  .cart-item-image {
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0px;
    color: transparent;
    object-fit: cover;
  }

  .cart-item-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .cart-item-details-container {
    flex: 1;
    min-width: 0px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cart-item-details-header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cart-item-title {
    font-family: var(--font-body--family);
    display: -webkit-box;
    font-size: 0.875rem; /* 14px */
    line-height: 1.25rem; /* 20px */
    font-weight: 500;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-item-variant-container {
    position: relative;
  }

  .cart-item-variant {
    color: var(--color-muted-foreground);
    font-size: 0.75rem; /* 12px */
    line-height: 1rem; /* 16px */
    cursor: help;
  }

  .cart-item-selling-plan {
    color: var(--color-muted-foreground);
    font-size: 0.75rem; /* 12px */
    line-height: 1rem; /* 16px */
    margin-top: 0.25rem;
  }

  .cart-item .jdgm-prev-badge {
    display: flex !important;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .cart-item .jdgm-preview-badge .jdgm-prev-badge__stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 !important;
    margin: 0 !important;
  }

  .cart-item .jdgm-preview-badge .jdgm-star.jdgm-star {
    display: inline-block !important;
    color: var(--color-star-rating-foreground);
    padding: 0 !important;
    margin: 0 !important;
  }

  .cart-item .jdgm-star.jdgm--on:before {
    font-size: 0.75rem;
  }

  .cart-item .jdgm-prev-badge .jdgm-prev-badge__text {
    color: var(--color-muted-foreground);
    font-size: 0.75rem; /* 12px */
    line-height: 1rem; /* 16px */
    margin-left: 0.25rem;
  }

  .cart-item-price-container {
    font-family: var(--font-body--family);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .cart-item-price-details {
    flex: 1;
    min-width: 0px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cart-item-final-price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0;
  }

  .cart-item-price {
    color: var(--color-price-foreground);
    font-weight: 700;
  }

  .cart-item-compare-at-price {
    color: var(--color-compare-at-price-foreground);
    font-size: 0.75rem; /* 12px */
    line-height: 1rem; /* 16px */
  }

  .cart-item-quantity-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .cart-item-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    width: 1rem;
    height: 1rem;
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
    white-space: nowrap;
    border-radius: var(--button-border-radius);
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
  }

  .cart-item-remove:hover {
    background: var(--color-muted-background);
  }

  .cart-item-remove svg {
    color: var(--color-destructive-background);
    width: 1rem;
    height: 1rem;
  }

  .cart-item-discount {
    margin-top: 0.5rem;
    display: inline-flex; /* Inline Flex - To prevent full width of the element */
    align-items: center;
    gap: 0.25rem;
    background-color: #dcfce7;
    border: 1px solid #bbf7d0;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: #166534;
    padding-block: 0.25rem;
    padding-inline: 0.5rem;
  }

  .cart-item-discount svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  /*! ZEPTO PRODUCT PERSONALIZER */
  .zepto-custom-properties.first-zepto {
    margin-top: 0.5rem; /* adjust as needed */
  }

  .zepto-custom-field {
    font-size: 0.875rem; /* 14px */
    line-height: 1.25rem; /* 20px */
  }

  .zepto-preview-link {
    font-size: 0.875rem; /* 14px */
    line-height: 1.25rem; /* 20px */
    color: var(--color-accent-background);
  }

  /* Uploaded photo thumbnails */
  .cart-item-uploads {
    margin-top: 0.5rem;
  }

  .cart-item-uploads__label {
    display: block;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.375rem;
  }

  .cart-item-uploads__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .cart-item-upload {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 0.375rem;
    overflow: hidden;
    border: 1px solid var(--color-border, #e5e5e5);
    background: var(--color-muted-background, #f4f6f7);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .cart-item-upload:hover,
  .cart-item-upload:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    outline: none;
  }

  .cart-item-upload__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-item-upload__fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1rem;
    height: 1rem;
    color: var(--color-muted-foreground);
  }

  .cart-item-upload--broken .cart-item-upload__img {
    display: none;
  }

  .cart-item-upload--broken .cart-item-upload__fallback {
    display: block;
  }

  .cart-item-upload__num {
    position: absolute;
    bottom: 0;
    right: 0;
    padding: 2px 4px;
    background: var(--color-primary-background, #111111);
    color: var(--color-primary-foreground, #ffffff);
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 600;
    border-top-left-radius: 0.25rem;
  }
{% endstylesheet %}

<div class="cart-item">
  {% comment %} Cart Item Image {% endcomment %}
  <div class="cart-item-image-container">
    {% render 'responsive-image', image: item.image %}
  </div>

  <div class="cart-item-content">
    <div class="cart-item-details-container">
      <div class="cart-item-details-header">
        <div class="cart-item-details">
          {% comment %} Cart Item Title {% endcomment %}
          <h3 class="cart-item-title">
            <a href="{{ item.url }}">{{ item.product.title }}</a>
          </h3>

          {% comment %} Cart Item Variant {% endcomment %}
          {% if item.variant.title != 'Default Title' %}
            <custom-tooltip
              data-full-title="{{ item.variant.title | escape }}"
              data-max-length="25"
            >
              <p class="cart-item-variant">
                {{ item.variant.title | truncate: 25, '...' }}
              </p>
            </custom-tooltip>
          {% endif %}

          {% if item.selling_plan_allocation != null %}
            <p class="cart-item-selling-plan">
              {{ item.selling_plan_allocation.selling_plan.name }}
            </p>
          {% endif %}

          <!-- ZEPTO PRODUCT PERSONALIZER -->
          {% comment %} Cart Item Custom Properties (Zepto Product Personalizer) {% endcomment %}
          {% comment %}
            {%- for p in item.properties -%}
              {%- assign first_char = p.first | slice: 0, 1 -%}
              {%- if first_char != '_' -%}
                <div class="zepto-custom-properties">
                  {%- if p.last contains 'http' -%}
                    <a target="_blank" href="{{ p.last }}" src="{{ p.last }}" download class="zepto-preview-link">Preview</a>
                  {%- else -%}
                    <span class="zepto-custom-field">{{ p.last }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {% endcomment %}

          {%- comment -%} Text (non-image) custom fields {%- endcomment -%}
          {%- assign first_output = false -%}
          {%- for p in item.properties -%}
            {%- assign first_char = p.first | slice: 0, 1 -%}
            {%- if first_char != '_' -%}
              {%- unless p.last contains 'http' -%}
                <div class="zepto-custom-properties {% if first_output == false %}first-zepto{% endif %}">
                  <span class="zepto-custom-field">{{ p.last }}</span>
                </div>
                {%- if first_output == false -%}{%- assign first_output = true -%}{%- endif -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Detect uploaded image (http) props {%- endcomment -%}
          {%- assign has_link_props = false -%}
          {%- for p in item.properties -%}
            {%- assign first_char = p.first | slice: 0, 1 -%}
            {%- if first_char != '_' and p.last contains 'http' -%}
              {%- assign has_link_props = true -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Render uploaded photos as clickable thumbnails {%- endcomment -%}
          {%- if has_link_props -%}
            {%- assign clip_index = 0 -%}
            <div class="cart-item-uploads">
              <span class="cart-item-uploads__label">Your photos</span>
              <div class="cart-item-uploads__grid">
                {%- for p in item.properties -%}
                  {%- assign first_char = p.first | slice: 0, 1 -%}
                  {%- if first_char != '_' and p.last contains 'http' -%}
                    {%- assign clip_index = clip_index | plus: 1 -%}
                    <a
                      href="{{ p.last }}"
                      rel="noopener noreferrer"
                      target="_blank"
                      class="cart-item-upload"
                      title="Photo {{ clip_index }} — view full size"
                    >
                      <img
                        src="{{ p.last }}"
                        alt="Uploaded photo {{ clip_index }}"
                        loading="lazy"
                        width="40"
                        height="40"
                        class="cart-item-upload__img"
                        onerror="this.closest('.cart-item-upload').classList.add('cart-item-upload--broken')"
                      >
                      <svg
                        class="cart-item-upload__fallback"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                      </svg>
                      <span class="cart-item-upload__num">{{ clip_index }}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {% comment %} Cart Item Reviews {% endcomment %}
          {% unless product.metafields.judgeme.badge %}
            <div
              style="{{ jm_style }}"
              class="jdgm-widget jdgm-preview-badge"
              data-id="{{ item.product.id }}"
              data-auto-install="false"
            >
              {{ item.product.metafields.judgeme.badge }}
            </div>
          {% endunless %}
        </div>

        {% comment %} Cart Item Remove {% endcomment %}
        <cart-actions data-line="{{ line }}">
          <button type="button" data-quantity="0" data-cart-item-remove class="cart-item-remove">
            {{ 'trash.svg' | inline_asset_content }}
          </button>
        </cart-actions>
      </div>

      {% comment %} Cart Item Discount Applied {% endcomment %}
      {% if item.line_level_discount_allocations.size > 0 %}
        <ul>
          {% for discount_allocation in item.line_level_discount_allocations %}
            <li class="cart-item-discount">
              {% comment %} {{ discount_allocation.discount_application.title }} - {{ discount_allocation.amount | money }} {% endcomment %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10.9042 2.10025L20.8037 3.51446L22.2179 13.414L13.0255 22.6063C12.635 22.9969 12.0019 22.9969 11.6113 22.6063L1.71184 12.7069C1.32131 12.3163 1.32131 11.6832 1.71184 11.2926L10.9042 2.10025ZM11.6113 4.22157L3.83316 11.9997L12.3184 20.485L20.0966 12.7069L19.036 5.28223L11.6113 4.22157ZM13.7327 10.5855C12.9516 9.80448 12.9516 8.53815 13.7327 7.7571C14.5137 6.97606 15.78 6.97606 16.5611 7.7571C17.3421 8.53815 17.3421 9.80448 16.5611 10.5855C15.78 11.3666 14.5137 11.3666 13.7327 10.5855Z"></path>
              </svg>
              <span>{{ discount_allocation.discount_application.title }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% comment %} Cart Item Quantity {% endcomment %}
      <div class="cart-item-quantity-container">
        {% render 'quantity-selector', item: item, line: line %}

        {% comment %} Cart Item Price {% endcomment %}
        <div class="cart-item-price-container">
          <div class="cart-item-price-details">
            <div class="cart-item-final-price">
              {% if item.original_line_price > item.final_line_price %}
                {% comment %} We use final_line_price instead of original_line_price because we also need the total price with discount applied {% endcomment %}
                <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                <s class="cart-item-compare-at-price">{{ item.original_line_price | money }}</s>
              {% elsif item.variant.compare_at_price > item.variant.price %}
                {% comment %} Show compare at price when variant has compare at price set {% endcomment %}
                <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                {% comment %} <s class="cart-item-compare-at-price">{{ item.variant.compare_at_price | money }}</s> {% endcomment %}

                {% assign compare_at_line_price = item.variant.compare_at_price | times: item.quantity %}
                <s class="cart-item-compare-at-price">{{ compare_at_line_price | money }}</s>
              {% else %}
                <span>{{ item.final_line_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    endcase
  elsif icon_mode == 'custom' and icon_custom != blank
    assign icon_html = icon_custom
  endif
%}

<style>
  #{{ id }} {
     --icon-size: {{ icon_size }}px;
     display: inline-flex;
     align-items: center;
     justify-content: center;
   }

   #{{ id }} svg {
     width: var(--icon-size);
     height: var(--icon-size);
     flex-shrink: 0;
   }
</style>

{% if icon_html != blank %}
  <span id="{{ id }}" aria-hidden="true" {{ block.shopify_attributes }}>
    {{ icon_html }}
  </span>
{% else %}
  {% comment %} Fallback for missing icons {% endcomment %}
  <span id="{{ id }}" role="img" aria-label="Icon not found" {{ block.shopify_attributes }}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C17.52 2 22 6.48 22 12C22 17.52 17.52 22 12 22C6.48 22 2 17.52 2 12C2 6.48 6.48 2 12 2ZM12 20C16.42 20 20 16.42 20 12C20 7.58 16.42 4 12 4C7.58 4 4 7.58 4 12C4 16.42 7.58 20 12 20ZM11 7H13V9H11V7ZM11 11H13V17H11V11Z"/>
    </svg>
  </span>
{% endif %}

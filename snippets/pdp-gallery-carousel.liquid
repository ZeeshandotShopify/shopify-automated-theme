<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#MediaGallery-{{ section.id }}');
    if (!section) return;

    const swiperThumbs = section.querySelector('.pdp-gallery-carousel__swiper--thumbs');
    const swiperMain = section.querySelector('.pdp-gallery-carousel__swiper--main');

    const slideCount = swiperThumbs.querySelectorAll('.swiper-slide').length;

    if (slideCount == 1) {
      swiperThumbs.classList.add('slides-1');
    }
    
    if (slideCount <= 2) {
      swiperThumbs.classList.add('slides-center');
    }

    if (slideCount <= 3) {
      swiperThumbs.classList.add('slides-3');
    } else {
      swiperThumbs.classList.add('slides-4');
    }

    let slidesPerView;

    if (slideCount >= 4) {
      slidesPerView = 4;
    } else {
      slidesPerView = 3;
    }

    // ========================================================================
    // DETERMINE INITIAL SLIDE FROM URL
    // ========================================================================
    let initialSlide = 0;

    // Get variant ID from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const variantId = urlParams.get('variant');

    if (variantId) {
      // Find which variant matches the URL
      const variants = {{ product.variants | json }};
      const selectedVariant = variants.find(v => v.id == variantId);

      if (selectedVariant && selectedVariant.featured_media) {
        // Find the slide index that matches this variant's media
        const allSlides = swiperMain.querySelectorAll('.swiper-slide');
        const targetSlide = swiperMain.querySelector(`[data-media-id="${selectedVariant.featured_media.id}"]`);
        
        if (targetSlide) {
          initialSlide = Array.from(allSlides).indexOf(targetSlide);
        }
      }
    }

    // ========================================================================
    // INITIALIZE SWIPER WITH CORRECT STARTING SLIDE
    // ========================================================================
    window[`swiperThumbs_{{ section.id }}`] = new Swiper(swiperThumbs, {
      spaceBetween: 12,
      slidesPerView: slidesPerView,
      watchSlidesProgress: true,
      breakpoints: {
        1024: {
          spaceBetween: 16,
        }
      }
    });

    window[`swiperMain_{{ section.id }}`] = new Swiper(swiperMain, {
      spaceBetween: 0,
      slidesPerView: 1,
      initialSlide: initialSlide,  // ← Start at the correct slide!
      effect: 'fade',
      fadeEffect: {
        crossFade: true
      },
      allowTouchMove: false,
      thumbs: {
        swiper: window[`swiperThumbs_{{ section.id }}`],
      },
    });
  });
</script>

<script type="module">
  import PhotoSwipeLightbox from '{{ "photoswipe-lightbox.esm.min.js" | asset_url }}';

  const sectionId = '{{ section.id }}';
  const existing = window.__pdpPswpLightboxInstances || (window.__pdpPswpLightboxInstances = {});
  if (!existing[sectionId]) {
    const lightbox = new PhotoSwipeLightbox({
      gallery: `#MediaGallery-${sectionId}`,
      children: 'a.pswp-link',
      mainClass: 'pswp-theme-pdp',
      pswpModule: () => import('{{ "photoswipe.esm.min.js" | asset_url }}'),
      bgOpacity: 1,
      wheelToZoom: true,
      arrowPrevSVG:
        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><title>Previous</title><path d="M15 18l-6-6 6-6"/></svg>',
      arrowNextSVG:
        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><title>Next</title><path d="M9 18l6-6-6-6"/></svg>',
      closeSVG:
        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><title>Close</title><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>',
      zoomSVG:
        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><title>Zoom</title><path d="M21 21l-4.35-4.35"></path><circle cx="10" cy="10" r="6"></circle><path d="M10 7v6"></path><path d="M7 10h6"></path></svg>',
    });

    lightbox.init();
    existing[sectionId] = lightbox;
  }
</script>


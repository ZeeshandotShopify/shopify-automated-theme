<style>
  .pdp .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp .swiper-slide {
    background-size: cover;
    background-position: center;
    border-radius: var(--image-border-radius);
    overflow: hidden;
  }

  .pdp-gallery-carousel__swiper--main {
    width: 100%;
    margin-bottom: 1rem;
    height: 416px;
  }

  .pdp-gallery-carousel__swiper--thumbs.slides-center {
    display: none;
  }

  /* Center thumbnails when there are only 1-2 images */
  .pdp-gallery-carousel__swiper--thumbs.slides-center .swiper-wrapper {
    justify-content: center;
  }

  .pdp-gallery-carousel__swiper--thumbs .swiper-slide {
    opacity: 0.4;
  }

  .pdp-gallery-carousel__swiper--thumbs .swiper-slide-thumb-active {
    opacity: 1;
  }

  /* Height for 3 or fewer slides */
  .pdp-gallery-carousel__swiper--thumbs.slides-3 {
    height: 112px;
  }

  /* Height for 4 or more slides */
  .pdp-gallery-carousel__swiper--thumbs.slides-4 {
    height: 80px;
  }

  .pdp-gallery-carousel__swiper--main .swiper-button-next,
  .pdp-gallery-carousel__swiper--main .swiper-button-prev {
    display: none !important;
  }

  @media (width >= 48rem) {
    .pdp-gallery-carousel {
      /*!
      When a Swiper sits inside a flex container with flex-direction: row, its children can shrink or grow horizontally,
      so you should give the Swiper a fixed size (using width, max-width, or flex: 0 0 <width>) to keep slide sizing stable.
      In a flex column or a normal block layout the element naturally fills the available width, so explicit width is usually not needed.

      That's why we only add max-width on desktop breakpoint because we only use flex container in desktop view

      NOTE: OR JUST ADD A (MIN-WIDTH: 0) OF THE PARENT ELEMENT THAT INSIDE OF THAT FLEX OR GRID ELEMENT.
      WHY THIS WORK: FLEX ITEMS HAVE A DEFAULT (MIN-WIDTH: AUTO), WHICH PREVENTS THEM FROM SHRINKING BELOW THEIR CONTENT SIZE. SETTING (MIN-WIDTH: 0) ALLOWS THE FLEX ITEM TO SHRINK PROPERLY.
      */
      {% comment %} max-width: 598px; {% endcomment %}
    }

    .pdp-gallery-carousel__swiper--main {
      height: 624px;
    }

    .pdp-gallery-carousel__swiper--thumbs.slides-3 {
      height: 172px;
    }

    .pdp-gallery-carousel__swiper--thumbs.slides-4 {
      height: 152px;
    }
  }

  @media (width >= 48rem) and (width < 64rem) {
    .pdp-gallery-carousel__swiper--main {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .pdp-gallery-carousel__swiper--main .swiper-slide img,
    .pdp-gallery-carousel__swiper--main .swiper-slide video,
    .pdp-gallery-carousel__swiper--main .swiper-slide .responsive-video,
    .pdp-gallery-carousel__swiper--main .swiper-slide [data-target='video-source'] {
      object-fit: contain;
    }

    .pdp-gallery-carousel__swiper--thumbs .swiper-slide img,
    .pdp-gallery-carousel__swiper--thumbs .swiper-slide video,
    .pdp-gallery-carousel__swiper--thumbs .swiper-slide .responsive-video,
    .pdp-gallery-carousel__swiper--thumbs .swiper-slide [data-target='video-source'] {
      object-fit: contain;
      object-position: center;
    }
  }
</style>

<div id="MediaGallery-{{ section.id }}" class="pdp-gallery-carousel">
  <!-- Main Swiper -->
  <div class="swiper pdp-gallery-carousel__swiper--main">
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div class="swiper-slide" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <a
                href="{{ media.preview_image | image_url: width: media.preview_image.width }}"
                class="pswp-link"
                data-pswp-width="{{ media.preview_image.width }}"
                data-pswp-height="{{ media.preview_image.height }}"
                aria-label="Open full-screen gallery"
                aria-haspopup="dialog"
              >
                {% render 'responsive-image',
                  image: media,
                  desktop_aspect_ratio: 'adapt',
                  desktop_enable_custom_dimension: true,
                  desktop_custom_height: '100%',
                  desktop_custom_width: '100%'
                %}
              </a>
            {%- when 'video', 'external_video' -%}
              {% comment %} {{ media | media_tag: image_size: '1000x' }} {% endcomment %}
              {% render 'responsive-video',
                video: media,
                desktop_aspect_ratio: 'adapt',
                desktop_enable_custom_dimension: true,
                desktop_custom_height: '100%',
                desktop_custom_width: '100%'
              %}
            {%- when 'model' -%}
              {{ media | media_tag: image_size: '1000x' }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>

  <!-- Thumbs Swiper -->
  <div thumbsSlider="" class="swiper pdp-gallery-carousel__swiper--thumbs">
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div class="swiper-slide" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{ media | image_url: width: 200 | image_tag }}
            {%- when 'video', 'external_video' -%}
              {{ media | media_tag: image_size: '200x' }}
            {%- when 'model' -%}
              {{ media.preview_image | image_url: width: 200 | image_tag }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


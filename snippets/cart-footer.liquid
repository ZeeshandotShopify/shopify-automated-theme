{% doc %}
  Renders the cart drawer footer: the estimated total, the checkout button and
  the accepted payment marks.

  @example
  {% render 'cart-footer' %}
{% enddoc %}

<div class="cart-footer">
  {%- if settings.show_price_in_checkout_button -%}
    <p class="cart-footer__note">{{ 'cart.taxes_and_shipping' | t }}</p>
  {%- else -%}
    <div class="cart-footer__summary">
      <div class="cart-footer__summary-labels">
        <p class="cart-footer__summary-title">{{ 'cart.estimated_total' | t }}</p>
        <p class="cart-footer__summary-note">{{ 'cart.taxes_and_shipping' | t }}</p>
      </div>

      <div class="cart-footer__summary-total cart-summary-total">
        <span class="cart-footer__summary-amount">{{ cart.total_price | money }}</span>

        {%- if cart.total_discount > 0 -%}
          <s class="cart-footer__summary-compare">{{ cart.original_total_price | money }}</s>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="cart-footer__checkout">
    <button
      type="submit"
      name="checkout"
      form="cart-drawer-checkout-form"
      class="cart-checkout"
      aria-label="{{ settings.checkout_label | default: 'Checkout' }}"
    >
      {%- if settings.show_icon_in_checkout_button -%}
        {{- settings.checkout_icon -}}
      {%- endif -%}

      {{- settings.checkout_label -}}

      {%- if settings.show_price_in_checkout_button -%}
        <span class="cart-summary-total-in-checkout">
          {{- cart.total_price | money -}}
        </span>
      {%- endif -%}
    </button>

    <div class="payment-type">
      {% render 'payment-type' %}
    </div>
  </div>
</div>

{%- stylesheet -%}
  .cart-drawer-sheet-footer .cart-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* 12px */
    padding: 1rem; /* 16px */
  }

  .cart-drawer-sheet-footer .cart-footer__summary {
    display: flex;
    align-items: flex-start;
    gap: 2rem; /* 32px */
    line-height: 1.4;
  }

  .cart-drawer-sheet-footer .cart-footer__summary-labels {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* 8px */
  }

  .cart-drawer-sheet-footer .cart-footer__summary-title {
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-add-to-cart-background, #c95136);
  }

  .cart-drawer-sheet-footer .cart-footer__summary-note,
  .cart-drawer-sheet-footer .cart-footer__note {
    font-family: var(--font-body--family);
    font-size: 0.875rem; /* 14px */
    line-height: 1.4;
    font-weight: 300;
    color: var(--color-muted-foreground, #737373);
    /* The design breaks after "Calculated"; the locale string carries the break. */
    white-space: pre-line;
  }

  .cart-drawer-sheet-footer .cart-footer__note {
    text-align: center;
  }

  .cart-drawer-sheet-footer .cart-footer__summary-total {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-popover-foreground, #111111);
    white-space: nowrap;
  }

  .cart-drawer-sheet-footer .cart-footer__summary-compare {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted-foreground, #737373);
  }

  .cart-drawer-sheet-footer .cart-footer__checkout {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cart-checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem; /* 12px */
    width: 100%;
    height: 56px;
    padding: 0.5rem 1rem;
    border-radius: var(--button-border-radius, 0.25rem);
    background: var(--color-checkout-background);
    color: var(--color-checkout-foreground);
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 600;
    cursor: pointer;
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }

  .cart-checkout:hover {
    background: var(--color-checkout-hover-background);
    color: var(--color-checkout-hover-foreground);
  }

  /* The stored checkout icon hardcodes white; recolour it to the button's own
     foreground so it matches the label exactly. */
  .cart-checkout svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .cart-checkout svg [fill]:not([fill='none']) {
    fill: currentColor;
  }

  .cart-checkout svg [stroke]:not([stroke='none']) {
    stroke: currentColor;
  }

  .cart-summary-total-in-checkout::before {
    content: '•';
    margin-right: 0.625rem;
  }

  .cart-drawer-sheet-footer .payment-type {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 1rem; /* 16px */
  }

  /* Drawer-only sizing for the shared payment-type snippet: one row of 32px
     marks. Shopify's marks are 38x24, so the svg keeps its own ratio inside
     the 32px box rather than being stretched square. */
  /* payment-type wraps its list in a plain div; it has to give too. */
  .cart-drawer-sheet-footer .payment-type > * {
    min-width: 0;
    width: 100%;
  }

  .cart-drawer-sheet-footer .payment-type .list-payment {
    flex-wrap: nowrap;
    gap: 0.5rem; /* 8px */
    min-width: 0;
  }

  .cart-drawer-sheet-footer .payment-type .list-payment-item {
    width: 2rem !important; /* 32px */
    height: 2rem; /* 32px */
    /* This store enables ten payment types; at 390px they need to give a
       little to stay on one row. */
    min-width: 0;
  }

  .cart-drawer-sheet-footer .payment-type .list-payment-item svg {
    width: 100%;
    height: auto;
  }

  @media (width >= 64rem) {
    .cart-drawer-sheet-footer .cart-footer {
      gap: 1.5rem; /* 24px */
      padding: 1.5rem; /* 24px */
      /* inset shadow, not a border: the design's footer height includes the rule */
      box-shadow: inset 0 1px 0 var(--color-border, #e5e7eb);
    }

    .cart-drawer-sheet-footer .cart-footer__summary-title {
      color: var(--color-muted-foreground, #737373);
    }

    .cart-drawer-sheet-footer .cart-footer__checkout {
      gap: 0.5rem; /* 8px */
    }

    .cart-drawer-sheet-footer .payment-type {
      padding-block: 0.25rem; /* 4px */
      padding-top: 0.25rem;
    }

    /* The design's desktop payment strip is 27px tall; Shopify's 38x24 marks
       keep their own ratio inside it. */
    .cart-drawer-sheet-footer .payment-type .list-payment-item {
      height: 27px;
    }
  }
{%- endstylesheet -%}

{%- liquid
  assign image = image

  assign unique_suffix = block.id | default: section.id
  assign id = 'responsive-image-' | append: image.id | append: unique_suffix

  assign alt = image.alt | default: 'Image' | escape
  assign object_fit = object_fit | default: 'cover'

  assign enable_mobile_size = enable_mobile_size | default: false
  assign mobile_aspect_ratio = mobile_aspect_ratio | default: 'auto'
  assign mobile_enable_custom_dimension = mobile_enable_custom_dimension | default: false
  assign mobile_custom_width = mobile_custom_width | default: '100%'
  assign mobile_custom_height = mobile_custom_height | default: '100%'

  assign desktop_aspect_ratio = desktop_aspect_ratio | default: 'auto'
  assign desktop_enable_custom_dimension = desktop_enable_custom_dimension | default: false
  assign desktop_custom_width = desktop_custom_width | default: '100%'
  assign desktop_custom_height = desktop_custom_height | default: '100%'

  assign border_mode = border_mode | default: 'inherit'

  assign mobile_border_top_left_radius = mobile_border_top_left_radius | default: '0'
  assign mobile_border_top_right_radius = mobile_border_top_right_radius | default: '0'
  assign mobile_border_bottom_left_radius = mobile_border_bottom_left_radius | default: '0'
  assign mobile_border_bottom_right_radius = mobile_border_bottom_right_radius | default: '0'

  assign desktop_border_top_left_radius = desktop_border_top_left_radius | default: '0'
  assign desktop_border_top_right_radius = desktop_border_top_right_radius | default: '0'
  assign desktop_border_bottom_left_radius = desktop_border_bottom_left_radius | default: '0'
  assign desktop_border_bottom_right_radius = desktop_border_bottom_right_radius | default: '0'

  comment
    Lazy loading - can be controlled via theme settings or parameter
  endcomment
  assign lazy_loading = lazy_loading | default: true

  comment
    Priority for fetchpriority attribute (high, low, auto)
  endcomment
  assign fetchpriority = fetchpriority | default: 'auto'

  comment
    Sizes parameter - define responsive image sizes
    Default: 400,800,1200,1600 for responsive layouts
  endcomment
  unless sizes
    assign sizes = '400,800,1200,1600'
  endunless

  comment
    Generate srcset for responsive images
  endcomment
  capture srcset
    assign image_sizes = sizes | split: ','

    for size in image_sizes
      assign size_trimmed = size | strip

      echo image | image_url: width: size_trimmed
      echo ' '
      echo size_trimmed
      echo 'w'

      unless forloop.last
        echo ', '
      endunless
    endfor
  endcapture

  assign srcset_clean = srcset | strip | split: ',' | join: ', '
  assign srcset_clean_length = srcset_clean | size | minus: 1
  assign srcset_final = srcset_clean | slice: 0, srcset_clean_length

  comment
    Determine initial src - use 20px placeholder for lazy load
  endcomment
  if lazy_loading
    assign initial_src = image | image_url: width: 20
  else
    assign image_sizes = sizes | split: ','
    assign first_size = image_sizes[0] | strip
    assign initial_src = image | image_url: width: first_size
  endif
-%}

{%- style -%}
  #{{ id }} {
    --object-fit: {{ object_fit }};

    /* Always define both mobile and desktop CSS vars */

    {%- if enable_mobile_size -%}
      --mobile-aspect-ratio: {{ mobile_aspect_ratio }};
    {%- endif -%}

    --desktop-aspect-ratio: {{ desktop_aspect_ratio }};

    {%- if mobile_enable_custom_dimension and enable_mobile_size -%}
      --mobile-width: {{ mobile_custom_width }};
      --mobile-height: {{ mobile_custom_height }};
    {%- endif -%}

    {%- if desktop_enable_custom_dimension -%}
      --desktop-width: {{ desktop_custom_width }};
      --desktop-height: {{ desktop_custom_height }};
    {%- endif -%}

    {%- if border_mode == 'custom' -%}
      --border-tl: {{ mobile_border_top_left_radius }};
      --border-tr: {{ mobile_border_top_right_radius }};
      --border-bl: {{ mobile_border_bottom_left_radius }};
      --border-br: {{ mobile_border_bottom_right_radius }};
    {%- endif -%}

    display: block;
    position: relative;
    overflow: hidden;

    /* Mobile: Use mobile vars if enable_mobile_size is true, otherwise use desktop vars */
    {%- if enable_mobile_size -%}
      {%- if mobile_enable_custom_dimension -%}
        width: var(--mobile-width);
        height: var(--mobile-height);
      {%- endif -%}
      aspect-ratio: var(--mobile-aspect-ratio);
    {%- else -%}
      {%- if desktop_enable_custom_dimension -%}
        width: var(--desktop-width);
        height: var(--desktop-height);
      {%- endif -%}
      aspect-ratio: var(--desktop-aspect-ratio);
    {%- endif -%}

    {%- if border_mode == 'inherit' -%}
      border-radius: var(--image-border-radius);
    {%- else -%}
      border-top-left-radius: var(--border-tl);
      border-top-right-radius: var(--border-tr);
      border-bottom-left-radius: var(--border-bl);
      border-bottom-right-radius: var(--border-br);
    {%- endif -%}
  }

  /*
  #{{ id }} > *,
  #{{ id }} img,
  #{{ id }} .image-placeholder {
    {%- if border_mode == 'inherit' -%}
      border-radius: var(--image-border-radius);
    {%- else -%}
      border-top-left-radius: var(--border-tl);
      border-top-right-radius: var(--border-tr);
      border-bottom-left-radius: var(--border-bl);
      border-bottom-right-radius: var(--border-br);
    {%- endif -%}
  }
  */

  .responsive-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--object-fit);
  }

  .responsive-image.lazyload,
  .responsive-image.lazyloading {
    filter: blur(8px);
    transform: scale(1.02);
    transition: filter 0.4s ease-in-out, transform 0.4s ease-in-out;
  }

  .responsive-image.lazyloaded {
    filter: blur(0);
    transform: scale(1);
  }

  .responsive-image.no-blur {
    filter: none;
    transform: none;
  }

  .image-placeholder {
    background: var(--color-primary-background);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-width: 150px;
    min-height: 150px;
  }

  .image-placeholder svg {
    color: var(--color-primary-foreground);
    fill: var(--color-primary-foreground);
  }

  @media (width >= 64rem) {
    #{{ id }} {
      {%- if border_mode == 'custom' -%}
        --border-tl: {{ desktop_border_top_left_radius }};
        --border-tr: {{ desktop_border_top_right_radius }};
        --border-bl: {{ desktop_border_bottom_left_radius }};
        --border-br: {{ desktop_border_bottom_right_radius }};
      {%- endif -%}

      {%- if desktop_enable_custom_dimension -%}
        width: var(--desktop-width);
        height: var(--desktop-height);
      {%- else -%}
        width: auto;
        height: auto;
      {%- endif -%}
       aspect-ratio: var(--desktop-aspect-ratio);

      {%- if border_mode == 'inherit' -%}
        border-radius: var(--image-border-radius);
      {%- else -%}
        border-top-left-radius: var(--border-tl);
        border-top-right-radius: var(--border-tr);
        border-bottom-left-radius: var(--border-bl);
        border-bottom-right-radius: var(--border-br);
      {%- endif -%}
    }

    /*
    #{{ id }} > *,
    #{{ id }} img,
    #{{ id }} .image-placeholder {
      {%- if border_mode == 'inherit' -%}
        border-radius: var(--image-border-radius);
      {%- else -%}
        border-top-left-radius: var(--border-tl-desktop);
        border-top-right-radius: var(--border-tr-desktop);
        border-bottom-left-radius: var(--border-bl-desktop);
        border-bottom-right-radius: var(--border-br-desktop);
      {%- endif -%}
    }
    */
  }
{%- endstyle -%}

<div
  id="{{ id }}"
  {{ shopify_attributes }}
>
  {%- if image -%}
    <img
      class="responsive-image {% if lazy_loading %}lazyload{% else %}no-blur{% endif %}"
      width="{{ image.width }}"
      height="{{ image.height }}"
      {% if lazy_loading %}
        src="{{ initial_src }}"
        data-src="{{ image | image_url: width: 1200 }}"
        data-srcset="{{ srcset_final }}"
        data-sizes="auto"
        loading="lazy"
      {% else %}
        src="{{ initial_src }}"
        srcset="{{ srcset_final }}"
        sizes="auto"
        loading="eager"
      {% endif %}
      fetchpriority="{{ fetchpriority }}"
      alt="{{ alt }}"
    >
  {%- else -%}
    <div class="image-placeholder">
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {%- endif -%}
</div>

{% comment %}
  {% liquid
    assign image = image
    assign alt = image.alt | default: 'Image' | escape
    assign image_ratio = image_ratio | default: 'square'
    assign object_fit = object_fit | default: 'cover'
    assign border_mode = border_mode | default: 'inherit'
    assign desktop_border_top_left_radius = desktop_border_top_left_radius | default: '0'
    assign desktop_border_top_right_radius = desktop_border_top_right_radius | default: '0'
    assign desktop_border_bottom_left_radius = desktop_border_bottom_left_radius | default: '0'
    assign desktop_border_bottom_right_radius = desktop_border_bottom_right_radius | default: '0'
    assign mobile_border_top_left_radius = mobile_border_top_left_radius | default: '0'
    assign mobile_border_top_right_radius = mobile_border_top_right_radius | default: '0'
    assign mobile_border_bottom_left_radius = mobile_border_bottom_left_radius | default: '0'
    assign mobile_border_bottom_right_radius = mobile_border_bottom_right_radius | default: '0'

    assign ratio = 'auto'
    case image_ratio
      when 'square'
        assign ratio = '1 / 1'
      when 'portrait'
        assign ratio = '3 / 4'
      when 'landscape'
        assign ratio = '4 / 3'
      when 'adapt'
        assign ratio = 'auto'
      when 'unset'
        assign ratio = 'unset'
    endcase

    assign unique_suffix = section.id
    if block.id
      assign unique_suffix = block.id
    endif

    assign image_id_value = image.id
    if image_id_value == blank
      assign image_id_value = 'placeholder-' | append: unique_suffix
    else
      assign image_id_value = image.id | append: '-' | append: unique_suffix
    endif
    assign image_id = 'responsive-image-' | append: image_id_value

    assign image_classes = 'responsive-image'
    if image_ratio == 'custom'
      assign image_classes = image_classes | append: ' custom-dimensions'
    endif
  %}

  <style>
    #{{ image_id }} {
      {%- if image_ratio == 'custom' -%}
        --desktop-width: {{ desktop_width }};
        --desktop-height: {{ desktop_height }};
        --mobile-width: {{ mobile_width }};
        --mobile-height: {{ mobile_height }};
      {%- else -%}
        --ratio: {{ ratio }};
      {%- endif -%}
      --fit: {{ object_fit }};

      {%- if border_mode == 'inherit' -%}
         --border-radius: var(--image-border-radius);
      {%- else -%}
        --desktop-border-top-left-radius: {{ desktop_border_top_left_radius }};
        --desktop-border-top-right-radius: {{ desktop_border_top_right_radius }};
        --desktop-border-bottom-left-radius: {{ desktop_border_bottom_left_radius }};
        --desktop-border-bottom-right-radius: {{ desktop_border_bottom_right_radius }};
        --mobile-border-top-left-radius: {{ mobile_border_top_left_radius }};
        --mobile-border-top-right-radius: {{ mobile_border_top_right_radius }};
        --mobile-border-bottom-left-radius: {{ mobile_border_bottom_left_radius }};
        --mobile-border-bottom-right-radius: {{ mobile_border_bottom_right_radius }};
      {%- endif -%}
    }

    #{{ image_id }}.responsive-image {
      {%- if image_ratio != 'custom' -%}
        aspect-ratio: var(--ratio);
      {%- endif -%}
      object-fit: var(--fit);

      {%- if border_mode == 'inherit' -%}
        border-radius: var(--border-radius);
      {%- else -%}
        border-top-left-radius: var(--mobile-border-top-left-radius);
        border-top-right-radius: var(--mobile-border-top-right-radius);
        border-bottom-left-radius: var(--mobile-border-bottom-left-radius);
        border-bottom-right-radius: var(--mobile-border-bottom-right-radius);
      {%- endif -%}
    }

    #{{ image_id }}.responsive-image.custom-dimensions {
      width: var(--mobile-width);
      height: var(--mobile-height);
      aspect-ratio: unset;
    }

    @media (width >= 64rem) {
      #{{ image_id }}.responsive-image {
        {%- if border_mode == 'inherit' -%}
          border-radius: var(--border-radius);
        {%- else -%}
          border-top-left-radius: var(--desktop-border-top-left-radius);
          border-top-right-radius: var(--desktop-border-top-right-radius);
          border-bottom-left-radius: var(--desktop-border-bottom-left-radius);
          border-bottom-right-radius: var(--desktop-border-bottom-right-radius);
        {%- endif -%}
      }

      #{{ image_id }}.responsive-image.custom-dimensions {
        width: var(--desktop-width);
        height: var(--desktop-height);
        aspect-ratio: unset;
      }
    }

    .image-placeholder {
      min-width: 150px;
      min-height: 150px;
      width: 100%;
      height: 100%;
      background: var(--color-primary-background);
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1 / 1;
    }

    .image-placeholder svg {
      color: var(--color-primary-foreground);
      fill: var(--color-primary-foreground);
    }
  </style>

  {% if image %}
    {{ image
      | image_url: width: 1200
      | image_tag:
        id: image_id,
        class: image_classes,
        loading: 'lazy',
        alt: alt
    }}
  {% else %}
    <div
      id="{{ image_id }}"
      class="image-placeholder"
    >
      {{ 'image' | placeholder_svg_tag }}
    </div>
  {% endif %}
{% endcomment %}


{% doc %}
  Renders product option values for a variant selector input group.

  @param {object} option - Current product option.
  @param {string} picker_type - Picker style: swatch, button, or dropdown.
  @param {string} [product_form_id] - Product form id passed through to child inputs.

  @example
  {% render 'product-variant-options', option: option, picker_type: 'button', product_form_id: product_form_id %}
{% enddoc %}

{%- if option != blank and picker_type != blank -%}
  {%- for value in option.values -%}
    {%- liquid
      if value.swatch.image
        assign image_url = value.swatch.image | image_url: width: 50
        assign swatch_value = 'url(' | append: image_url | append: ')'
      elsif value.swatch.color
        assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
      else
        assign swatch_value = null
      endif

      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif
    -%}

    {%- capture input_id -%}
    {{ value.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

    {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

    {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
  {%- endcapture -%}

    {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      Sold Out
    </span>
  {%- endcapture -%}

    {%- if picker_type == 'swatch' -%}
      {%- if swatch_value -%}
        {%- capture help_text -%}
        <span class="visually-hidden">{{ value | escape }}</span>
        {{ label_unavailable }}
      {%- endcapture -%}

        {% render 'swatch-input',
          id: input_id,
          name: input_name,
          value: value,
          swatch: value.swatch,
          product_form_id: product_form_id,
          checked: value.selected,
          visually_disabled: option_disabled,
          help_text: help_text,
          additional_props: input_dataset
        %}
      {%- else -%}
        {% render 'pill-input',
          id: input_id,
          name: input_name,
          value: value,
          product_form_id: product_form_id,
          checked: value.selected,
          visually_disabled: option_disabled,
          label_unavailable: label_unavailable,
          additional_props: input_dataset
        %}
      {%- endif -%}
    {%- elsif picker_type == 'button' -%}
      {% render 'pill-input',
        id: input_id,
        name: input_name,
        value: value,
        product_form_id: product_form_id,
        checked: value.selected,
        visually_disabled: option_disabled,
        label_unavailable: label_unavailable,
        additional_props: input_dataset
      %}
    {%- elsif picker_type == 'dropdown' -%}
      {% render 'dropdown-select',
        id: input_id,
        value: value,
        checked: value.selected,
        visually_disabled: option_disabled,
        additional_props: input_dataset
      %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% doc %}
  Renders the cart drawer's desktop recommendation rail — a 184px column that
  sits flush against the drawer's left edge once the drawer is open. Hidden
  below 64rem, where the in-flow carousel is used instead.

  @param {number} product_id - The product the recommendations are based on

  @example
  {% render 'cart-product-recommendations-desktop', product_id: cart.items.last.product_id %}
{% enddoc %}

<cart-product-recommendations-desktop
  class="cart-product-recommendations-desktop-wrapper"
  data-product-id="{{ product_id }}"
  data-section-id="{{ section.id }}"
  data-target="cart-product-recommendations-desktop-container"
  data-limit="{{ settings.number_of_products_to_show }}"
  data-intent="{{ settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="cart-product-recommendations-desktop-container">
      <div class="cart-product-recommendations-desktop">
        <h2 class="cart-product-recommendations-heading-desktop">
          {%- if settings.intent == 'complementary' -%}
            {{ settings.heading_complementary | default: 'Pair it with' }}
          {%- else -%}
            {{ settings.heading_related | default: 'You may also like' }}
          {%- endif -%}
        </h2>

        <ul class="cart-product-recommendations-list-desktop" role="list">
          {%- for product in recommendations.products -%}
            <li>
              <a href="{{ product.url }}" class="product-recommendations-item-link-desktop">
                <div class="cart-product-recommendations-item-image-wrapper-desktop">
                  {{
                    product.featured_image
                    | image_url: width: 248, height: 248, crop: 'center'
                    | image_tag:
                      alt: product.featured_image.alt,
                      loading: 'lazy',
                      class: 'cart-product-recommendations-item-image-desktop'
                  }}
                </div>

                <div class="cart-product-recommendations-item-details-desktop">
                  <h3 class="cart-product-recommendations-item-title-desktop">{{- product.title -}}</h3>

                  <div class="cart-product-recommendations-item-price-wrapper-desktop">
                    {%- assign current_variant = product.selected_or_first_available_variant -%}

                    <span class="cart-product-recommendations-item-price-desktop">
                      {{- current_variant.price | money -}}
                    </span>

                    {%- if current_variant.compare_at_price > current_variant.price -%}
                      <s class="cart-product-recommendations-item-compare-at-price-desktop">
                        {{- current_variant.compare_at_price | money -}}
                      </s>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</cart-product-recommendations-desktop>

{%- stylesheet -%}
  .cart-product-recommendations-desktop-wrapper {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 184px;
    height: 100%;
    margin: 0;
    z-index: -1;
    background: var(--color-background, #ffffff);
    overflow-x: hidden;
    overflow-y: auto;
    /* Keep the rail's content box at the full 184px — a classic scrollbar would
       otherwise take 15px out of it. */
    scrollbar-width: none;
    -ms-overflow-style: none;
    transform: translate(0);
    /* Matches the quick view's gallery. At 0.5s the easing left the rail
       almost still for the first third of its travel, so the beat between it
       and the drawer read as one movement rather than two. */
    transition:
      transform 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
  }

  /* No staging when motion is reduced: the rail cuts to position, and the zero
     duration it reports means the drawer no longer holds its exit either. */
  @media (prefers-reduced-motion: reduce) {
    .cart-product-recommendations-desktop-wrapper {
      transition: none;
    }
  }

  .cart-product-recommendations-desktop-wrapper.active {
    transform: translate(-100%);
  }

  .cart-product-recommendations-desktop-wrapper::-webkit-scrollbar {
    display: none;
  }

  .cart-product-recommendations-desktop-wrapper .cart-product-recommendations-desktop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem; /* 24px */
    padding: 1.5rem 1rem; /* 24px 16px */
  }

  .cart-product-recommendations-heading-desktop {
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 400;
    color: var(--color-popover-foreground, #111111);
    text-align: center;
  }

  .cart-product-recommendations-list-desktop {
    display: flex;
    flex-direction: column;
    gap: 2.5rem; /* 40px */
    width: 100%;
  }

  .product-recommendations-item-link-desktop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem; /* 12px */
  }

  .cart-product-recommendations-item-image-wrapper-desktop {
    position: relative;
    width: 124px;
    height: 124px;
    border-radius: var(--image-border-radius, 0);
    overflow: hidden;
    background: var(--color-muted-background, #f5f5f5);
  }

  .cart-product-recommendations-item-image-desktop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-product-recommendations-item-details-desktop {
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* 4px */
    width: 100%;
    text-align: center;
  }

  .cart-product-recommendations-item-title-desktop {
    font-family: var(--font-body--family);
    font-size: 0.875rem; /* 14px */
    line-height: 1.4;
    font-weight: 400;
    color: var(--color-popover-foreground, #111111);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-product-recommendations-item-price-wrapper-desktop {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.375rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem; /* 14px */
    line-height: 1.4;
    color: var(--color-popover-foreground, #111111);
  }

  .cart-product-recommendations-item-compare-at-price-desktop {
    font-size: 0.75rem; /* 12px */
    color: var(--color-muted-foreground, #737373);
  }

  @media (width >= 64rem) {
    .cart-product-recommendations-desktop-wrapper {
      display: block;
    }
  }
{%- endstylesheet -%}

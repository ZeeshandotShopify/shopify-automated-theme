        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">LinkedIn</span>
        {% endif %}
        <span class="sr-only">Share on LinkedIn</span>
      </a>
    {% endif %}

    {%- comment -%} Pinterest Share {%- endcomment -%}
    {% if settings.social_share_pinterest %}
      <a
        href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ share_image }}&description={{ share_title }}"
        class="article-share__button {{ style_class }} article-share__button--pinterest"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Pin on Pinterest (opens in new tab)"
        title="Pin on Pinterest"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >

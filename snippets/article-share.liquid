        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Facebook</span>
        {% endif %}
        <span class="sr-only">Share on Facebook</span>
      </a>
    {% endif %}

    {%- comment -%} X (Twitter) Share {%- endcomment -%}
    {% if settings.social_share_twitter %}
      <a
        href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}"
        class="article-share__button {{ style_class }} article-share__button--twitter"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X (opens in new tab)"
        title="Share on X"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"

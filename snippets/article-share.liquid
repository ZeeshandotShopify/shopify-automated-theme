        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">X</span>
        {% endif %}
        <span class="sr-only">Share on X</span>
      </a>
    {% endif %}

    {%- comment -%} LinkedIn Share {%- endcomment -%}
    {% if settings.social_share_linkedin %}
      <a
        href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}"
        class="article-share__button {{ style_class }} article-share__button--linkedin"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on LinkedIn (opens in new tab)"
        title="Share on LinkedIn"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"

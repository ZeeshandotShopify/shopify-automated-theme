        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Reddit</span>
        {% endif %}
        <span class="sr-only">Share on Reddit</span>
      </a>
    {% endif %}

    {%- comment -%} WhatsApp Share {%- endcomment -%}
    {% if settings.social_share_whatsapp %}
      <a
        href="https://api.whatsapp.com/send?text={{ share_title }}%20{{ share_url }}"
        class="article-share__button {{ style_class }} article-share__button--whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share via WhatsApp (opens in new tab)"
        title="Share via WhatsApp"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M12.5026 2H12.4974C6.70795 2 2.00001 6.70924 2.00001 12.5C1.99642 14.7116 2.69649 16.8669 3.99895 18.6543L2.69039 22.555L6.72632 21.2649C8.43831 22.4007 10.4481 23.0044 12.5026 23C18.2921 23 23 18.2894 23 12.5C23 6.71056 18.2921 2 12.5026 2ZM18.6123 16.8273C18.359 17.5426 17.3536 18.1359 16.5517 18.3091C16.0031 18.4259 15.2864 18.5191 12.8741 17.519C9.78838 16.2406 7.80126 13.105 7.64638 12.9016C7.49807 12.6982 6.39951 11.2413 6.39951 9.73455C6.39951 8.22781 7.1647 7.49412 7.47313 7.17912C7.72645 6.92056 8.14513 6.80243 8.54676 6.80243C8.6767 6.80243 8.79351 6.80899 8.89851 6.81424C9.20695 6.82737 9.36182 6.84574 9.56526 7.33268C9.81857 7.94299 10.4354 9.44974 10.5089 9.60462C10.5838 9.75949 10.6586 9.96949 10.5536 10.1729C10.4551 10.3829 10.3685 10.4761 10.2136 10.6546C10.0588 10.8331 9.91176 10.9696 9.75688 11.1612C9.61513 11.3279 9.45501 11.5064 9.63351 11.8149C9.81201 12.1167 10.4289 13.1234 11.3371 13.9319C12.5092 14.9754 13.4594 15.3087 13.7994 15.4505C14.0527 15.5555 14.3546 15.5305 14.5396 15.3337C14.7746 15.0804 15.0646 14.6604 15.3599 14.2469C15.5699 13.9503 15.8351 13.9135 16.1133 14.0185C16.3968 14.117 17.897 14.8585 18.2054 15.0121C18.5139 15.167 18.7173 15.2405 18.7921 15.3704C18.8656 15.5004 18.8656 16.1107 18.6123 16.8273Z"/>
        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">WhatsApp</span>
        {% endif %}
        <span class="sr-only">Share via WhatsApp</span>
      </a>
    {% endif %}

    {%- comment -%} Telegram Share {%- endcomment -%}
    {% if settings.social_share_telegram %}
      <a
        href="https://t.me/share/url?url={{ share_url }}&text={{ share_title }}"
        class="article-share__button {{ style_class }} article-share__button--telegram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share via Telegram (opens in new tab)"
        title="Share via Telegram"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM16.64 8.8C16.49 10.38 15.84 14.22 15.51 15.99C15.37 16.74 15.09 16.99 14.83 17.02C14.25 17.07 13.81 16.64 13.25 16.27C12.37 15.69 11.87 15.33 11.02 14.77C10.03 14.12 10.67 13.76 11.24 13.18C11.39 13.03 13.95 10.7 14 10.49C14.007 10.457 14.006 10.423 13.996 10.39C13.986 10.358 13.969 10.329 13.946 10.306C13.88 10.25 13.79 10.27 13.71 10.28C13.61 10.3 12.13 11.24 9.26 13.1C8.86 13.38 8.5 13.52 8.18 13.51C7.83 13.51 7.15 13.32 6.65 13.16C6.03 12.96 5.54 12.85 5.58 12.51C5.6 12.33 5.85 12.15 6.33 11.97C9.42 10.63 11.48 9.74 12.52 9.32C15.45 8.1 16.03 7.89 16.41 7.89C16.49 7.89 16.68 7.91 16.8 8.01C16.9 8.1 16.93 8.22 16.94 8.31C16.93 8.37 16.95 8.56 16.94 8.8H16.64Z"/>
        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Telegram</span>
        {% endif %}
        <span class="sr-only">Share via Telegram</span>
      </a>
    {% endif %}

    {%- comment -%} Email Share {%- endcomment -%}
    {% if settings.social_share_email %}
      {%- liquid
        assign email_subject = settings.social_share_email_subject | default: 'Check out: {title}'
        assign email_subject = email_subject | replace: '{title}', article.title | url_encode
        assign email_body = settings.social_share_email_body | default: 'I thought you might like this: {url}'
        assign email_body = email_body | replace: '{title}', article.title | replace: '{url}', shop.url | append: article.url | url_encode
      -%}
      <a
        href="mailto:?subject={{ email_subject }}&body={{ email_body }}"
        class="article-share__button {{ style_class }} article-share__button--email"
        aria-label="Share via Email"
        title="Share via Email"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM18 15C18 15.55 17.55 16 17 16H7C6.45 16 6 15.55 6 15V9.62L11.55 13.03C11.7 13.12 11.85 13.17 12 13.17C12.15 13.17 12.3 13.12 12.45 13.03L18 9.62V15ZM18 8.24L12 11.91L6 8.24V9C6 8.45 6.45 8 7 8H17C17.55 8 18 8.45 18 9V8.24Z"/>
        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Email</span>
        {% endif %}
        <span class="sr-only">Share via Email</span>
      </a>
    {% endif %}

    {%- comment -%} Copy to Clipboard {%- endcomment -%}
    {% if settings.social_share_clipboard %}
      <button
        type="button"
        class="article-share__button {{ style_class }} article-share__button--copy"
        data-share-copy
        data-share-url="{{ shop.url }}{{ article.url }}"
        aria-label="Copy link to clipboard"
        title="Copy link"
      >
        <svg
          class="article-share__icon-copy"
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M14 1.25H5C3.48122 1.25 2.25 2.48122 2.25 4V14.857C2.25 16.3758 3.48122 17.607 5 17.607H14C15.5188 17.607 16.75 16.3758 16.75 14.857V4C16.75 2.48122 15.5188 1.25 14 1.25Z"/>
          <path d="M21.7501 9V20C21.7504 20.3612 21.6794 20.7189 21.5413 21.0527C21.4032 21.3865 21.2007 21.6897 20.9452 21.9451C20.6898 22.2005 20.3866 22.4031 20.0528 22.5412C19.719 22.6793 19.3613 22.7503 19.0001 22.75H9.88012C9.14961 22.7508 8.44864 22.4616 7.93116 21.946C7.41367 21.4304 7.12197 20.7305 7.12012 20V18.61H14.0001C14.994 18.6079 15.9466 18.2121 16.6494 17.5093C17.3522 16.8065 17.748 15.8539 17.7501 14.86V6.25H19.0001C19.3613 6.24974 19.719 6.32069 20.0528 6.4588C20.3866 6.5969 20.6898 6.79946 20.9452 7.05487C21.2007 7.31028 21.4032 7.61355 21.5413 7.94731C21.6794 8.28107 21.7504 8.63879 21.7501 9Z"/>
        </svg>
        <svg
          class="article-share__icon-check"
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          style="display: none;"
        >
          <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"/>
        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Copy</span>
        {% endif %}
        <span class="article-share__tooltip">Copied!</span>
        <span class="sr-only">Copy link to clipboard</span>
      </button>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    'use strict';

    // Initialize share functionality when DOM is ready
    function initShareButtons() {
      // Copy to clipboard functionality
      const copyButtons = document.querySelectorAll('[data-share-copy]');
      copyButtons.forEach(function (button) {
        button.addEventListener('click', function (e) {
          e.preventDefault();
          const url = this.getAttribute('data-share-url');

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard
              .writeText(url)
              .then(function () {
                showCopySuccess(button);
              })
              .catch(function () {
                fallbackCopy(url, button);
              });
          } else {
            fallbackCopy(url, button);
          }
        });
      });

      // Native share functionality (mobile)
      const nativeShareButtons = document.querySelectorAll('[data-share-native]');
      nativeShareButtons.forEach(function (button) {
        if (!navigator.share) {
          button.style.display = 'none';
          return;
        }

        button.addEventListener('click', async function (e) {
          e.preventDefault();
          const shareData = {
            title: this.getAttribute('data-share-title'),
            text: this.getAttribute('data-share-text'),
            url: this.getAttribute('data-share-url'),
          };

          try {
            await navigator.share(shareData);
          } catch (err) {
            // User cancelled or share failed
            console.log('Share cancelled or failed:', err);
          }
        });
      });
    }

    // Fallback copy method for older browsers
    function fallbackCopy(text, button) {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      textArea.style.top = '-9999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();

      try {
        document.execCommand('copy');
        showCopySuccess(button);
      } catch (err) {
        console.error('Copy failed:', err);
      }

      document.body.removeChild(textArea);
    }

    // Show copy success visual feedback
    function showCopySuccess(button) {
      const iconCopy = button.querySelector('.article-share__icon-copy');
      const iconCheck = button.querySelector('.article-share__icon-check');

      button.classList.add('article-share__button--copied');

      if (iconCopy && iconCheck) {
        iconCopy.style.display = 'none';
        iconCheck.style.display = 'block';
      }

      setTimeout(function () {
        button.classList.remove('article-share__button--copied');
        if (iconCopy && iconCheck) {
          iconCopy.style.display = 'block';
          iconCheck.style.display = 'none';
        }
      }, 2000);
    }

    // Initialize on DOMContentLoaded or immediately if already loaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShareButtons);
    } else {
      initShareButtons();
    }
  })();
</script>

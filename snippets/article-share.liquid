{%- comment -%}
  Social Sharing Component
  Provides comprehensive social sharing functionality with:
  - All major social platforms (Facebook, X, LinkedIn, Pinterest, Reddit, WhatsApp, Telegram, Email)
  - Responsive grid layout adapting to screen sizes
  - Accessibility features (aria-labels, focus states, keyboard navigation)
  - Mobile-optimized native share dialog support
  - Customizable icon styles and hover effects
  - Copy to clipboard functionality with visual feedback
{%- endcomment -%}

{%- liquid
  assign share_url = shop.url | append: article.url | url_encode
  assign share_title = article.title | url_encode
  assign share_image = article.image | image_url: width: 1200 | url_encode

  # Icon size mapping
  case settings.social_icon_size
    when 'small'
      assign icon_size = '20'
    when 'large'
      assign icon_size = '32'
    else
      assign icon_size = '24'
  endcase

  # Button spacing
  assign button_spacing = settings.social_button_spacing | default: 12
-%}

{%- style -%}
  /* ===================================
     Social Share Component Styles
     =================================== */

  .article-share {
    --padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --icon-size: {{ icon_size }}px;
    --icon-color: {{ settings.social_icon_color | default: '#374151' }};
    --icon-hover-color: {{ settings.social_icon_hover_color | default: '#111827' }};
    --button-spacing: {{ button_spacing }}px;

    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  /* Label Styling */
  .article-share__label {
    font-size: 0.875rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.8;
  }

  /* Button Container */
  .article-share__buttons {
    display: flex;
    flex-direction: row;
    gap: var(--button-spacing);
    flex-wrap: wrap;
    align-items: center;
  }

  /* Base Button Styles */
  .article-share__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--icon-color);
    background: transparent;
    border-radius: 9999px;
    min-width: 44px;
    min-height: 44px;
  }

  .article-share__button:focus {
    outline: none;
  }

  .article-share__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Icon Styles */
  .article-share__button svg {
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    fill: currentColor;
  }

  .article-share__button:hover svg,
  .article-share__button:focus-visible svg {
    transform: scale(1.15);
  }

  /* Button Labels */
  .article-share__button-label {
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Icon Style Variants */

  /* Filled Circle Style */
  .article-share__button--filled {
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.1 }};
  }

  .article-share__button--filled:hover,
  .article-share__button--filled:focus-visible {
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.2 }};
  }

  /* Outline Style */
  .article-share__button--outline {
    border: 1.5px solid currentColor;
  }

  .article-share__button--outline:hover,
  .article-share__button--outline:focus-visible {
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.1 }};
  }

  /* Minimal Style */
  .article-share__button--minimal {
    padding: 0.375rem;
    min-width: auto;
    min-height: auto;
    border-radius: 0.375rem;
  }

  .article-share__button--minimal:hover,
  .article-share__button--minimal:focus-visible {
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.08 }};
  }

  /* Rounded Square Style */
  .article-share__button--rounded {
    border-radius: 0.5rem;
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.1 }};
  }

  .article-share__button--rounded:hover,
  .article-share__button--rounded:focus-visible {
    background: {{ settings.social_icon_color | default: '#374151' | color_modify: 'alpha', 0.18 }};
    border-radius: 0.75rem;
  }

  /* Brand Color Hover Effects */
  {% if settings.social_use_brand_colors %}
    .article-share__button--facebook:hover,
    .article-share__button--facebook:focus-visible {
      color: #1877f2;
      background: rgba(24, 119, 242, 0.12);
    }

    .article-share__button--twitter:hover,
    .article-share__button--twitter:focus-visible {
      color: #000000;
      background: rgba(0, 0, 0, 0.08);
    }

    .article-share__button--linkedin:hover,
    .article-share__button--linkedin:focus-visible {
      color: #0A66C2;
      background: rgba(10, 102, 194, 0.12);
    }

    .article-share__button--pinterest:hover,
    .article-share__button--pinterest:focus-visible {
      color: #e60023;
      background: rgba(230, 0, 35, 0.12);
    }

    .article-share__button--reddit:hover,
    .article-share__button--reddit:focus-visible {
      color: #FF4500;
      background: rgba(255, 69, 0, 0.12);
    }

    .article-share__button--whatsapp:hover,
    .article-share__button--whatsapp:focus-visible {
      color: #25D366;
      background: rgba(37, 211, 102, 0.12);
    }

    .article-share__button--telegram:hover,
    .article-share__button--telegram:focus-visible {
      color: #0088cc;
      background: rgba(0, 136, 204, 0.12);
    }

    .article-share__button--email:hover,
    .article-share__button--email:focus-visible {
      color: #EA4335;
      background: rgba(234, 67, 53, 0.12);
    }

    .article-share__button--copy:hover,
    .article-share__button--copy:focus-visible {
      color: #6366F1;
      background: rgba(99, 102, 241, 0.12);
    }

    .article-share__button--native:hover,
    .article-share__button--native:focus-visible {
      color: #10B981;
      background: rgba(16, 185, 129, 0.12);
    }
  {% else %}
    .article-share__button:hover,
    .article-share__button:focus-visible {
      color: var(--icon-hover-color);
    }
  {% endif %}

  /* Copy Success State */
  .article-share__button--copied {
    color: #10B981 !important;
    background: rgba(16, 185, 129, 0.15) !important;
  }

  .article-share__button--copied svg {
    animation: copySuccess 0.3s ease-out;
  }

  @keyframes copySuccess {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  /* Tooltip for Copy Success */
  .article-share__tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    background: #111827;
    border-radius: 0.375rem;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    pointer-events: none;
    z-index: 10;
  }

  .article-share__tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #111827;
  }

  .article-share__button--copied .article-share__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Native Share Button - Mobile Only */
  .article-share__button--native {
    display: none;
  }

  @media (max-width: 768px) {
    .article-share__button--native {
      display: inline-flex;
    }
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {

    .article-share__button {
      min-width: 40px;
      min-height: 40px;
      padding: 0.5rem;
    }

    .article-share__button-label {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  # Determine icon style class
  assign style_class = 'article-share__button--minimal'
  case settings.social_icon_style
    when 'filled'
      assign style_class = 'article-share__button--filled'
    when 'outline'
      assign style_class = 'article-share__button--outline'
    when 'rounded'
      assign style_class = 'article-share__button--rounded'
  endcase
-%}

<div class="article-share" {{ block.shopify_attributes }} role="region" aria-label="Share this article">
  <span class="article-share__label" id="share-label">Share This Article</span>

  <div class="article-share__buttons" role="group" aria-labelledby="share-label">
    {%- comment -%} Native Share Button (Mobile) {%- endcomment -%}
    {% if settings.social_share_native %}
      <button
        type="button"
        class="article-share__button {{ style_class }} article-share__button--native"
        data-share-native
        data-share-url="{{ shop.url }}{{ article.url }}"
        data-share-title="{{ article.title | escape }}"
        data-share-text="{{ article.excerpt | strip_html | truncate: 100 | escape }}"
        aria-label="Share via your device's share menu"
        title="Share"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M18 8C19.6569 8 21 6.65685 21 5C21 3.34315 19.6569 2 18 2C16.3431 2 15 3.34315 15 5C15 5.12548 15.0077 5.24917 15.0227 5.37061L8.08261 9.17026C7.54305 8.46136 6.67378 8 5.7 8C4.04315 8 2.7 9.34315 2.7 11C2.7 12.6569 4.04315 14 5.7 14C6.67378 14 7.54305 13.5386 8.08261 12.8297L15.0227 16.6294C15.0077 16.7508 15 16.8745 15 17C15 18.6569 16.3431 20 18 20C19.6569 20 21 18.6569 21 17C21 15.3431 19.6569 14 18 14C17.0262 14 16.1569 14.4614 15.6174 15.1703L8.67727 11.3706C8.69231 11.2492 8.7 11.1255 8.7 11C8.7 10.8745 8.69231 10.7508 8.67727 10.6294L15.6174 6.82974C16.1569 7.53864 17.0262 8 18 8Z" fill="currentColor"/>
        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Share</span>
        {% endif %}
      </button>
    {% endif %}

    {%- comment -%} Facebook Share {%- endcomment -%}
    {% if settings.social_share_facebook %}
      <a
        href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}"
        class="article-share__button {{ style_class }} article-share__button--facebook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Facebook (opens in new tab)"
        title="Share on Facebook"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >

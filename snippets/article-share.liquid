        </svg>
        {% if settings.social_show_labels %}
          <span class="article-share__button-label">Pinterest</span>
        {% endif %}
        <span class="sr-only">Pin on Pinterest</span>
      </a>
    {% endif %}

    {%- comment -%} Reddit Share {%- endcomment -%}
    {% if settings.social_share_reddit %}
      <a
        href="https://www.reddit.com/submit?url={{ share_url }}&title={{ share_title }}"
        class="article-share__button {{ style_class }} article-share__button--reddit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Reddit (opens in new tab)"
        title="Share on Reddit"
      >
        <svg
          width="{{ icon_size }}"
          height="{{ icon_size }}"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >

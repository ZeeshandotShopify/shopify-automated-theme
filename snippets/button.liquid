{%- liquid
  # Parameters with defaults
  assign type = type | default: 'button'
  assign label = label | default: 'Click me'
  assign variant = variant | default: 'default'
  assign size = size | default: 'default'
  assign icon_mode = icon_mode | default: 'none'
  assign icon_position = icon_position | default: 'left'
  assign full_width = full_width | default: false
  assign disabled = disabled | default: false
  assign hover_effect = hover_effect | default: 'opacity'
  assign space_between = space_between | default: false

  # Build base classes
  assign button_classes = 'btn btn--' | append: variant | append: ' btn--size-' | append: size

  # Add hover effect class
  assign button_classes = button_classes | append: ' btn--hover-' | append: hover_effect

  # Full width (skip for icon-only)
  if full_width and size != 'icon'
    assign button_classes = button_classes | append: ' btn--full'
  endif

  # Space between (for full-width with icon)
  if space_between and full_width
    assign button_classes = button_classes | append: ' btn--space-between'
  endif

  # Icon-only detection
  assign is_icon_only = false
  if size == 'icon' or label == blank
    assign is_icon_only = true
  endif
-%}

{%- comment %} Capture icon HTML using the icon.liquid snippet {%- endcomment %}
{%- capture icon_html -%}
  {%- if icon_mode != 'none' -%}
    {%- render 'icon', icon_mode: icon_mode, icon_select: icon_select, icon_custom: icon_custom -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign icon_html = icon_html | strip -%}

{%- comment %} Build button content {%- endcomment %}
{%- capture button_content -%}
  {%- if is_icon_only -%}
    {{ icon_html }}
  {%- elsif icon_html != blank and icon_position == 'left' -%}
    <span class="btn__icon">{{ icon_html }}</span><span class="btn__label">{{ label }}</span>
  {%- elsif icon_html != blank and icon_position == 'right' -%}
    <span class="btn__label">{{ label }}</span><span class="btn__icon">{{ icon_html }}</span>
  {%- else -%}
    <span class="btn__label">{{ label }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- style -%}
  /* Base Button Styles */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    border-radius: var(--button-border-radius, 0.375rem);
    font-family: var(--button-font-family, inherit);
    font-size: 0.875rem;
    font-weight: var(--button-font-weight, 500);
    text-transform: var(--button-text-case, none);
    transition: all 0.15s ease-in-out;
    cursor: pointer;
    user-select: none;
    position: relative;
    outline: none;
    border: none;
    text-decoration: none;
    overflow: hidden;
  }

  .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease-out;
  }

  .btn__label {
    position: relative;
  }

  .btn svg:not([class*='size-']),
  .btn img:not([class*='size-']) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .btn img:not([class*='size-']) {
    object-fit: contain;
  }

  .btn:disabled {
    pointer-events: none;
    opacity: 0.5;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-ring, hsl(222.2 84% 4.9%));
    outline-offset: 2px;
  }

  .btn[aria-invalid='true'] {
    border-color: var(--color-destructive-background, hsl(0 84.2% 60.2%));
    outline-color: var(--color-destructive-background, hsl(0 84.2% 60.2%));
  }

  /* Variants */
  .btn--default {
    --btn-bg: var(--color-primary-background, hsl(222.2 84% 4.9%));
    --btn-hover-bg: var(--color-primary-hover-background, hsl(222.2 84% 4.9% / 0.9));
    background-color: var(--btn-bg);
    color: var(--color-primary-foreground, hsl(210 40% 98%));
    border: var(--primary-button-border-thickness, 1px) solid var(--color-border, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .btn--default:hover {
    background-color: var(--btn-hover-bg);
    color: var(--color-primary-hover-foreground, hsl(210 40% 98%));
  }

  .btn--destructive {
    --btn-bg: var(--color-destructive-background, hsl(0 84.2% 60.2%));
    --btn-hover-bg: var(--color-destructive-hover-background, hsl(0 84.2% 60.2% / 0.9));
    background-color: var(--btn-bg);
    color: var(--color-destructive-foreground, hsl(210 40% 98%));
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .btn--destructive:hover {
    background-color: var(--btn-hover-bg);
  }

  .btn--outline {
    --btn-bg: transparent;
    --btn-hover-bg: var(--color-outline-hover-background, hsl(210 40% 96%));
    background-color: var(--btn-bg);
    color: var(--color-outline-foreground, hsl(222.2 84% 4.9%));
    border: 1px solid var(--color-border, hsl(214.3 31.8% 91.4%));
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .btn--outline:hover {
    background-color: var(--btn-hover-bg);
    color: var(--color-outline-hover-foreground, hsl(222.2 84% 4.9%));
  }

  .btn--secondary {
    --btn-bg: var(--color-secondary-background, hsl(210 40% 96%));
    --btn-hover-bg: var(--color-secondary-hover-background, hsl(210 40% 96% / 0.8));
    background: var(--btn-bg);
    color: var(--color-secondary-foreground, hsl(222.2 84% 4.9%));
    border: var(--secondary-button-border-thickness, 1px) solid var(--color-border, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .btn--secondary:hover {
    background: var(--btn-hover-bg);
    color: var(--color-secondary-hover-foreground, hsl(222.2 84% 4.9%));
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-hover-bg: var(--color-ghost-hover-background, hsl(210 40% 96%));
    background-color: var(--btn-bg);
    border: var(--ghost-button-border-thickness, 0) solid var(--color-border, transparent);
  }

  .btn--ghost:hover {
    background-color: var(--btn-hover-bg);
    color: var(--color-ghost-hover-foreground, hsl(222.2 84% 4.9%));
  }

  .btn--link {
    --btn-bg: transparent;
    --btn-hover-bg: transparent;
    background-color: var(--btn-bg);
    color: var(--color-link-foreground, hsl(210 40% 98%));
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .btn--link:hover {
    background-color: var(--btn-hover-bg);
    color: var(--color-link-hover-foreground, var(--color-link-foreground, hsl(210 40% 98%)));
    text-decoration: none;
  }

  /* When a link button uses the underline hover effect, the effect's animated
     underline (::after) owns the line — drop the variant's permanent underline
     so the two don't stack into a doubled/mismatched underline. */
  .btn--link.btn--hover-underline {
    text-decoration: none;
  }

  /* Sizes */
  .btn--size-default {
    padding: 16px 40px;
  }

  .btn--size-sm {
    padding-block: 0.5rem;
    padding-inline: 1rem;
    gap: 0.5rem;
  }

  .btn--size-lg {
    height: 2.5rem;
    padding: 0 1.5rem;
  }

  .btn--size-lg:has(> svg) {
    padding-left: 1rem;
  }

  .btn--size-icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
  }

  .btn--full {
    width: 100%;
  }

  .btn--space-between {
    justify-content: space-between;
  }

  /* ===================== */
  /* Hover Effect: None    */
  /* ===================== */
  .btn--hover-none:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--default:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--secondary:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--destructive:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--outline:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--ghost:hover {
    transform: none;
    opacity: 1;
  }

  .btn--hover-none.btn--link:hover {
    transform: none;
    opacity: 1;
  }

  /* ===================== */
  /* Hover Effect: Scale   */
  /* ===================== */
  .btn--hover-scale:hover {
    transform: scale(1.05);
  }

  /* ===================== */
  /* Hover Effect: Opacity */
  /* ===================== */
  .btn--hover-opacity:hover {
    opacity: 0.9;
  }

  /* Prevent background change on slide effects - override hover bg to match normal bg */
  .btn--hover-bg-slide:hover,
  .btn--hover-bg-icon-both:hover,
  .btn--hover-bg-icon-slide-in:hover,
  .btn--hover-bg-icon-fade:hover {
    background-color: var(--btn-bg);
  }

  /* ========================== */
  /* Hover Effect: Background Slide */
  /* ========================== */
  .btn--hover-bg-slide::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--btn-hover-bg);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .btn--hover-bg-slide:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .btn--hover-bg-slide .btn__label,
  .btn--hover-bg-slide .btn__icon {
    position: relative;
    z-index: 1;
  }

  /* ======================== */
  /* Hover Effect: Icon Slide */
  /* ======================== */
  .btn--hover-icon-slide:hover .btn__icon {
    transform: translateX(4px);
  }

  /* ========================= */
  /* Hover Effect: Underline   */
  /* ========================= */
  .btn--hover-underline .btn__label::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.2s ease-out;
  }

  .btn--hover-underline:hover .btn__label::after {
    width: 100%;
  }

  /* ========================= */
  /* Hover Effect: Icon Fade In */
  /* ========================= */
  .btn--hover-icon-fade .btn__icon {
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }

  .btn--hover-icon-fade:hover .btn__icon {
    opacity: 1;
  }

  /* ============================ */
  /* Hover Effect: Icon Slide In  */
  /* ============================ */
  .btn--hover-icon-slide-in .btn__icon {
    opacity: 0;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .btn--hover-icon-slide-in:hover .btn__icon {
    opacity: 1;
    transform: translateX(4px);
  }

  /* ================================== */
  /* Hover Effect: Background + Icon Both */
  /* ================================== */
  .btn--hover-bg-icon-both::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--btn-hover-bg);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .btn--hover-bg-icon-both:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .btn--hover-bg-icon-both .btn__label,
  .btn--hover-bg-icon-both .btn__icon {
    position: relative;
    z-index: 1;
  }

  .btn--hover-bg-icon-both:hover .btn__icon {
    transform: translateX(4px);
  }

  /* ======================================== */
  /* Hover Effect: Background + Icon Slide In */
  /* ======================================== */
  /* Base state: color transition with 0.2s delay (waits for icon, changes with background) */
  .btn--hover-bg-icon-slide-in {
    transition: color 0.35s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
  }

  /* Hover state: immediate color transition */
  .btn--hover-bg-icon-slide-in:hover {
    transition: color 0.15s ease-in-out;
  }

  /* Base state: background has 0.2s delay (waits for icon to exit first) */
  .btn--hover-bg-icon-slide-in::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--btn-hover-bg);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
    z-index: 0;
  }

  /* Hover state: background has no delay (slides in immediately) */
  .btn--hover-bg-icon-slide-in:hover::before {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn--hover-bg-icon-slide-in .btn__label,
  .btn--hover-bg-icon-slide-in .btn__icon {
    position: relative;
    z-index: 1;
  }

  /* Base state: icon has 0.1s delay (exits immediately) */
  .btn--hover-bg-icon-slide-in .btn__icon {
    opacity: 0;
    transition:
      opacity 0.2s ease-out 0.1s,
      transform 0.2s ease-out 0.1s;
  }

  /* Hover state: icon has 0.2s delay (waits for background to enter first) */
  .btn--hover-bg-icon-slide-in:hover .btn__icon {
    opacity: 1;
    transform: translateX(4px);
    transition:
      opacity 0.2s ease-out 0.2s,
      transform 0.2s ease-out 0.2s;
  }

  /* ======================================= */
  /* Hover Effect: Background + Icon Fade In */
  /* ======================================= */
  /* Base state: color transition with 0.2s delay (waits for icon, changes with background) */
  .btn--hover-bg-icon-fade {
    transition: color 0.35s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
  }

  /* Hover state: immediate color transition */
  .btn--hover-bg-icon-fade:hover {
    transition: color 0.15s ease-in-out;
  }

  /* Base state: background has 0.2s delay (waits for icon to exit first) */
  .btn--hover-bg-icon-fade::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--btn-hover-bg);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
    z-index: 0;
  }

  /* Hover state: background has no delay (slides in immediately) */
  .btn--hover-bg-icon-fade:hover::before {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn--hover-bg-icon-fade .btn__label,
  .btn--hover-bg-icon-fade .btn__icon {
    position: relative;
    z-index: 1;
  }

  /* Base state: icon has 0.1s delay (exits immediately) */
  .btn--hover-bg-icon-fade .btn__icon {
    opacity: 0;
    transition: opacity 0.2s ease-out 0.1s;
  }

  /* Hover state: icon has 0.2s delay (waits for background to enter first) */
  .btn--hover-bg-icon-fade:hover .btn__icon {
    opacity: 1;
    transition: opacity 0.2s ease-out 0.2s;
  }

  /* ============================= */
  /* Reduced Motion Support         */
  /* ============================= */
  /* Reduced-motion guard intentionally omitted (merchant request): button
     hover effects — scale, icon slides, fades, background slides — animate for
     all visitors, including those with the OS "reduce motion" setting enabled. */
{%- endstyle -%}

{%- if url != blank and disabled == false -%}
  <a href="{{ url }}" class="{{ button_classes }}" {{ shopify_attributes }}>
    {{ button_content }}
  </a>
{%- else -%}
  <button
    type="{{ type }}"
    {% if type == 'submit' and form %}
      form="{{ form }}"
    {% endif %}
    {% if name %}
      name="{{ name }}"
    {% endif %}
    class="{{ button_classes }}"
    {% if is_icon_only %}
      aria-label="{{ label | default: 'Button' }}"
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
    {% if attributes %}
      {{- attributes -}}
    {% endif %}
    {{ shopify_attributes }}
  >
    {{ button_content }}
  </button>
{%- endif -%}

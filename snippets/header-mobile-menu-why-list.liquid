<style>
  .why-list {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.625rem;
    border-top: var(--sheet-menu-border-thickness) solid var(--color-border);
    padding: 1rem;
  }

  .why-item {
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>

<ul class="why-list">
  {% comment %}
    <li class="why-item">
      <img src="{{ 'mushroom.svg' | asset_url }}" alt="9 Functional Mushrooms" />
      <p>9 Functional Mushrooms</p>
    </li>
  {% endcomment %}
  {%- if block.settings.rows >= 1 -%}
    <li class="why-item">
      {% render 'icon',
        id: block.id,
        icon_size: 24,
        icon_mode: block.settings.icon_mode,
        icon_select: block.settings.icon_select_1,
        icon_custom: block.settings.icon_svg_1
      %}
      <p>{{ block.settings.text_1 }}</p>
    </li>
  {%- endif -%}

  {%- if block.settings.rows >= 2 -%}
    <li class="why-item">
      {% render 'icon',
        id: block.id,
        icon_size: 24,
        icon_mode: block.settings.icon_mode,
        icon_select: block.settings.icon_select_2,
        icon_custom: block.settings.icon_svg_2
      %}
      <p>{{ block.settings.text_2 }}</p>
    </li>
  {%- endif -%}

  {%- if block.settings.rows >= 3 -%}
    <li class="why-item">
      {% render 'icon',
        id: block.id,
        icon_size: 24,
        icon_mode: block.settings.icon_mode,
        icon_select: block.settings.icon_select_3,
        icon_custom: block.settings.icon_svg_3
      %}
      <p>{{ block.settings.text_3 }}</p>
    </li>
  {%- endif -%}

  {%- if block.settings.rows >= 4 -%}
    <li class="why-item">
      {% render 'icon',
        id: block.id,
        icon_size: 24,
        icon_mode: block.settings.icon_mode,
        icon_select: block.settings.icon_select_4,
        icon_custom: block.settings.icon_svg_4
      %}
      <p>{{ block.settings.text_4 }}</p>
    </li>
  {%- endif -%}
</ul>

{% doc %}
  Renders one card in the cart drawer's mobile recommendation carousel: a 112px
  square image beside a column holding the title, the price and an add button.

  @param {product} product - The recommended product

  @example
  {% render 'cart-product-recommendations-item', product: product %}
{% enddoc %}

{%- liquid
  assign product_form_id = 'product-form-' | append: product.id | append: section.id
  assign current_variant = product.selected_or_first_available_variant
-%}

{% form 'product', product, id: product_form_id, class: 'cart-product-recommendations-item' %}
  <input type="hidden" name="id" value="{{ current_variant.id }}">
  <input type="hidden" name="quantity" value="1">

  <a
    href="{{ product.url }}"
    class="cart-product-recommendations-item__media"
    tabindex="-1"
    aria-hidden="true"
  >
    {{
      product.featured_image
      | image_url: width: 224, height: 224, crop: 'center'
      | image_tag: alt: product.featured_image.alt, loading: 'lazy', class: 'cart-product-recommendations-item__image'
    }}
  </a>

  <div class="cart-product-recommendations-item__body">
    <div class="cart-product-recommendations-item__details">
      <h3 class="cart-product-recommendations-item__title">
        <a href="{{ product.url }}">{{- product.title -}}</a>
      </h3>

      <div class="cart-product-recommendations-item__price">
        <span>{{ current_variant.price | money }}</span>

        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="cart-product-recommendations-item__compare-at-price">
            {{- current_variant.compare_at_price | money -}}
          </s>
        {%- endif -%}
      </div>
    </div>

    <div class="cart-product-recommendations-item__cta">
      {%- if product.has_only_default_variant -%}
        {% render 'add-to-cart', add_to_cart_text: 'Add', product: product, form_id: product_form_id %}
      {%- else -%}
        {% render 'button', label: 'View', url: product.url %}
      {%- endif -%}
    </div>
  </div>
{% endform %}

{%- stylesheet -%}
  .cart-product-recommendations-item {
    display: flex;
    align-items: stretch;
    gap: 1rem; /* 16px */
    width: 238px;
  }

  .cart-product-recommendations-item__media {
    display: block;
    position: relative;
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    border-radius: var(--image-border-radius, 0);
    overflow: hidden;
    background: var(--color-muted-background, #f5f5f5);
  }

  .cart-product-recommendations-item__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-product-recommendations-item__body {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cart-product-recommendations-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* 8px */
    min-width: 0;
  }

  .cart-product-recommendations-item__title {
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-popover-foreground, #111111);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-product-recommendations-item__price {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: var(--font-body--family);
    font-size: 1rem; /* 16px */
    line-height: 1.4;
    font-weight: 600;
    color: var(--color-popover-foreground, #111111);
  }

  .cart-product-recommendations-item__compare-at-price {
    font-size: 0.75rem; /* 12px */
    font-weight: 400;
    color: var(--color-muted-foreground, #737373);
  }

  .cart-product-recommendations-item__cta {
    align-self: flex-start;
  }

  .cart-product-recommendations-item__cta add-to-cart button,
  .cart-product-recommendations-item__cta .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 32px;
    padding: 0.25rem 1rem; /* 4px 16px */
    border-radius: var(--button-border-radius, 0.25rem);
    background: var(--color-add-to-cart-background, #c95136);
    color: var(--color-add-to-cart-foreground, #f6f6f6);
    font-family: var(--font-body--family);
    font-size: 0.75rem; /* 12px */
    line-height: 1.4;
    font-weight: 400;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cart-product-recommendations-item__cta add-to-cart button:hover:not(:disabled),
  .cart-product-recommendations-item__cta .btn:hover {
    background: var(--color-add-to-cart-hover-background, #bf4d33);
    color: var(--color-add-to-cart-hover-foreground, #f6f6f6);
  }
{%- endstylesheet -%}

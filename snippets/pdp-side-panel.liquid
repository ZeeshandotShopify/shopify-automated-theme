{% comment %}
  Information Side Panel Block
  - Includes 3 configurable tabs
  - Triggers side drawer with specific active tab
{% endcomment %}

{%- style -%}
  /* --- Trigger Buttons (On Page) --- */
  .side-panel-triggers {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .side-panel-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    line-height: 140%;
    transition: opacity 0.2s;
  }

  .side-panel-trigger-btn:hover {
    opacity: 0.7;
  }

  .side-panel-trigger-text {
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .side-panel-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .side-panel-icon img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  /* Sheet Menu */
  .side-panel-sheet-content {
    font-family: var(--font-heading--family);
    gap: 0;
  }

  .side-panel-sheet-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading--family);
  }

  .side-panel-sheet-title {
    font-size: 1.5rem; /* 24px */
    line-height: 2rem; /* 32px */
    font-weight: 400;
  }

  /* --- Tab Navigation --- */
  .side-panel-tab-nav {
    display: flex;
    border-bottom: 1px solid #e5e5e5;
    background: #f9f9f9;
  }

  .side-panel-tab-btn {
    flex: 1;
    background: none;
    border: none;
    padding: 15px 10px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    color: #666;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }

  .side-panel-tab-btn.active {
    color: #000;
    font-weight: 600;
    border-bottom: 2px solid #000;
    background: #fff;
  }

  /* --- Content Area --- */
  .side-panel-content-wrapper {
    padding: 30px;
    overflow-y: auto;
    flex: 1;
  }

  .side-panel-tab-content {
    display: none; /* JS toggles this */
    animation: fadeIn 0.3s ease;
  }

  @media (width >= 64rem) {
    /* Sheet Menu */
    .side-panel-sheet-content {
      max-width: 30rem;
    }
  }

  /* .side-panel-tab-content img {
    max-width: 100%;
    height: auto;
  }

  .side-panel-tab-content table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    font-size: 0.9rem;
  }

  .side-panel-tab-content th, .side-panel-tab-content td {
    border: 1px solid #e5e5e5;
    padding: 8px;
    text-align: center;
  } */

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
{%- endstyle -%}

<side-panel data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
  <sheet-menu class="side-panel-sheet-menu" id="side-panel-{{ block.id }}">
    {% comment %} --- TRIGGER BUTTONS (On Page) --- {% endcomment %}
    <div class="side-panel-triggers">
      {%- for i in (1..3) -%}
        {%- capture title_key -%}
          tab_{{ i }}_title
        {%- endcapture -%}
        {%- capture icon_key -%}
          tab_{{ i }}_icon
        {%- endcapture -%}

        {%- assign title = block.settings[title_key] -%}
        {%- assign icon = block.settings[icon_key] -%}

        {%- if title != blank -%}
          <button type="button" data-open-tab="tab-{{ i }}" class="side-panel-trigger-btn">
            {%- if icon != blank -%}
              <span class="side-panel-icon">{{ icon }}</span>
            {%- endif -%}
            <span class="side-panel-trigger-text">{{ title }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <sheet-content class="side-panel-sheet-content" id="side-panel-content-{{ block.id }}">
      {% comment %} Side Panel Sheet Header {% endcomment %}
      <sheet-header class="side-panel-sheet-header">
        <sheet-title class="side-panel-sheet-title">
          <h2 class="side-panel-sheet-content-heading">{{ block.settings.heading }}</h2>
        </sheet-title>

        <sheet-close>
          {{ 'close.svg' | inline_asset_content }}
        </sheet-close>
      </sheet-header>

      {% comment %} Side Panel Tabs {% endcomment %}
      <div class="side-panel-tab-nav">
        {% for i in (1..3) %}
          {% capture title_key %}tab_{{ i }}_title{% endcapture %}
          {% assign title = block.settings[title_key] %}

          {% if title != blank %}
            <button type="button" data-target="tab-{{ i }}" class="side-panel-tab-btn">
              {{ title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      {% comment %} Side Panel Tab Content {% endcomment %}
      <div class="side-panel-content-wrapper">
        {% for i in (1..3) %}
          {% capture title_key %}tab_{{ i }}_title{% endcapture %}
          {% capture source_key %}tab_{{ i }}_source{% endcapture %}
          {% capture text_key %}tab_{{ i }}_richtext{% endcapture %}
          {% capture page_key %}tab_{{ i }}_page{% endcapture %}
          {% assign title = block.settings[title_key] %}

          {% if title != blank %}
            <div class="side-panel-tab-content" id="tab-{{ i }}">
              {% if block.settings[source_key] == 'page' and block.settings[page_key] != blank %}
                <div class="rte">{{ pages[block.settings[page_key]].content }}</div>
              {% else %}
                <div class="rte">{{ block.settings[text_key] }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </sheet-content>
  </sheet-menu>
</side-panel>

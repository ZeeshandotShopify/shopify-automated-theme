{%- style -%}
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 2rem;
    padding-inline: 1rem;
    border-bottom: var(--sheet-menu-border-thickness) solid var(--color-border, #e5e5e5);
  }

  .mobile-nav-item,
  .mobile-nav-accordion-item {
    {%- if block.settings.nav_item_style_mode == 'inherit' -%}
      background-color: var(--color-accordion-background);
      color: var(--color-accordion-foreground);
      border: var(--accordion-border-thickness) solid var(--color-border, #e5e5e5);
      border-radius: var(--accordion-border-radius);
    {%- else -%}
      background-color: {{ block.settings.nav_item_background_color }};
      color: {{ block.settings.nav_item_foreground_color }};
      border-top: {{ block.settings.border_top_thickness }}px solid {{ block.settings.border_color }};
      border-bottom: {{ block.settings.border_bottom_thickness }}px solid {{ block.settings.border_color }};
      border-left: {{ block.settings.border_left_thickness }}px solid {{ block.settings.border_color }};
      border-right: {{ block.settings.border_right_thickness }}px solid {{ block.settings.border_color }};
      border-radius: {{ block.settings.border_radius }};
    {%- endif -%}
  }

  .mobile-nav-item {
    padding: {{ block.settings.nav_item_padding_y }}px {{ block.settings.nav_item_padding_x }}px;
  }

  .mobile-nav-item .mobile-nav-item-link {
    display: block;
    width: 100%;
    font-size: {{ block.settings.nav_item_font_size }};
    line-height: {{ block.settings.nav_item_line_height }};
    font-weight: {{ block.settings.nav_item_font_weight }};
  }

  .mobile-nav-accordion-item > accordion-content {
    padding-left: {{ block.settings.nav_item_padding_x }}px;
    padding-right: {{ block.settings.nav_item_padding_x }}px;
  }

  .mobile-nav-accordion-item > accordion-content > .accordion-content-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: {{ block.settings.nav_item_padding_y }}px;
  }

  .mobile-nav-accordion-item accordion-trigger {
    font-size: {{ block.settings.nav_item_font_size }};
    line-height: {{ block.settings.nav_item_line_height }};
    font-weight: {{ block.settings.nav_item_font_weight }};
    padding: {{ block.settings.nav_item_padding_y }}px {{ block.settings.nav_item_padding_x }}px;
  }

  .mobile-nav-item-sublink-link {
    display: block;
    width: 100%;
    font-size: 1rem; /* 16px */
    line-height: 1.5rem; /* 24px */
    font-weight: 400;
    color: inherit;
    text-decoration: none;
    padding-block: 0.25rem
  }

  .mobile-nav-item-sublink {
    background: transparent;
    border: none;
  }

  .mobile-nav-item-sublink accordion-trigger {
    padding-inline: 0;
    padding-block: 0.25rem;
    font-size: 1rem; /* 16px */
    line-height: 1.5rem; /* 24px */
    font-weight: 400;
  }

  .mobile-nav-item-sublink accordion-content {
    padding-inline: 0;
  }

  .mobile-nav-item-sublink .accordion-content-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: {{ block.settings.nav_item_padding_y }}px;
    padding-top: {{ block.settings.nav_item_padding_y }}px;
  }

  .mobile-nav-item-sublink .mobile-nav-item-nested-sublink-link {
    display: block;
    width: 100%;
    font-size: 0.875rem; /* 14px */
    line-height: 1.25rem; /* 20px */
    font-weight: 400;
    padding-block: 0.25rem
  }
{%- endstyle -%}

{%- if block.settings.menu != blank -%}
  <ul class="mobile-nav-list">
    {%- for link in linklists[block.settings.menu].links -%}
      {%- if link.links.size == 0 -%}
        <li class="mobile-nav-item">
          <a class="mobile-nav-item-link" href="{{ link.url }}">{{- link.title -}}</a>
        </li>
      {%- else -%}
        <li>
          <accordion-item icon="caret" class="mobile-nav-accordion-item">
            <accordion-trigger>{{- link.title -}}</accordion-trigger>
            <accordion-content>
              <div class="accordion-content-inner">
                {%- for sublink in link.links -%}
                  {%- if sublink.links.size == 0 -%}
                    <a href="{{ sublink.url }}" class="mobile-nav-item-sublink-link">{{- sublink.title -}}</a>
                  {%- else -%}
                    <accordion-item icon="caret" class="mobile-nav-item-sublink">
                      <accordion-trigger>{{- sublink.title -}}</accordion-trigger>
                      <accordion-content>
                        <div class="accordion-content-inner">
                          {%- for nested_sublink in sublink.links -%}
                            <a href="{{ nested_sublink.url }}" class="mobile-nav-item-nested-sublink-link">
                              {{- nested_sublink.title -}}
                            </a>
                          {%- endfor -%}
                        </div>
                      </accordion-content>
                    </accordion-item>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </accordion-content>
          </accordion-item>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

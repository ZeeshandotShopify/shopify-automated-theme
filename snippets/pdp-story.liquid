{% style %}
  #pdp-story-{{ block.id }} {
    --heading-font-size: {{ block.settings.heading_font_size }};
    --heading-line-height: {{ block.settings.heading_line_height }};
    --heading-font-weight: {{ block.settings.heading_font_weight }};

    --padding-top: {{ block.settings.padding_top }}px;
    --padding-bottom: {{ block.settings.padding_bottom }}px;

    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  /* Typography */
  .pdp-story-heading {
    font-family: var(--font-heading--family);
    font-size: var(--heading-font-size);
    line-height: var(--heading-line-height);
    font-weight: var(--heading-font-weight);
    margin-bottom: 0.75rem;
  }

  /* Expandable Logic */
  .pdp-story-text {
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 140%;
    font-weight: 400;
    opacity: 0.7;

    {%- if block.settings.page != blank -%}
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      overflow: hidden;
      margin-bottom: 1.5rem;
    {%- endif -%}
  }
{% endstyle %}

<div id="pdp-story-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="pdp-story-heading">{{- block.settings.heading -}}</h2>
  {%- endif -%}

  {%- if block.settings.short_story != blank -%}
    <div class="pdp-story-text">
      {{- block.settings.short_story -}}
    </div>

    {%- if block.settings.page != blank -%}
      {% render 'button', label: 'Read More', url: block.settings.page.url, variant: 'outline', size: 'sm' %}
    {%- endif -%}
  {%- endif -%}
</div>
